  <bf:Instance rdf:about="https://alqami.net/manuscript/nahj_al_balagha">
    <bf:title>
      <bf:Title>
        <bf:mainTitle xml:lang="ar">نهج البلاغة</bf:mainTitle>
        <rdfs:label xml:lang="en">Nahj al-Balagha (Peak of Eloquence)</rdfs:label>
      </bf:Title>
    </bf:title>
    <bf:provisionActivity>
      <bf:ProvisionActivity>
        <bf:date>1022 هـ / 1613 م</bf:date>
        <bf:place>
          <bf:Place>
            <rdfs:label xml:lang="ar">مكتبة العتبة الرضوية المقدسة في مشهد - إيران</rdfs:label>
            <rdfs:label xml:lang="en">Central Library of Astan Quds Razavi, Mashhad</rdfs:label>
          </bf:Place>
        </bf:place>
      </bf:ProvisionActivity>
    </bf:provisionActivity>
    <bf:extent>
      <bf:Extent>
        <rdfs:label xml:lang="ar">477 ورقة</rdfs:label>
      </bf:Extent>
    </bf:extent>
    <bf:material>
      <rdfs:label xml:lang="ar">ورق مجدول، مذهب، خط النسخ، عناوين بالمداد الأحمر</rdfs:label>
      <rdfs:label xml:lang="en">Illuminated ruled paper, gold leaf, Naskh script, red ink headings</rdfs:label>
    </bf:material>
    <bf:contribution>
      <bf:Contribution>
        <bf:agent>
          <bf:Agent>
            <rdfs:label xml:lang="ar">الشريف الرضي، محمد بن حسين (ت 406 هـ)</rdfs:label>
            <rdfs:label xml:lang="en">Al-Sharif al-Radi (d. 406 AH)</rdfs:label>
          </bf:Agent>
        </bf:agent>
        <bf:role>
          <bf:Role>
            <rdfs:label xml:lang="ar">جامع ومؤلف</rdfs:label>
          </bf:Role>
        </bf:role>
      </bf:Contribution>
    </bf:contribution>
    <bf:contribution>
      <bf:Contribution>
        <bf:agent>
          <bf:Agent>
            <rdfs:label xml:lang="ar">الناسخ: شمس الدين علي الشيرازي الهراس (1022 هـ)</rdfs:label>
            <rdfs:label xml:lang="en">Scribe: Shams al-Din Ali al-Shirazi al-Harras (1022 AH)</rdfs:label>
          </bf:Agent>
        </bf:agent>
        <bf:role>
          <bf:Role>
            <rdfs:label xml:lang="ar">ناسخ ومذهب</rdfs:label>
