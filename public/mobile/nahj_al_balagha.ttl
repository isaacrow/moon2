# ==============================================================================
# MANUSCRIPT RESOURCE: NAHJ AL-BALAGHA (نهج البلاغة)
# ==============================================================================

<https://alqami.net/manuscript/nahj_al_balagha> a schema:Manuscript, crm:E22_Human-Made_Object, edm:ProvidedCHO ;
    # Standard Dublin Core Metadata
    dc:title "نهج البلاغة"@ar, "Nahj al-Balagha (Peak of Eloquence)"@en ;
    dc:creator <https://alqami.net/entity/al_sharif_al_radi> ;
    dc:contributor "الناسخ: شمس الدين علي الشيرازي الهراس (1022 هـ)"@ar, "Scribe: Shams al-Din Ali al-Shirazi al-Harras (1022 AH)"@en ;
    dc:subject "حديث، خطب ومواعظ، بلاغة وأدب إسلامي"@ar, "Hadith, Sermons, Islamic Eloquence & Rhetoric"@en ;
    dc:date "1022 هـ / 1613 م" ;
    dc:identifier "نسخة رقم 1861" ;
    dc:language "ara" ;
    dc:type "Illuminated Classical Arabic Manuscript Codex"@en ;
    dc:format "Manuscript codex (477 folios)"@en ;
    
    # Schema.org Extended Attributes
    schema:name "مخطوط نهج البلاغة المذهب"@ar, "Illuminated Nahj al-Balagha Manuscript"@en ;
    schema:extent "477 ورقة"@ar, "477 folios"@en ;
    schema:material "ورق مجدول، مذهب، خط النسخ، عناوين بالمداد الأحمر"@ar, "Illuminated ruled rag paper, shell gold, fine Naskh script, rubricated red ink"@en ;
    schema:publisher <https://alqami.net/entity/astan_quds_library> ;
    schema:inLanguage "Arabic (Classic Literary Arabic)"@en ;
    
    # Codicology & Structural Analysis
    ms:hasScript ms:NaskhClassic ;
    ms:hasIllumination ms:GoldUnwanIllumination ;
    ms:hasHotspot ms:HotspotNahjCover, ms:HotspotNahjUnwan, ms:HotspotNahjColophon ;
    
    # Extended Transcriptions
    ms:transcriptionArabic """أول النسخة: بسمله اما بعد حمد الله الذي جعل الحمد ثمناً لنعمائه ومعاذاً من بلائه و وسيلاً الى جنانه وسبباً لزيادة احسانه والصلوة على رسوله..
آخر النسخة: الينا بعد الشذوذ و ما توفيقنا.. شمس الدين علي الشيرازي الهراس غفرله.
الوصف: مجدولة، مذهبة، أولها لوحة فنية، كتبت رؤوس المطالب والعناوين بالمداد الأحمر، عليها آثار رطوبة تاريخية وقيمتها التراثية نادرة."""@ar ;
    ms:translationEnglish """Nahj al-Balagha (Peak of Eloquence), compiled by al-Sharif al-Radi (d. 406 AH). Scribe: Shams al-Din Ali al-Shirazi al-Harras, copied in 1022 AH. Preserved at the Central Library of Astan Quds Razavi in Mashhad (Copy No. 1861). 477 folios in Naskh script, illuminated with gold rulings, chapter titles in red ink."""@en .

# ==============================================================================
# CREATOR & INSTITUTION ENTITIES
# ==============================================================================

<https://alqami.net/entity/al_sharif_al_radi> a schema:Person, crm:E21_Person ;
    rdfs:label "Al-Sharif al-Radi (الشريف الرضي)"@en ;
    schema:name "الشريف الرضي، محمد بن حسين بن موسى (359 - 406 هـ)"@ar ;
    schema:jobTitle "Islamic Scholar, Poet & Compiler of Nahj al-Balagha"@en ;
    schema:description "فقيه وأديب وشاعر بارز من أعلام القرن الرابع الهجري، جمع خطب ورسائل وحكم أمير المؤمنين علي بن أبي طالب في نهج البلاغة."@ar .

<https://alqami.net/entity/astan_quds_library> a schema:Organization, crm:E39_Actor ;
    rdfs:label "Central Library of Astan Quds Razavi (مكتبة العتبة الرضوية المقدسة)"@en ;
    schema:name "مكتبة العتبة الرضوية المقدسة في مشهد - إيران"@ar ;
    schema:location "Mashhad, Iran"@en ;
    schema:description "من أقدم وأعرق خزائن المخطوطات والوثائق التاريخية في العالم الإسلامي."@ar .

