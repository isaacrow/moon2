    ms:normalizedY 0.40 ;
    ms:elevationZ 0.04 ;
    dc:description "مفتتح بيان الشريف الرضي في علة تدوين واختيار خطب أمير المؤمنين عليه السلام."@ar .

ms:HotspotNahjColophon a ms:SpatialHotspot ;
    rdfs:label "قيد الفراغ والتمليك (Colophon)"@ar ;
    ms:targetFolio "Folio 477b"@en ;
