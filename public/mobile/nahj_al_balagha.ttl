# CODICOLOGY FEATURES
# ==============================================================================

ms:NaskhClassic a ms:CalligraphicScript ;
    rdfs:label "Classic Naskh Calligraphy (خط النسخ الكلاسيكي)"@ar ;
    dc:description "خط نسخ عربي كلاسيكي متقن للناسخ شمس الدين علي الشيرازي، يتميز بالدقة والوضوح."@ar .

ms:GoldUnwanIllumination a ms:IlluminationFeature ;
    rdfs:label "Illuminated Gold Frontispiece (لوحة مذهبة مفتتحة)"@ar ;
    dc:description "لوحة فنية مذهبة فاخرة تفتتح المخطوط بجداول دقيقة وألوان نباتية متقنة."@ar .

