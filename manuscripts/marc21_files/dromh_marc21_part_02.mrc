cالقزويني، خليل بن غازي(ت1089هـ).33aشرح الكافى00c[تاريخ الانتاج غير محدد]00a152 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : فتح كنجينه شاهى شرح احاديث رازداران الهى كشاد نعيم نامتناهى حمد بى شريكيت تعالى شأنه كه بدلالت..00aاخره : اين از الحاقات كاتبان .. و بعد از كتاب توحيد است .. خمس و ستين و الف هجريه.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بعض الحواشي، عليها ختم بيضوي رسمه:(سعيد الانصاري 1259)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الائمة سلام الله عليه 1276)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم بيضوي رسمه:(أبو القاسم الحسيني)، و ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه)، عليها مقابلة مع النسخة الاصل.10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1724،cايرانgir00aاللغة : فارسي.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بعض الحواشي، عليها ختم بيضوي رسمه:(سعيد الانصاري 1259)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الائمة سلام الله عليه 1276)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم بيضوي رسمه:(أبو القاسم الحسيني)، و ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه)، عليها مقابلة مع النسخة الاصل.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بعض الحواشي، عليها ختم بيضوي رسمه:(سعيد الانصاري 1259)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الائمة سلام الله عليه 1276)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم بيضوي رسمه:(أبو القاسم الحسيني)، و ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه)، عليها مقابلة مع النسخة الاصل. 4aشرح حديثvمخطوطات.40uhttps://dromh.org/?view=2e3bcd8e00aمكتبة العتبة الرضوية المقدسة في مشهد-ايران06497ctm a2200361 i b243926261016s1876    xx            000 0 ara d00a(DROMH) dromh-243926-eb9188fa00aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M36 187600c(300aMS16141 aالمجلسي، محمد باقر بن محمد تقي،dتوفي 1110 هجري،eمؤلف.10aبحار الانوار الجامعة لدرر الاخبار الائمة الاطهار10aبحار الانوار الجامعة لدرر الاخبار الائمة الاطهار /cالمجلسي، محمد باقر بن محمد تقي(ت1110هـ).00aالمشهد الرضوي :cيوم الاثنين من شهـر ذي القعدة الحرام سنة 1293هـ = [1876]00a320 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد الله الذي أوضح لنا مناهج الهدى بمفاتيح الكلم ومصابيح الظلم سيد الورى محمد الذي بشر به الانبياء جميع الأمم وأهل بيته الأطهرين..00aاخره : في يوم الاثنين غرة شهر ذي القعدة الحرام من شهور سنة ثلث وتسعين ومائتين بعد الالف من الهجرة النبوية في ارض الاقدس الرضوية وانا تراب اقدام الواعظين محمد بن حسن اليزدي الاصل المشهدي المسكن والمدفن 1293هـ.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها ختم بيضوي رسمه:(ابو القاسم الحسيني)، و ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم مربع رسمه:(عبده الراجي الرضوي)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدولة أبو الفتح متولي باشى استانه مقدسة)، و ختم بيضوي رسمه:(سعيد الانصاري 1259)، عليها وقفية احمد بن حسن اليزدي المشهدي على الامام الرضا عليه السلام مع 20 مجلد اخر في 17 ربيع الاخر سنة 1295هـ وختمه المربع رسمه:(الواقف الواعظ احمد اليزدي)، عليها ختم مربع رسمه:(نيشان كتابخانه مباركه رضويه 1290هـ).10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1614،cايرانgir00aاللغة : عربي.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها ختم بيضوي رسمه:(ابو القاسم الحسيني)، و ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم مربع رسمه:(عبده الراجي الرضوي)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدولة أبو الفتح متولي باشى استانه مقدسة)، و ختم بيضوي رسمه:(سعيد الانصاري 1259)، عليها وقفية احمد بن حسن اليزدي المشهدي على الامام الرضا عليه السلام مع 20 مجلد اخر في 17 ربيع الاخر سنة 1295هـ وختمه المربع رسمه:(الواقف الواعظ احمد اليزدي)، عليها ختم مربع رسمه:(نيشان كتابخانه مباركه رضويه 1290هـ).00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها ختم بيضوي رسمه:(ابو القاسم الحسيني)، و ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم مربع رسمه:(عبده الراجي الرضوي)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدولة أبو الفتح متولي باشى استانه مقدسة)، و ختم بيضوي رسمه:(سعيد الانصاري 1259)، عليها وقفية احمد بن حسن اليزدي المشهدي على الامام الرضا عليه السلام مع 20 مجلد اخر في 17 ربيع الاخر سنة 1295هـ وختمه المربع رسمه:(الواقف الواعظ احمد اليزدي)، عليها ختم مربع رسمه:(نيشان كتابخانه مباركه رضويه 1290هـ).00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها ختم بيضوي رسمه:(ابو القاسم الحسيني)، و ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم مربع رسمه:(عبده الراجي الرضوي)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدولة أبو الفتح متولي باشى استانه مقدسة)، و ختم بيضوي رسمه:(سعيد الانصاري 1259)، عليها وقفية احمد بن حسن اليزدي المشهدي على الامام الرضا عليه السلام مع 20 مجلد اخر في 17 ربيع الاخر سنة 1295هـ وختمه المربع رسمه:(الواقف الواعظ احمد اليزدي)، عليها ختم مربع رسمه:(نيشان كتابخانه مباركه رضويه 1290هـ). 4aحديثvمخطوطات.10aاحمد بن الحسن اليزدي المشهدي،eناسخ.40uhttps://dromh.org/?view=eb9188fa00aمكتبة العتبة الرضوية المقدسة في مشهد-ايران02305ctm a2200337 i b243925261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-243925-6e9adffa00aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS1586/21 aالحسن بن علي(ع)(ت260هـ)،eمؤلف.10aتوقيع العسكري10aتوقيع العسكري = رسالة العسكري الى علي بن بابويه القمي /cالحسن بن علي(ع)(ت260هـ).33aرسالة العسكري الى علي بن بابويه القمي00c[تاريخ الانتاج غير محدد]00a2 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : صورة كتاب الامام الهمام ابي محمد الحسن بن علي العسكري عليهما السلام الى الشيخ العالم العامل ابي الحسن علي ابن الحسين بن بابويه القمي..00aاخره : ونواهينا فاولئك شيعتنا واما من يخالفنا في كثر مما فرض الله عليه فليسوا شيعتنا انما هم موالينا ومحبونا.00aعليها ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه).10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1586/2،cايرانgir00aاللغة : عربي.00aعليها ختم بيضوي رسمه:(انا عبد من عبيد محمد)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه). 4aحديثvمخطوطات.40uhttps://dromh.org/?view=6e9adffa00aمكتبة العتبة الرضوية المقدسة في مشهد-ايران03050ctm a2200361 i b243924261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-243924-73f9c30d00aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS1586/11 aالشيخ البهائي، محمد بن حسين،dتوفي 1030 هجري،eمؤلف.10aالاربعون حديثاً10aالاربعون حديثاً = اربيعن شيخ بهائي = شرح الأربعين /cالشيخ البهائي، محمد بن حسين(ت1030هـ).33aاربيعن شيخ بهائي33aشرح الأربعين00c[تاريخ الانتاج غير محدد]00a247 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحديث الاول في ثواب من حفظ اربيعن حديثا المراد بحفظ الحديث في قوله صلى الله عليه واله وسلم من حفظ على امتي الى اخره الحديث..00aاخره : ببهاء الدين العاملي وفقه اللّه تعالى للعمل في يومه لغده قبل أن يخرج الأمر من يده بمحروسة اصفهان حرست عن بوايق الزمان وطوارق الحدثان والحمد اللّه أولا وآخرا وظاهراً وباطناً.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها بعض الحواشي، عليها كلمات نسخ البدل، مصححة، عليها ختم بيضوي رسمه:(ابو القاسم الحسيني)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، عليها كلمة وقف.10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1586/1،cايرانgir00aاللغة : عربي.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها بعض الحواشي، عليها كلمات نسخ البدل، مصححة، عليها ختم بيضوي رسمه:(ابو القاسم الحسيني)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، عليها كلمة وقف.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها بعض الحواشي، عليها كلمات نسخ البدل، مصححة، عليها ختم بيضوي رسمه:(ابو القاسم الحسيني)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، عليها كلمة وقف. 4aحديثvمخطوطات.40uhttps://dromh.org/?view=73f9c30d00aمكتبة العتبة الرضوية المقدسة في مشهد-ايران02180ctm a2200349 i b243923261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-243923-2efa8d7700aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS15761 aالطبرسي، احمد بن علي،dتوفي 620 هجري،eمؤلف.10aالاحتجاج على اهل اللجاج10aالاحتجاج على اهل اللجاج = احتجاج طبرسي /cالطبرسي، احمد بن علي(ت620هـ).33aاحتجاج طبرسي00c[تاريخ الانتاج غير محدد]00a172 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد الله المتعالي عن صفات المخلوقين المنزه عن نعوت الناعتين  المبرأ مما لا يليق بوحدانيته المرتفع عن الزوال والفناء بوجوب إلهيته الذي..00aاخره : وأماتهم الله دهرا طويلا حتى بليت عظامهم وتقطعت اوصالهم وصاروا ترابا فبعث الله في وقت أحب أن يري خلقه قدرته نبيا يقال...00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها بعض الحواشي، عليها كلمات نسخ البدل، مصححة.10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1576،cايرانgir00aاللغة : عربي.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها بعض الحواشي، عليها كلمات نسخ البدل، مصححة. 4aكلام وعقائدvمخطوطات. 4aحديثvمخطوطات.40uhttps://dromh.org/?view=2efa8d7700aمكتبة العتبة الرضوية المقدسة في مشهد-ايران04071ctm a2200361 i b243922261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-243922-0e902b9500aIQ-KaCCSbaracIQ-KaCCSerda04aBP130.4b.M3600c(300aMS13821 aالفاضل المقداد، مقداد بن عبد الله،dتوفي 826 هجري،eمؤلف.10aكنز العرفان في فقه القرآن10aكنز العرفان في فقه القرآن = آيات الاحكام /cالفاضل المقداد، مقداد بن عبد الله(ت826هـ).33aآيات الاحكام00c[تاريخ الانتاج غير محدد]00a356 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد الله الذي انزل على عبده الكتاب لكل شيء تبيانا وجعله لتصديق نبوته وتايد رسالته..00aاخره : وارحمنا انت مولانا فانصرنا على القوم الكافرين سبحان ربك رب العزة عما يصفون وسلام على المرسلين والحمد الله رب العالمين والصلاة والسلام على محمد واله اجمعين امين.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها ختم دائري رسمه:(المتوكل على الله الغني جبرائيل الحسيني 1033)، و ختم مربع رسمه:(عبده الرضوي)، و ختم بيضوي رسمه:(عبده موسى الحسيني)، و ختم مربع رسمه:(أبو القاسم الحسيني)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الايمة سلام الله عليهم)، و ختم بيضوي رسمه:انا عبد من عبيد محمد).10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1382،cايرانgir00aاللغة : عربي.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها ختم دائري رسمه:(المتوكل على الله الغني جبرائيل الحسيني 1033)، و ختم مربع رسمه:(عبده الرضوي)، و ختم بيضوي رسمه:(عبده موسى الحسيني)، و ختم مربع رسمه:(أبو القاسم الحسيني)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الايمة سلام الله عليهم)، و ختم بيضوي رسمه:انا عبد من عبيد محمد).00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها ختم دائري رسمه:(المتوكل على الله الغني جبرائيل الحسيني 1033)، و ختم مربع رسمه:(عبده الرضوي)، و ختم بيضوي رسمه:(عبده موسى الحسيني)، و ختم مربع رسمه:(أبو القاسم الحسيني)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الايمة سلام الله عليهم)، و ختم بيضوي رسمه:انا عبد من عبيد محمد). 4aفقهvمخطوطات. 4aتفسي