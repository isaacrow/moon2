0aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : باب المختار من كتب امير المؤمنين عليه السلام و رسائله الى اعدآئه وامراء بلاده اين بابيست..00aاخره : والحمد الله وستايش فراوان مر خداوند عالميان راست.. وسلام وتحيت فرستاد..00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بعض الحواشي، عليها ختم بيضوي رسمه:(سعيد الانصاري 1259)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الائمة سلام الله عليه 1276)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم بيضوي رسمه:(أبو القاسم الحسيني)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه)، و ختم بيضوي رسمه:(عبده الراجي فضل الله)، و ختم مستطيل رسمه:(عبده محمد حسين بن فضل الله الحسيني 1246)، و ختم مربع رسمه:(عبده الراجي الرضوي)، وختم مثمني رسمه:(ياسلطان علي بن موسى الرضا)، و ختم بيضوي رسمه:(العبد محمد رحيم)، عليها آثار رطوبة.10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1949،cايرانgir00aاللغة : فارسي.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بعض الحواشي، عليها ختم بيضوي رسمه:(سعيد الانصاري 1259)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الائمة سلام الله عليه 1276)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم بيضوي رسمه:(أبو القاسم الحسيني)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه)، و ختم بيضوي رسمه:(عبده الراجي فضل الله)، و ختم مستطيل رسمه:(عبده محمد حسين بن فضل الله الحسيني 1246)، و ختم مربع رسمه:(عبده الراجي الرضوي)، وختم مثمني رسمه:(ياسلطان علي بن موسى الرضا)، و ختم بيضوي رسمه:(العبد محمد رحيم)، عليها آثار رطوبة.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بعض الحواشي، عليها ختم بيضوي رسمه:(سعيد الانصاري 1259)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الائمة سلام الله عليه 1276)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم بيضوي رسمه:(أبو القاسم الحسيني)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه)، و ختم بيضوي رسمه:(عبده الراجي فضل الله)، و ختم مستطيل رسمه:(عبده محمد حسين بن فضل الله الحسيني 1246)، و ختم مربع رسمه:(عبده الراجي الرضوي)، وختم مثمني رسمه:(ياسلطان علي بن موسى الرضا)، و ختم بيضوي رسمه:(العبد محمد رحيم)، عليها آثار رطوبة.00aكتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بعض الحواشي، عليها ختم بيضوي رسمه:(سعيد الانصاري 1259)، و ختم مستطيل رسمه:(وقف سركار فيض امام حضرت ثامن الائمة سلام الله عليه 1276)، و ختم مربع رسمه:(سلطان محمد صاحب العتبة العلية)، و ختم بيضوي رسمه:(أبو القاسم الحسيني)، و ختم مربع رسمه:(مؤتمن الملك مع شعار الدولة)، و ختم مربع رسمه:(مؤيد الدوله ابو الفتح متولى باشى آستانه مقدسه)، و ختم بيضوي رسمه:(عبده الراجي فضل الله)، و ختم مستطيل رسمه:(عبده محمد حسين بن فضل الله الحسيني 1246)، و ختم مربع رسمه:(عبده الراجي الرضوي)، وختم مثمني رسمه:(ياسلطان علي بن موسى الرضا)، و ختم بيضوي رسمه:(العبد محمد رحيم)، عليها آثار رطوبة. 4aشرح حديثvمخطوطات.10aشيخ محمد مهدي بن شيخ أبو تراب شهندي كحجي،eناسخ.40uhttps://dromh.org/?view=b455425200aمكتبة العتبة الرضوية المقدسة في مشهد-ايران03488ctm a2200385 i b243452261016nuuuu    xx            000 0 per d00a(DROMH) dromh-243452-062df96200aIQ-KaCCSbaracIQ-KaCCSerda00aper04aBP135b.M3600c(300aMS19431 aخاتون آبادي، محمد بن علي،dتوفي 1057 هجري،eمؤلف.10aقطب شاهى(ترجمة)10aقطب شاهى(ترجمة) = شرح أربعين = ترجمة أربعين شيخ بهائى /cخاتون آبادي، محمد بن علي(ت1057هـ).33aشرح أربعين33aترجمة أربعين شيخ بهائى00c[تاريخ الانتاج غير محدد]00a642 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نستعليق.00aاوله : بسمله احاديث اين كتاب و آنچه در ضمن شرح هر حديث سمت گزارش يافته است..00aاخره : سزاوار آن است كه تصديق نمايى آن جماعت را نيز در آنچه خبر..00aمجدولة، مذهبة، كتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بلغ مقابلة، عليها ختم مربع رسمه:(ياامام زين العابدين)، و ختم بيضوي رسمه:(محمد امين بن محمد)، عليها تملك باسم:(زين العابدين الجنوشاني)، عليها آثار رطوبة.10aمكتبة العتبة الرضوية المقدسة في مشهد-ايران : 1943،cايرانgir00aاللغة : فارسي.00aمجدولة، مذهبة، كتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بلغ مقابلة، عليها ختم مربع رسمه:(ياامام زين العابدين)، و ختم بيضوي رسمه:(محمد امين بن محمد)، عليها تملك باسم:(زين العابدين الجنوشاني)، عليها آثار رطوبة.00aمجدولة، مذهبة، كتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بلغ مقابلة، عليها ختم مربع رسمه:(ياامام زين العابدين)، و ختم بيضوي رسمه:(محمد امين بن محمد)، عليها تملك باسم:(زين العابدين الجنوشاني)، عليها آثار رطوبة.00aمجدولة، مذهبة، كتبت روؤس المطالب و العناوين بالمداد الأحمر، عليها كلمات نسخ البدل، مصححة، عليها بلغ مقابلة، عليها ختم مربع رسمه:(ياامام زين العابدين)، و ختم بيضوي رسمه:(محمد امين بن محمد)، عليها تملك باسم:(زين العابدين الجنوشاني)، عليها آثار رطوبة. 4aشرح حديثvمخطوطات.40uhttps://dromh.org/?view=062df96200aمكتبة العتبة الرضوية المقدسة في مشهد-ايران02401ctm a2200385 i b243451261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-243451-d9a6eb1f00aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS19411 aالكاشف اليزدي، محمد نصير بن قاضي،dق11 هجري،eمؤلف.10aتحفه شاهيه عباسيه در شرح رساله رضويه ذهبيه10aتحفه شاهيه عباسيه در شرح رساله رضويه ذهبيه = تحفة الرضا = ترجمه طب الرضا = ترجمه رساله ذهبيه /cالكاشف اليزدي، محمد نصير بن قاضي(ق11هـ).33aتحفة الرضا33aترجمه طب الرضا33aترجمه رساله ذهبيه00c[تاريخ الانتاج غير محدد]00a26 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ و نستعليق.00aاوله : الرسالة الذهبية فى الطب التى بعث بها الامام.. الى المأمون العباسى في حفظ.. صحة المزاج وتدبيره بالاغذية والاشربة و الادوية..00aاخره : لكونه شرف القمر ومن عمل فيما و صفت فى كتابى هذا ودبربه جسده امن باذن الله تعالى من كل داء وصح جسمه بحول..00aعليها كلمات نسخ البدل، مصححة، 