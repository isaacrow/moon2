f883605600aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03577ctm a2200349 i b218967261016s1909    xx            000 0 ara d00a(DROMH) dromh-218967-178fb4b600aIQ-KaCCSbaracIQ-KaCCSerda04aPJ6101b.M36 190900c(300aMS183/11 aآل شبّر الحسينيّ، محمّد بن جعفر،dتوفي 1346 هجري،eمؤلف.10aالفوائد في النحو(6و - 82ظ)10aالفوائد في النحو(6و - 82ظ) /cآل شبّر الحسينيّ، محمّد بن جعفر (ت1346هـ).00cشهر ذي الحجة الحرام سنة 1327هـ = [1909]00a77 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله الذي جعل لغة العرب أحسن اللغات والصلاة والسلام على أشرف المخلوقات محمّد سيّد الكائنات وآله الأئمة الهداة00aاخره : وهو الذي يجعل مكان المد في ألقوا في هذا وهذا آخر ما أردنا في معرفتك إياه والحمد لله على إتمامه وصلى الله على محمّد وآله الطاهرين00aعلى المجموعة  بعض الحواشي، جاء في أوّل النسخة مجموعة من الفوائد النحوية، وفي آخرها وردت أحكام المهر ومواضعه الأربعة وأحكام النكاح والطلاق بالفارسيّة في 6 أوراق، عليها تملّك السيّد عبّاس بن محمّد شبّر الحسينيّ الموسويّ ووقفيّته سنة 1373هـ في مدينة البصرة، عليها أختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 183/1،00aاللغة : عربيّ.00aعلى المجموعة  بعض الحواشي، جاء في أوّل النسخة مجموعة من الفوائد النحوية، وفي آخرها وردت أحكام المهر ومواضعه الأربعة وأحكام النكاح والطلاق بالفارسيّة في 6 أوراق، عليها تملّك السيّد عبّاس بن محمّد شبّر الحسينيّ الموسويّ ووقفيّته سنة 1373هـ في مدينة البصرة، عليها أختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل.00aعلى المجموعة  بعض الحواشي، جاء في أوّل النسخة مجموعة من الفوائد النحوية، وفي آخرها وردت أحكام المهر ومواضعه الأربعة وأحكام النكاح والطلاق بالفارسيّة في 6 أوراق، عليها تملّك السيّد عبّاس بن محمّد شبّر الحسينيّ الموسويّ ووقفيّته سنة 1373هـ في مدينة البصرة، عليها أختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل. 4aنحوvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=178fb4b600aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف04402ctm a2200361 i b218966261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218966-875f17a500aIQ-KaCCSbaracIQ-KaCCSerda04aPJ6101b.M3600c(300aMS1821 aبكر الصدقيّ،eمؤلف.10aالغادة المفردة العربيّة في شرح العروة الوثقى في العربيّة10aالغادة المفردة العربيّة في شرح العروة الوثقى في العربيّة = الفائدة المفردة العربيّة في شرح المائة العجمية /cبكر الصدقيّ.33aالفائدة المفردة العربيّة في شرح المائة العجمية00c[تاريخ الانتاج غير محدد]00a120 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله الذي أظهر صحيح الأفعال بتجليات أسمائه، وأضمر في مظاهر الموجودات حروف نعمه وآلائه، وجعل علامة وجوده..00aاخره : فلا يقال والله علمني وفعلها يحذف وجوباً نصاً في القسم ولا تدخل إلا على الظاهر والكاف هي للتشبيه نحو زيد كالأسد وقد تزاد...00aآخر النسخة (ناقص)،عليها بلاغات المقابلة، وحواشٍ بإمضاء: «منه»، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك سيف الدين، وتملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس شبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 182،00aاللغة : عربيّ.00aآخر النسخة (ناقص)،عليها بلاغات المقابلة، وحواشٍ بإمضاء: «منه»، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك سيف الدين، وتملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس شبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ00aآخر النسخة (ناقص)،عليها بلاغات المقابلة، وحواشٍ بإمضاء: «منه»، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك سيف الدين، وتملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس شبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ00aآخر النسخة (ناقص)،عليها بلاغات المقابلة، وحواشٍ بإمضاء: «منه»، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك سيف الدين، وتملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس شبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ 4aنحوvمخطوطات.40uhttps://dromh.org/?view=875f17a500aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03871ctm a2200349 i b218965261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218965-6da667c100aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS1811 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aغرائب الأخبار و نوادر الآثار10aغرائب الأخبار و نوادر الآثار /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00c[تاريخ الانتاج غير محدد]00a167 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله الذي لا من شيء كان ولا من شيء كوّن ما قد كان الذي حارت لطائف الأوهام في بيداء كبريائه وعظمته ولم يجعل للخلق سبيلاً إلى معرفته..00aاخره : هذه باب دارك انزل إليها فلما نزلت قال لي قد خسرت الدنيا والاخرة ذلك الرجل صاحب الدار (ع) فالتفت إلى الغلام فلم أره وأنا في هذا بينكم نادم على ما فرطت00aعليها بلاغات المقابلة، بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك السيّد محمّد ابن السيّد عبد الله شبّر الحسينيّ ووقفيّته، وتملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1339هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس شبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 181،00aاللغة : عربيّ.00aعليها بلاغات المقابلة، بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك السيّد محمّد ابن السيّد عبد الله شبّر الحسينيّ ووقفيّته، وتملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1339هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس شبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ00aعليها بلاغات المقابلة، بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك السيّد محمّد ابن السيّد عبد الله شبّر الحسينيّ ووقفيّته، وتملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1339هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس شبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ 4aحديثvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=6da667c100aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03991ctm a2200361 i b218964261016s1813    xx            000 0 ara d00a(DROMH) dromh-218964-88d56e6100aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 181300c(300aMS1801 aآل شبّر الحسينيّ، محمّد بن جعفر،dتوفي 1346 هجري،eمؤلف.10aأنوار الساعة10aأنوار الساعة = الأنوار الساطعة في العلوم الأربعة /cآل شبّر الحسينيّ، محمّد بن جعفر (ت1346هـ).33aالأنوار الساطعة في العلوم الأربعة00c20 شهر صفر المظفّر سنة 1228هـ = [1813]00a140 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله الذي لا من شيء كان، ولا من شيء كوّن ما قد كان، المستشهد بحدوث الأشياء على أزليته وبما وسمها به من العجز على قدرته..00aاخره : ويحتسب من الدية بحساب القيمة والمرأة كالرجل في الجميع حتى تبلغ ثلث ديته ثم تصير على النصف..وصلى الله على محمّد وآله00aعليها بعض الحواشي، العناوين رؤوس المطالب كُتِبَت بالمداد الأحمر، وقفها المؤلِّف بتاريخ 3 شهر صفر المظفّر سنة 1236هـ كسائر مؤلفاته الأخرى على اللائقين للانتفاع به من الفرقة الناجية، عليها تملّك السيّد عبّاس ابن السيّد محمّد آل شبّر الحسينيّ سنة 1246هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 180،00aاللغة : عربيّ.00aعليها بعض الحواشي، العناوين رؤوس المطالب كُتِبَت بالمداد الأحمر، وقفها المؤلِّف بتاريخ 3 شهر صفر المظفّر سنة 1236هـ كسائر مؤلفاته الأخرى على اللائقين للانتفاع به من الفرقة الناجية، عليها تملّك السيّد عبّاس ابن السيّد محمّد آل شبّر الحسينيّ سنة 1246هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ00aعليها بعض الحواشي، العناوين رؤوس المطالب كُتِبَت بالمداد الأحمر، وقفها المؤلِّف بتاريخ 3 شهر صفر المظفّر سنة 1236هـ كسائر مؤلفاته الأخرى على اللائقين للانتفاع به من الفرقة الناجية، عليها تملّك السيّد عبّاس ابن السيّد محمّد آل شبّر الحسينيّ سنة 1246هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ 4aمختلفvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=88d56e6100aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02853ctm a2200337 i b218963261016s1924    xx            000 0 ara d00a(DROMH) dromh-218963-1ba37c1b00aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M36 192400c(300aMS1791 aآل شبّر الحسينيّ، محمّد بن جعفر،dتوفي 1346 هجري،eمؤلف.10aإكسير السعادات في أحكام العبادات10aإكسير السعادات في أحكام العبادات /cآل شبّر الحسينيّ، محمّد بن جعفر (ت1346هـ).00cيوم الثلاثاء  17شهر صفر المظفّر سنة 1343هـ = [1924]00a129 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله ربِّ العالمين..وبعد فيقول العبد الأحقر الجاني محمّد بن جعفر الحسينيّ إنّ هذه جملة من المسائل الأصول والفروع..وسميتها إكسير السعادات..00aاخره : وأما المجاهيل فاهتم بأمورهم وإصلاحهم والدعاء لهم من حيث إنهم عباد الله وإخوانك وفقنا الله للعمل بما نعمل..والحمد لله ربِّ العالمين00aعليها عارية محمّد عليّ ابن الحاج فضل لمدة شهر، عليها تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ ووقفيّته سنة 1344هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 179،00aاللغة : عربيّ.00aعليها عارية محمّد عليّ ابن الحاج فضل لمدة شهر، عليها تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ ووقفيّته سنة 1344هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ. 4aفقه ومواعظvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=1ba37c1b00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02881ctm a2200337 i b218962261016s1814    xx            000 0 ara d00a(DROMH) dromh-218962-af9d77e100aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M36 181400c(300aMS1781 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aالمصباح الساطع في شرح مفاتيح الشرائع10aالمصباح الساطع في شرح مفاتيح الشرائع /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00cعصر يوم الجمعة 4 شهر شعبان المعظّم سنة 1229هـ = [1814]00a190 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله ربِّ العالمين والصلاة والسلام على محمّد خاتم النبيين وعترته الطيبين الطاهرين أمّا بعد فهذا هو المجلد الثالث من المصباح الساطع..00aاخره : إن أكل بأصابعه أجمع فقد أتى بالأفضل الأكمل لأنه أقرب إلى حرمة الطعام بالثلاث تحديد في جانب القلة..والصلاة على محمّد وآله الطاهرين00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك السيّد عبّاس ابن السيّد محمّد شبّر الحسينيّ الموسويّ، سنة 1344هـ، في مدينة البصرة، وختمهُ البيضويّ: «عبّاس بن محمّد الشبّر الحسينيّ 1340»، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 178،00aاللغة : عربيّ.00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك السيّد عبّاس ابن السيّد محمّد شبّر الحسينيّ الموسويّ، سنة 1344هـ، في مدينة البصرة، وختمهُ البيضويّ: «عبّاس بن محمّد الشبّر الحسينيّ 1340»، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ. 4aفقهvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=af9d77e100aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03799ctm a2200349 i b218961261016s1363    xx            000 0 ara d00a(DROMH) dromh-218961-bfbdb55300aIQ-KaCCSbaracIQ-KaCCSerda04aBP130.4b.M36 136300c(300aMS1771 aالطبرسيّ، الفضل بن الحسن،dتوفي 548 هجري،eمؤلف.10aمجمع البيان في تفسير القرآن10aمجمع البيان في تفسير القرآن = مجمع البيان لعلوم القرآن /cالطبرسيّ، الفضل بن الحسن (ت548هـ).33aمجمع البيان لعلوم القرآن00aسوريا ،دمشق :c13 شهر رمضان المبارك سنة 764هـ = [1363]00a103 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : سورة طه مكيّة عدد آياتها مائة وأربعون آية شامي وخمس وثلاثون كوفي وأربع حجازي وأثنتان بصري، أخلافها إحدى وعشرون آية..00aاخره : هذا الوعد واتصل قوله: ﴿قُلْ رَبِّي أَعْلَمُ مَنْ جَاءَ بِالْهُدَى﴾ على معنى انه امره بأن يقول لهم ربي اعلم بالصادق والكاذب لا يلتبس عليه شيء00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك بالشراء محمّد زمان الطباطبائيّ في شهر شوال المكرّم سنة 1124هـ وختمهُ البيضويّ رسمهُ: «لا إله إلا الله الملك الحق المبين عبدهُ محمّد زمان 1112»، وتملّك السيّد عبد الله شبّر الحسينيّ ووقفيّته، وختمهُ البيضويّ رسمهُ: «الواثق بالله الغنيّ عبدهُ عبد الله الحسينيّ»، وتملّك السيّد عبّاس ابن السيّد محمّد شبّر الحسينيّ الموسويّ سنة 1346هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «محمّد الحسينيّ»، وختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 177،00aاللغة : عربيّ.00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها تملّك بالشراء محمّد زمان الطباطبائيّ في شهر شوال المكرّم سنة 1124هـ وختمهُ البيضويّ رسمهُ: «لا إله إلا الله الملك الحق المبين عبدهُ محمّد زمان 1112»، وتملّك السيّد عبد الله شبّر الحسينيّ ووقفيّته، وختمهُ البيضويّ رسمهُ: «الواثق بالله الغنيّ عبدهُ عبد الله الحسينيّ»، وتملّك السيّد عبّاس ابن السيّد محمّد شبّر الحسينيّ الموسويّ سنة 1346هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «محمّد الحسينيّ»، وختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ 4aتفسيرvمخطوطات.10aعلي بن أحمد السماوي،eناسخ.40uhttps://dromh.org/?view=bfbdb55300aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02417ctm a2200337 i b218960261016s1940    xx            000 0 ara d00a(DROMH) dromh-218960-c574c97c00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 194000c(300aMS1761 aآل شبّر الحسينيّ، عليّ بن محمّد،dتوفي 1393 هجري،eمؤلف.10aالسوانح الحيدرآبادية10aالسوانح الحيدرآبادية /cآل شبّر الحسينيّ، عليّ بن محمّد (ت1393هـ).00aحيدر آباد :cشهر محرّم الحرام سنة 1359هـ = [1940]00a212 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله ربِّ العالمين والصلاة والسلام على محمّد وآله الطيبين الطاهرين، وبعد فيقول الأحقر عليّ بن محمّد الحسينيّ شبّر وفقهما الله لحسن الدارين..00aاخره : مثل الرزق الذي تطلبه *** مثل الظل الذي يمشي معك
أنـت لا تـدركه متـبـعاً *** واذا وليـت عنـه تـــبــعـــك00aجاء في أوّل النسخة فِهرِس للعناوين بمقدار (33) ورقة، وفي آخرها تقريظ إبراهيم جمال الدين على الكتاب سنة 1360هـ، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 176،00aاللغة : عربيّ.00aجاء في أوّل النسخة فِهرِس للعناوين بمقدار (33) ورقة، وفي آخرها تقريظ إبراهيم جمال الدين على الكتاب سنة 1360هـ، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ. 4aمختلفvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=c574c97c00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03608ctm a2200373 i b218959261016nuuuu    xx            000 0 per d00a(DROMH) dromh-218959-fb0244a400aIQ-KaCCSbaracIQ-KaCCSerda00aper04aR128.3b.M3600c(300aMS175/21 aالأكبرآباديّ، غلام إمام،dتوفي 1214 هجري،eمؤلف.10aمجربات10aمجربات = علاج الغرباء(98ظ - 237و) /cالأكبرآباديّ، غلام إمام (ت1214هـ).33aعلاج الغرباء(98ظ - 237و)00c[تاريخ الانتاج غير محدد]00a140 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نستعليق.00aاوله : بعد حمد حكيم مطلق و نعت رسول بر حق می گويد احقر انام غلام امام كه اين رساله ايست در علاج امراض به ادويه سهل که بکار آید..00aاخره : سیماب خورده جوانه سائيده به آب شيره كشیده چند روز بنوشند دوا نافع سینه و خورده ادرک بخورد و در دهان داشته باشد...00aآخر النسخة (ناقص)،مشحونة بالحواشي، على المجموعة تملّك السيّد عبّاس بن محمّد الشبّر الحسينيّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد شبّر الحسينيّ»، عليها أختمام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 175/2،00aاللغة : فارسيّ.00aآخر النسخة (ناقص)،مشحونة بالحواشي، على المجموعة تملّك السيّد عبّاس بن محمّد الشبّر الحسينيّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد شبّر الحسينيّ»، عليها أختمام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل.00aآخر النسخة (ناقص)،مشحونة بالحواشي، على المجموعة تملّك السيّد عبّاس بن محمّد الشبّر الحسينيّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد شبّر الحسينيّ»، عليها أختمام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل.00aآخر النسخة (ناقص)،مشحونة بالحواشي، على المجموعة تملّك السيّد عبّاس بن محمّد الشبّر الحسينيّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد شبّر الحسينيّ»، عليها أختمام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل. 4aطبvمخطوطات.40uhttps://dromh.org/?view=fb0244a400aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03219ctm a2200373 i b218958261016s1848    xx            000 0 per d00a(DROMH) dromh-218958-b6ee778600aIQ-KaCCSbaracIQ-KaCCSerda00aper04aR128.3b.M36 184800c(300aMS175/11 aالشفائيّ، مظفّر بن محمّد،dتوفي 963 هجري،eمؤلف.10aقرابادين شفائى10aقرابادين شفائى =قرابادين مظفّرى = طب شفائى         (2ظ - 94و) /cالشفائيّ، مظفّر بن محمّد (ت963هـ).33aقرابادين مظفّرى33aطب شفائى         (2ظ - 94و)00aكربلاء المقدسة :cيوم الأربعاء 22 شهر شوال المكرّم سنة 1264هـ = [1848]00a93 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نستعليق.00aاوله : الحمد الله الحكيم العليم والصلاة على من أوتي الحكم والكتاب الكريم وهو يشفي بلطفه السقيم وإنّه لعلى خلق عظيم وآله الهادين إلى صراط المستقيم..00aاخره : از هر يک سى مثقال عسل صاف بقدر احتياج بطريق معهود معجون سازند خوراک يک مثقال بعد از چهل روز00aمشحونة بالحواشي،على المجموعة تملّك السيّد عبّاس بن محمّد الشبّر الحسينيّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد شبّر الحسينيّ»، عليها أختمام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 175/1،00aاللغة : فارسيّ.00aمشحونة بالحواشي،على المجموعة تملّك السيّد عبّاس بن محمّد الشبّر الحسينيّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد شبّر الحسينيّ»، عليها أختمام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل.00aمشحونة بالحواشي،على المجموعة تملّك السيّد عبّاس بن محمّد الشبّر الحسينيّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد شبّر الحسينيّ»، عليها أختمام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل. 4aطبvمخطوطات.40uhttps://dromh.org/?view=b6ee778600aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف04669ctm a2200349 i b218957261016s1819    xx            000 0 ara d00a(DROMH) dromh-218957-6a45533000aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M36 181900c(300aMS1741 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aالمصباح الساطع في شرح مفاتيح الشرائع10aالمصباح الساطع في شرح مفاتيح الشرائع /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00cشهر جمادى الآخرة سنة 1234هـ = [1819]00a337 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله الذي هدانا للتفقه في الدين ووفقنا لمتابعة خاتم النبيين وأهل بيته الطاهرين المعصومين الذي تعالى عن صفات المخلوقين..00aاخره : وإضافة القوم إليها يدل على اختصاصها وكون القوم المذكورين أقرب إليها من غيرها والعالم بالصواب00aعليها بلاغات المقابلة، مصحّحة، عليها بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالحاشية وبالمداد الأحمر، عليها وقفيّة ميرزا محمّد رضا الحسينيّ الإصفهانيّ بتاريخ سنة 1235هـ وختمهُ البيضويّ رسمهُ: «عبدهُ محمّد رضا الحسنيّ الحسينيّ»، عليها تملّك السيّد عبّاس ابن السيّد محمّد شبّر الحسينيّ الموسويّ، سنة 1344هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ 1340»، عليها ختم مستطيل رسمهُ: «محمّد حسين بن محمّد سعيد الطباطبائيّ»، وأختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 174،00aاللغة : عربيّ.00aعليها بلاغات المقابلة، مصحّحة، عليها بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالحاشية وبالمداد الأحمر، عليها وقفيّة ميرزا محمّد رضا الحسينيّ الإصفهانيّ بتاريخ سنة 1235هـ وختمهُ البيضويّ رسمهُ: «عبدهُ محمّد رضا الحسنيّ الحسينيّ»، عليها تملّك السيّد عبّاس ابن السيّد محمّد شبّر الحسينيّ الموسويّ، سنة 1344هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ 1340»، عليها ختم مستطيل رسمهُ: «محمّد حسين بن محمّد سعيد الطباطبائيّ»، وأختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل00aعليها بلاغات المقابلة، مصحّحة، عليها بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالحاشية وبالمداد الأحمر، عليها وقفيّة ميرزا محمّد رضا الحسينيّ الإصفهانيّ بتاريخ سنة 1235هـ وختمهُ البيضويّ رسمهُ: «عبدهُ محمّد رضا الحسنيّ الحسينيّ»، عليها تملّك السيّد عبّاس ابن السيّد محمّد شبّر الحسينيّ الموسويّ، سنة 1344هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ 1340»، عليها ختم مستطيل رسمهُ: «محمّد حسين بن محمّد سعيد الطباطبائيّ»، وأختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل 4aفقهvمخطوطات.10aعبد الغفور،eناسخ.40uhttps://dromh.org/?view=6a45533000aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03117ctm a2200373 i b218956261016s1813    xx            000 0 ara d00a(DROMH) dromh-218956-8196152d00aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M36 181300c(300aMS1731 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aمصابيح الظلام في شرح مفاتيح شرائع الإسلام10aمصابيح الظلام في شرح مفاتيح شرائع الإسلام = شرح مفاتيح الشرائع /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).33aشرح مفاتيح الشرائع00cيوم الأربعاء 22 شهر جمادى الآخرة سنة 1228هـ = [1813]00a245 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : ...بمعنى العزم عن مطالعة ذلك الكتاب المبسوط ومدارسته وأن رغبة الطباع بالكسر وهي السجايا التي جُبِلَ الإنسان عليها كالطبيعة..00aاخره : في أوّل الوقت إذا كنت مع إمام تقتدي به فإذا كنت وحدك فابدأ بالمكتوبة، اللهم اكتبنا من الهادين المهديّين..والحمد لله وحده وصلى الله على محمّد وآله00aأول النسخة (ناقص)،عليها بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 173،00aاللغة : عربيّ.00aأول النسخة (ناقص)،عليها بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ00aأول النسخة (ناقص)،عليها بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ00aأول النسخة (ناقص)،عليها بعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها ختما مكتبة المدرسة الشبّرية الدائريّ والبيضويّ 4aفقهvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=8196152d00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03338ctm a2200361 i b218955261016s1833    xx            000 0 per d00a(DROMH) dromh-218955-2fd335ca00aIQ-KaCCSbaracIQ-KaCCSerda00aper04aQB23b.M36 183300c(300aMS172/31 aالخجنديّ، عبد الجبار،dق7 هجري،eمؤلف.10aمدخل المنظوم في أحكام علم النجوم10aمدخل المنظوم في أحكام علم النجوم = مثنوي مدخل منظوم      (144و - 151و) /cالخجنديّ، عبد الجبار (ق7هـ).33aمثنوي مدخل منظوم      (144و - 151و)00cشهر ربيع الأوّل سنة 1249هـ = [1833]00a8 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نستعليق.00aاوله : مرد دانا سخن ادا نكند *** تا بنام حق ابتدا نكند
مالك لم يزل كريم و قديم *** صانع بى بدل حكيم و عليم..00aاخره : ليک بايد كه اعتقادش از اين *** چون بداند نگردد ارزه دين
كه ندارد شناخت در دو سراى *** هيچ كس علم غيب جز كه خداى00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر،على المجموعة كلمات نسخ البدل، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، جاء في آخرها جدول بمنازل القمر في الأبراج الاثني عشر،جاء في آخر النسخة عدة جداول ورسومات في استخراج طالع الوقت، ومنازل الأبراج، عليها ختم الناسخ البيضويّ رسمهُ: «عبده محمّد رضا 1250»، وختم وقفيّة: «سيّد عبّاس شبّر»، وأختام مكتبة المدرسة الشبّريّة الدائريّ، والبيضويّ، والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 172/3،00aاللغة : فارسيّ.00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر،على المجموعة كلمات نسخ البدل، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، جاء في آخرها جدول بمنازل القمر في الأبراج الاثني عشر،جاء في آخر النسخة عدة جداول ورسومات في استخراج طالع الوقت، ومنازل الأبراج، عليها ختم الناسخ البيضويّ رسمهُ: «عبده محمّد رضا 1250»، وختم وقفيّة: «سيّد عبّاس شبّر»، وأختام مكتبة المدرسة الشبّريّة الدائريّ، والبيضويّ، والمستطيل. 4aهيئةvمخطوطات.10aمحمّد رضا،eناسخ.40uhttps://dromh.org/?view=2fd335ca00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03412ctm a2200361 i b218954261016s1833    xx            000 0 per d00a(DROMH) dromh-218954-fdab66ad00aIQ-KaCCSbaracIQ-KaCCSerda00aper04aQB23b.M36 183300c(300aMS172/21 aنصيرالدين الطوسيّ، محمّد بن محمّد .،dتوفي 672 هجري،eمؤلف.10aسى فصل10aسى فصل = مختصر در معرفت تقويم                 (123ظ - 143و) /cنصيرالدين الطوسيّ، محمّد بن محمّد (ت672هـ)..33aمختصر در معرفت تقويم                 (123ظ - 143و)00cشهر ربيع الأوّل سنة 1249هـ = [1833]00a21 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نستعليق.00aاوله : اما بعد اين مختصرى است در معرفت تقويم مشتمل بر سى فصل، فصل اول در حساب جمل و آن به ترتيب ابجد هوز حطى كلمن سعفص قرشت..00aاخره : منسوب به آن كوكب بود و قمر با ذنب و كيد و ما بين دو نحس و طريقه محترفه و خالى السير خاصه كه از نحس منصرف بود هيچ كارى نشايد كرد00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، على المجموعة كلمات نسخ البدل، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، جاء في آخرها جدول بمنازل القمر في الأبراج الاثني عشر،جاء في آخر النسخة عدة جداول ورسومات في استخراج طالع الوقت، ومنازل الأبراج، عليها ختم الناسخ البيضويّ رسمهُ: «عبده محمّد رضا 1250»، وختم وقفيّة: «سيّد عبّاس شبّر»، وأختام مكتبة المدرسة الشبّريّة الدائريّ، والبيضويّ، والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 172/2،00aاللغة : فارسيّ.00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، على المجموعة كلمات نسخ البدل، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، جاء في آخرها جدول بمنازل القمر في الأبراج الاثني عشر،جاء في آخر النسخة عدة جداول ورسومات في استخراج طالع الوقت، ومنازل الأبراج، عليها ختم الناسخ البيضويّ رسمهُ: «عبده محمّد رضا 1250»، وختم وقفيّة: «سيّد عبّاس شبّر»، وأختام مكتبة المدرسة الشبّريّة الدائريّ، والبيضويّ، والمستطيل. 4aهيئةvمخطوطات.10aمحمّد رضا،eناسخ.40uhttps://dromh.org/?view=fdab66ad00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03536ctm a2200373 i b218953261016s1833    xx            000 0 per d00a(DROMH) dromh-218953-251a870700aIQ-KaCCSbaracIQ-KaCCSerda00aper04aQB23b.M36 183300c(300aMS172/11 aالبيهقيّ الكاشفيّ، حسين بن عليّ،dتوفي 910 هجري،eمؤلف.10aلوايح القمر10aلوايح القمر = اختيارات نجوم = سبعه كاشفي            (3ظ - 117ظ) /cالبيهقيّ الكاشفيّ، حسين بن عليّ (ت910هـ).33aاختيارات نجوم33aسبعه كاشفي            (3ظ - 117ظ)00cشهر رجّب المرجّب سنة 1249هـ = [1833]00a115 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نستعليق.00aاوله : الحمد لله الذي بيد حكمته أزمّة الاختيار وبقبضة قدرته أعنّة الاقتدار والصلاة على حبيبه محمّد..بعد از اداى ثناى قادر مختار جَلّتْ عظمته و عَلَتْ کلمته..00aاخره : به حسب مرتبه ايشان اثرى بود و هر چند مرتبه اعلى و اکمل باشد اثر اختيار در حق وى اتم و اشمل بود و آن جامع الاشمل و متم النور و اليه تصير الأمور00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، على المجموعة كلمات نسخ البدل، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، جاء في آخرها جدول بمنازل القمر في الأبراج الاثني عشر،جاء في آخر النسخة عدة جداول ورسومات في استخراج طالع الوقت، ومنازل الأبراج، عليها ختم الناسخ البيضويّ رسمهُ: «عبده محمّد رضا 1250»، وختم وقفيّة: «سيّد عبّاس شبّر»، وأختام مكتبة المدرسة الشبّريّة الدائريّ، والبيضويّ، والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 172/1،00aاللغة : فارسيّ.00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، على المجموعة كلمات نسخ البدل، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، جاء في آخرها جدول بمنازل القمر في الأبراج الاثني عشر،جاء في آخر النسخة عدة جداول ورسومات في استخراج طالع الوقت، ومنازل الأبراج، عليها ختم الناسخ البيضويّ رسمهُ: «عبده محمّد رضا 1250»، وختم وقفيّة: «سيّد عبّاس شبّر»، وأختام مكتبة المدرسة الشبّريّة الدائريّ، والبيضويّ، والمستطيل. 4aهيئةvمخطوطات.10aمحمّد رضا،eناسخ.40uhttps://dromh.org/?view=251a870700aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03652ctm a2200337 i b218952261016s1910    xx            000 0 ara d00a(DROMH) dromh-218952-5c6a6bac00aIQ-KaCCSbaracIQ-KaCCSerda04aBP183.3b.M36 191000c(300aMS1711 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aالأنوار اللامعة في شرح الزيارة الجامعة10aالأنوار اللامعة في شرح الزيارة الجامعة /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00cآخر عشرة من شهر شوال المكرّم سنة 1328هـ = [1910]00a88 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله على آلائه، والحمد من آلائه، والشكر لله على نعمائه والشكر من نعمائه، والصلاة على محمّد خاتم أنبيائه..أمّا بعد لا يخفى على أولي البصائر النقادة..00aاخره : في هذا الشرح من الواجب المقدور فأني كُتِبَت هذه الوريقات مع تبلبل البال..وأن لا يفرق بيني وبينهم طرفة عين في الدنيا والآخرة بحق محمّد وآله الخيرة المصطفين00aعليها بلاغات المقابلة، وبعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمِداد الأزرق، عليها تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 171،00aاللغة : عربيّ.00aعليها بلاغات المقابلة، وبعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمِداد الأزرق، عليها تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ00aعليها بلاغات المقابلة، وبعض الحواشي، العناوين ورؤوس المطالب كُتِبَت بالمِداد الأزرق، عليها تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1343هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ 4aدعاءvمخطوطات.40uhttps://dromh.org/?view=5c6a6bac00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03279ctm a2200337 i b218951261016s1871    xx            000 0 ara d00a(DROMH) dromh-218951-3dd234b000aIQ-KaCCSbaracIQ-KaCCSerda04aPJ6101b.M36 187100c(300aMS170/21 aالقزوينيّ، محسن بن محمّد طاهر،dتوفي 1150 هجري،eمؤلف.10aشرح العوامل المائة (نسخة أخرى)(11ظ - 111ظ)10aشرح العوامل المائة (نسخة أخرى)(11ظ - 111ظ) /cالقزوينيّ، محسن بن محمّد طاهر (ت1150هـ).00cيوم الجمعة سنة 1288هـ = [1871]00a101 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : أحمدك يا مَن يرفع صالح العمل وأصلي على نبيك محمّد وآله المبني لهم كرامة المحل، أمّا بعد النحو علم بأصول تعرف بها أواخر الكلمات إعراباً وبناءً..00aاخره : ها هنا ما لا يكون زائدة فدخل نحو هذا بهذا. والحمد لله خلاصة ما أردناه وهي مما يدخرون ليوم لا ينفع مال ولا بنون ولمثلِ هذا فليعمل العاملون00aعليها حواشٍ بإمضاء: «ره»، «نظر علي»، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر،على المجموعة تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها أختام مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 170/2،00aاللغة : عربيّ.00aعليها حواشٍ بإمضاء: «ره»، «نظر علي»، عليها نقولات توضيحيّة من الكتب مع ذكر المصادر، العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر،على المجموعة تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها أختام مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ والمستطيل. 4aنحوvمخطوطات.10aمير عليّ نقيّ بن مير صالح،eناسخ.40uhttps://dromh.org/?view=3dd234b000aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03864ctm a2200373 i b218950261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218950-e654ecec00aIQ-KaCCSbaracIQ-KaCCSerda04aPJ6101b.M3600c(300aMS170/11 aابن آجروم، محمّد بن محمّد،dتوفي 723 هجري،eمؤلف.10aالآجرومية10aالآجرومية = مقدّمة الآجرومية   (1ظ - 10ظ) /cابن آجروم، محمّد بن محمّد (ت723هـ).33aمقدّمة الآجرومية   (1ظ - 10ظ)00c[تاريخ الانتاج غير محدد]00a10 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الكلام هو اللفظ المركب المفيد بالوضع واقسامه ثلاثة: اسم، وفعل، وحرف جاء لمعنى، فالاسم يعرف بالخفض والتنوين ودخول الألف واللام..00aاخره : وللجزم علامتان السكون والحذف، فأما السكون؛ فيكون علامة للجزم في الفعل المضارع الصحيح الآخر. وأمّا الحذف فيكون...00aآخر النسخة (ناقص)،عليها بعض الحواشي، على المجموعة تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها أختام مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ والمستطيل.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 170/1،00aاللغة : عربيّ.00aآخر النسخة (ناقص)،عليها بعض الحواشي، على المجموعة تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها أختام مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ والمستطيل.00aآخر النسخة (ناقص)،عليها بعض الحواشي، على المجموعة تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها أختام مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ والمستطيل.00aآخر النسخة (ناقص)،عليها بعض الحواشي، على المجموعة تملّك السيّد عبّاس ابن السيّد محمّد الشبّر الحسينيّ الموسويّ ووقفيّته سنة 1337هـ في مدينة البصرة، وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الشبّر الحسينيّ»، عليها أختام مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ والمستطيل. 4aنحوvمخطوطات.10aمير عليّ نقيّ بن مير صالح،eناسخ.40uhttps://dromh.org/?view=e654ecec00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف04118ctm a2200349 i b218949261016s1920    xx            000 0 ara d00a(DROMH) dromh-218949-3a79bd4f00aIQ-KaCCSbaracIQ-KaCCSerda04aDS38.2b.M36 192000c(300aMS1691 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aقصص الأنبياء10aقصص الأنبياء /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00c23 من شهر رمضان المبارك سنة 1339هـ = [1920]00a188 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله على ما جرى به قضائه في رسله وأنبيائه وأوليائه الذين استخلصهم لتحمّل شرائع أحكامه وجعلهم أعلاماً في عبادهُ ومناراً في بلاده..00aاخره : اللهم ارحم منا الصغير والكبير وُمنَّ علينا بجبر الكسير ولا تؤاخذنا بذنب صغير ولا كبير بحق محمّد وآله الطاهرين00aعليها بلاغات المقابلة على نسخة الأصل، وكلمات نسخ البدل، العناوين ورؤوس المطالب كُتِبَت بالمداد الاحمر، مُيّزَت الآيات القرآنية بخطٍّ أحمر فوقها، كَتَبَ الناسخ في حاشية المقدّمة ترجمة مختصرة للمؤلِّف وفي آخرها فِهرِس بعناوين أبواب الكتاب الخمسة والثلاثون، عليها تملّك الناسخ ووقفيّته وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الحسينيّ»، عليها أختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 169،00aاللغة : عربيّ.00aعليها بلاغات المقابلة على نسخة الأصل، وكلمات نسخ البدل، العناوين ورؤوس المطالب كُتِبَت بالمداد الاحمر، مُيّزَت الآيات القرآنية بخطٍّ أحمر فوقها، كَتَبَ الناسخ في حاشية المقدّمة ترجمة مختصرة للمؤلِّف وفي آخرها فِهرِس بعناوين أبواب الكتاب الخمسة والثلاثون، عليها تملّك الناسخ ووقفيّته وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الحسينيّ»، عليها أختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل00aعليها بلاغات المقابلة على نسخة الأصل، وكلمات نسخ البدل، العناوين ورؤوس المطالب كُتِبَت بالمداد الاحمر، مُيّزَت الآيات القرآنية بخطٍّ أحمر فوقها، كَتَبَ الناسخ في حاشية المقدّمة ترجمة مختصرة للمؤلِّف وفي آخرها فِهرِس بعناوين أبواب الكتاب الخمسة والثلاثون، عليها تملّك الناسخ ووقفيّته وختمهُ البيضويّ رسمهُ: «عبّاس بن محمّد الحسينيّ»، عليها أختام مكتبة المدرسة الشبّرية الدائريّ والبيضويّ والمستطيل 4aتاريخvمخطوطات.10aالسيّد عبّاس ابن السيّد محمّد شبّر (حفيد المؤلِّف)،eناسخ.40uhttps://dromh.org/?view=3a79bd4f00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02842ctm a2200349 i b218948261016s1920    xx            000 0 ara d00a(DROMH) dromh-218948-09bec1c500aIQ-KaCCSbaracIQ-KaCCSerda04aR128.3b.M36 192000c(300aMS1681 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aطب الأئمة (نسخة اخرى)10aطب الأئمة (نسخة اخرى) /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00c11 شهر ربيع الآخر سنة 1339هـ = [1920]00a279 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله الذي اسمه دواء، وذكره شفاء، والغفلة عنه أعظم الداء، والصلاة على سيّد الرسل وخاتم الأنبياء..أمّا بعد فيقول المذنب الجاني الأسير الفاني..00aاخره : ما ولي أجلنا، وخير أعمالنا خواتمها، وخير أيامنا يوم نلقاك، ولنقتصر على ذلك حامدين الله شاكرين مصلّين على سيّد الأنبياء والمرسلين محمّد وآله الطاهرين00aعليها بلاغات المقابلة، مشحونة بالحواشي، جاء في أولها بعض الفوائد الطبية، النسخة من متملّكات الناسخ، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 168،00aاللغة : عربيّ.00aعليها بلاغات المقابلة، مشحونة بالحواشي، جاء في أولها بعض الفوائد الطبية، النسخة من متملّكات الناسخ، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ00aعليها بلاغات المقابلة، مشحونة بالحواشي، جاء في أولها بعض الفوائد الطبية، النسخة من متملّكات الناسخ، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ 4aطبvمخطوطات.10aمحمّد بن جعفر بن عبد الله الشبّر الحسينيّ،eناسخ.40uhttps://dromh.org/?view=09bec1c500aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02963ctm a2200349 i b218947261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218947-08870ed800aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS167/71 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aمفاتيح الصلاة    (184ظ - 196ظ)10aمفاتيح الصلاة    (184ظ - 196ظ) /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00c[تاريخ الانتاج غير محدد]00a13 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله ربِّ العالمين وصلى الله على محمّد وآله الطاهرين ولعن الله أعداءهم من الأوّلين والآخرين إلى يوم الدين..كتاب مفاتيح الصلاة الكتاب مصدر..00aاخره : وهي طويلة قال في آخرها تستدخل ثم تدعها مليّا، ثم تخرجها إخراجًا رفيقا فأن كان الدم مكوّمًا في القطنة فهو من العذرة وإن كان متنقعاً في القطنة فهو من الحيض00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها بعض الحواشي ،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 167/7،00aاللغة : عربيّ.00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها بعض الحواشي ،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ.00aالعناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر، عليها بعض الحواشي ،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ. 4aفقهvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=08870ed800aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02332ctm a2200337 i b218946261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218946-21f6172100aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS167/61 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aجواز العمل بالظن وعدمه  (178ظ - 182ظ)10aجواز العمل بالظن وعدمه  (178ظ - 182ظ) /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00c[تاريخ الانتاج غير محدد]00a5 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله الذي فضلنا على غيرنا باتباع الثقلين عند اختلاف الآراء وأمرنا بالتمسك بهما والمتابعة لهما..هذه تحقيقات وافية وتدقيقات شافية..00aاخره : والصدوق في المجالس بسندهما عن زرارة بن أعين قال سألت أبا جعفر ع ما حق الله على العباد قال أن يقولوا ما يعملون ويقفوا عندما لا يعلمون00aعلى المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 167/6،00aاللغة : عربيّ.00aعلى المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ 4aأصول الفقهvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=21f6172100aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02876ctm a2200337 i b218945261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218945-b6aa39da00aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS167/51 aالكلينيّ، محمّد بن يعقوب،dتوفي 329 هجري،eمؤلف.10aالكافي  (156ظ - 175ظ)10aالكافي  (156ظ - 175ظ) /cالكلينيّ، محمّد بن يعقوب (ت329هـ).00c[تاريخ الانتاج غير محدد]00a20 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : حديث هشام بن الحكم الحسين بن محمّد عن أحمد بن محمّد السياريّ عن أبي يعقوب البغداديّ قال: قال ابن السكيت لابي الحسن عليه السلام..00aاخره : قال أحمد بن مهران عن محمّد بن عليّ عن فضيل بن عثمان عن طاهر قال: كنت قاعداً عند أبي جعفر ع فأقبل جعفر (ع) فقال أبي جعفر هذا خير البرية00aعليها كلمات نسخ البدل،عليها بعض الحواشي ،العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 167/5،00aاللغة : عربيّ.00aعليها كلمات نسخ البدل،عليها بعض الحواشي ،العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ00aعليها كلمات نسخ البدل،عليها بعض الحواشي ،العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ 4aحديثvمخطوطات.40uhttps://dromh.org/?view=b6aa39da00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف03000ctm a2200337 i b218944261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218944-8776bab600aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS167/41 aالبحرانيّ، يوسف بن أحمد،dتوفي 1186 هجري،eمؤلف.10aالحدائق الناضرة في أحكام العترة الطاهرة                  (107و - 155و)10aالحدائق الناضرة في أحكام العترة الطاهرة                  (107و - 155و) /cالبحرانيّ، يوسف بن أحمد (ت1186هـ).00c[تاريخ الانتاج غير محدد]00a49 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : ...وقد رتبتها على أبواب الباب الأوّل في الطهارة وفيه فصول الأوّل في الوضوء وفيه مسائل الأولى موجبات الوضوء...00aاخره : ويجلس ويعمل بمقتضى الشك في تلك الصورة، والصورة الثانية الشك بعد السجود أي بعد تمام ذكر السجدة الثانية التي يتحقق00aأول النسخة (ناقص)،عليها كلمات نسخ البدل ،عليها حواشٍ بإمضاء: «منه ره» مُيّزَ المتن بخطٍّ أسود فوقه،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 167/4،00aاللغة : عربيّ.00aأول النسخة (ناقص)،عليها كلمات نسخ البدل ،عليها حواشٍ بإمضاء: «منه ره» مُيّزَ المتن بخطٍّ أسود فوقه،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ00aأول النسخة (ناقص)،عليها كلمات نسخ البدل ،عليها حواشٍ بإمضاء: «منه ره» مُيّزَ المتن بخطٍّ أسود فوقه،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ 4aفقهvمخطوطات.40uhttps://dromh.org/?view=8776bab600aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02841ctm a2200337 i b218943261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218943-9d192f8f00aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS167/31 aالنراقيّ، أحمد بن محمّد مهديّ،dتوفي 1245 هجري،eمؤلف.10aعين الأصول(53ظ - 105و)10aعين الأصول(53ظ - 105و) /cالنراقيّ، أحمد بن محمّد مهديّ (ت1245هـ).00c[تاريخ الانتاج غير محدد]00a53 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : الحمد لله الذي ربط بالأصول شوارد الفروع والمسائل وضبط شتات الأحكام بقواعد الأمارات والمخايل..هذه نخبة ما أورده الأصوليين في مصنفاتهم..00aاخره : يفيد العلم بنفسه وقيد الآخر لإخراج ما يفيد العلم لا بنفسه بل إما بالقرائن الزائدة على ما ينفك الخبر عنه وإما بغير القرائن والكثرة الموجبة للعلم هنا من00aآخر النسخة (ناقص)،العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر ،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 167/3،00aاللغة : عربيّ.00aآخر النسخة (ناقص)،العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر ،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ.00aآخر النسخة (ناقص)،العناوين ورؤوس المطالب كُتِبَت بالمداد الأحمر ،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ. 4aأصول الفقهvمخطوطات.40uhttps://dromh.org/?view=9d192f8f00aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02772ctm a2200349 i b218942261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218942-c69ec63800aIQ-KaCCSbaracIQ-KaCCSerda04aBP188b.M3600c(300aMS167/21 aآل شبّر الحسينيّ، عبد الله بن محمّد رضا،dتوفي 1242 هجري،eمؤلف.10aشرح الحقائق (25ظ - 50و)10aشرح الحقائق (25ظ - 50و) /cآل شبّر الحسينيّ، عبد الله بن محمّد رضا (ت1242هـ).00c[تاريخ الانتاج غير محدد]00a26 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله الذي ألهمنا حقائق الإيمان..فيقول العبد الآبق، العاصي، الغريق في بحار الآثام والمعاصي، أفقر الخلق إلى ربه الغنيّ عبد الله..00aاخره : بتأييد الله (عز وجل) وتوفيقه نكشف عن وجه الحق فيه النقاب بحيث لا يبقى بعده شك ولا ارتياب، فنقول وبالله التوفيق وبيده أزمّة التحقيق00aعليها بعض الحواشي ،مُيّزَ المتن بخطٍّ أسود فوقه،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ.10aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف : 167/2،00aاللغة : عربيّ.00aعليها بعض الحواشي ،مُيّزَ المتن بخطٍّ أسود فوقه،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ.00aعليها بعض الحواشي ،مُيّزَ المتن بخطٍّ أسود فوقه،على المجموعة وقفيّة السيّد عبد الله ابن السيّد محمّد رضا شبّر، عليها ختما مكتبة المدرسة الشبّريّة الدائريّ والبيضويّ. 4aأخلاقvمخطوطات.10aبخط المؤلف،eناسخ.40uhttps://dromh.org/?view=c69ec63800aفهرس مخطوطات مكتبة المدرسة الشبرية في النجف الاشرف02842ctm a2200349 i b218941261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-218941-27748f3900aIQ-KaCCSbaracIQ-