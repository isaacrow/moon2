261016s1978    xx            000 0 per d00a(DROMH) dromh-170608-e7906ef400aIQ-KaCCSbaracIQ-KaCCSerda00aper04aBP20b.M36 197800c(300aMS1001 aالمركز الصحي لحوزة خُراسان،eمؤلف.10aنشاطات المركز الصحي10aنشاطات المركز الصحي /cالمركز الصحي لحوزة خُراسان.00c1جمادى الأولى سنة 1398هـ = [1978]00a1 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود00aالجهة المستلمة: السيد محمّــــد باقــــر الطباطبائيّ  (ت 1422هـ). إرسال نسخة من دليل نشاطات المركز الصحي للحوزة العلميّة في خُراسان خلال مدة ستة أشهر مع طلب إبداء الملحوظات والاقتراحات في ما يتعلق بتطوير المركز الصحي وتقديم الشكر والتقدير لمساهمة السيد الطباطبائيّ في الأمور الخيرية في إنشاء هذا المركز. عليها ختم بيضويّ للمركز الصحي للحوزة العلميّة في خُراسان.10aوثائق مكتبة السيد مرتضى الحجة في النجف الأشرف : 100،00aاللغة : فارسي.00aالجهة المستلمة: السيد محمّــــد باقــــر الطباطبائيّ  (ت 1422هـ). إرسال نسخة من دليل نشاطات المركز الصحي للحوزة العلميّة في خُراسان خلال مدة ستة أشهر مع طلب إبداء الملحوظات والاقتراحات في ما يتعلق بتطوير المركز الصحي وتقديم الشكر والتقدير لمساهمة السيد الطباطبائيّ في الأمور الخيرية في إنشاء هذا المركز. عليها ختم بيضويّ للمركز الصحي للحوزة العلميّة في خُراسان. 4aوثائق إداريةvمخطوطات.40uhttps://dromh.org/?view=e7906ef400aوثائق مكتبة السيد مرتضى الحجة في النجف الأشرف01405ctm a2200301 i 4500001000800000008004100008035003400049040003300083041000800116050002000124066000700144098000900151100003700160240003700197245006100234264002800295300001500323336003800338337003500376338002900411340002900440500033600469535009500805546002900900650004900929856003700978949008801015b170607261016s1976    xx            000 0 per d00a(DROMH) dromh-170607-e6a0421d00aIQ-KaCCSbaracIQ-KaCCSerda00aper04aBP20b.M36 197600c(300aMS991 aفاطمة حسين،eمؤلف.10aالسؤال عن الأحوال10aالسؤال عن الأحوال /cفاطمة حسين.00cسنة1396هـ = [1976]00a1 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود00aالجهة المستلمة: السيد محمّـــد باقـــر الطباطبائيّ  (ت 1422هـ). إعــلام وصـــول الرسائل وإيصالها إلى أصحابها والخبر بخروج الميرزا محمود من المستشفى وتماثله للشفاء. عليها توقيع المرسل.10aوثائق مكتبة السيد مرتضى الحجة في النجف الأشرف : 99،00aاللغة : فارسي. 4aوثائق اجتماعيةvمخطوطات.40uhttps://dromh.org/?view=e6a0421d00aوثائق مكتبة السيد مرتضى الحجة في النجف الأشرف01940ctm a2200301 i 4500001000800000008004100008035003400049040003300083041000800116050001500124066000700139098000900146100005000155240008300205245012000288264004800408300001500456336003800471337003500509338002900544340002900573500074400602535009501346546002901441650004301470856003701513949008801550b170606261016nuuuu    xx            000 0 per d00a(DROMH) dromh-170606-c27078ac00aIQ-KaCCSbaracIQ-KaCCSerda00aper04aBP20b.M3600c(300aMS981 aمحمّد علي جاوداني،eمؤلف.10aإرسال مبالغ لقراءة مجالس القرآن في المقابر10aإرسال مبالغ لقراءة مجالس القرآن في المقابر /cمحمّد علي جاوداني.00c[تاريخ الانتاج غير محدد]00a1 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود00aالجهة المستلمة: آية الله الآشتياني . استلام مبلغ (600) تومان لكل من الأخ علي مداحي والأخ محمّد علي جاوداني لقاء قراءتهم القرآن وإقامتهم المجالس على ثلاثة مقابر هي (مقبرة المرحوم آية الله الآشتياني  ومقبرة المرحوم الحاج هاشم الآشتياني ومقبرة المرحومة خانم ملكة زمان) لشهري ذي القعدة وذي الحجّة سنة وقد تم تسديد المبلغ عن طـــريق آيـة الله الآشتياني   بواسطـــة السيد محمّد باقر الطباطبائيّ. عليها توقيع المرسل.10aوثائق مكتبة السيد مرتضى الحجة في النجف الأشرف : 98،00aاللغة : فارسي. 4aوثائق ماليةvمخطوطات.40uhttps://dromh.org/?view=c27078ac00aوثائق مكتبة السيد مرتضى الحجة في النجف الأشرف01238ctm a2200289 i 450000100080000000800410000803500340004904000330008304100080011605000150012406600070013909800090014624000280015524500290018326400480021230000150026033600380027533700350031333800290034834000290037750002500040653500950065654600290