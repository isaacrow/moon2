ثُمَّ بَعَثۡنَٰهُمۡ لِنَعۡلَمَ أَيُّ ٱلۡحِزۡبَيۡنِ أَحۡصَىٰ لِمَا لَبِثُوٓاْ أَمَدࣰا12
نَّحۡنُ نَقُصُّ عَلَيۡكَ نَبَأَهُم بِٱلۡحَقِّۚ إِنَّهُمۡ فِتۡيَةٌ ءَامَنُواْ بِرَبِّهِمۡ وَزِدۡنَٰهُمۡ هُدࣰى13
وَرَبَطۡنَا عَلَىٰ قُلُوبِهِمۡ إِذۡ قَامُواْ فَقَالُواْ رَبُّنَا رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ لَن نَّدۡعُوَاْ مِن دُونِهِۦٓ إِلَٰهࣰاۖ لَّقَدۡ قُلۡنَآ إِذࣰا شَطَطًا14
هَـٰٓؤُلَآءِ قَوۡمُنَا ٱتَّخَذُواْ مِن دُونِهِۦٓ ءَالِهَةࣰۖ لَّوۡلَا يَأۡتُونَ عَلَيۡهِم بِسُلۡطَٰنِۭ بَيِّنࣲۖ فَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبࣰا15
وَإِذِ ٱعۡتَزَلۡتُمُوهُمۡ وَمَا يَعۡبُدُونَ إِلَّا ٱللَّهَ فَأۡوُۥٓاْ إِلَى ٱلۡكَهۡفِ يَنشُرۡ لَكُمۡ رَبُّكُم مِّن رَّحۡمَتِهِۦ وَيُهَيِّئۡ لَكُم مِّنۡ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 145،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=4845d2cf00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02344ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500081400525500040501339535011401744546002701858650003001885856003701915949009001952b254328261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254328-c9d36a1f00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1441 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : إِنَّ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ فِي نَارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآۚ أُوْلَـٰٓئِكَ هُمۡ شَرُّ ٱلۡبَرِيَّةِ6
إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ أُوْلَـٰٓئِكَ هُمۡ خَيۡرُ ٱلۡبَرِيَّةِ7
جَزَآؤُهُمۡ عِندَ رَبِّهِمۡ جَنَّـٰتُ عَدۡنࣲ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدࣰاۖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ ذَٰلِكَ لِمَنۡ خَشِيَ رَبَّهُۥ800aاخره : بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ
قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ1
مَلِكِ ٱلنَّاسِ2
إِلَٰهِ ٱلنَّاسِ3
مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ4
ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ5
مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ610aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 144،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=c9d36a1f00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02327ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500097200525500023001497535011401727546002701841650003001868856003701898949009001935b254327261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254327-2d69c2fc00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1431 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a6 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلۡحَقُّ وَأَنَّهُۥ يُحۡيِ ٱلۡمَوۡتَىٰ وَأَنَّهُۥ عَلَىٰ كُلِّ شَيۡءࣲ قَدِيرࣱ6
وَأَنَّ ٱلسَّاعَةَ ءَاتِيَةࣱ لَّا رَيۡبَ فِيهَا وَأَنَّ ٱللَّهَ يَبۡعَثُ مَن فِي ٱلۡقُبُورِ7
وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمࣲ وَلَا هُدࣰى وَلَا كِتَٰبࣲ مُّنِيرࣲ8
ثَانِيَ عِطۡفِهِۦ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِۖ لَهُۥ فِي ٱلدُّنۡيَا خِزۡيࣱۖ وَنُذِيقُهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ عَذَابَ ٱلۡحَرِيقِ9
ذَٰلِكَ بِمَا قَدَّمَتۡ يَدَاكَ وَأَنَّ ٱللَّهَ لَيۡسَ بِظَلَّـٰمࣲ لِّلۡعَبِيدِ1000aاخره : وَأَصۡحَٰبُ مَدۡيَنَۖ وَكُذِّبَ مُوسَىٰۖ فَأَمۡلَيۡتُ لِلۡكَٰفِرِينَ ثُمَّ أَخَذۡتُهُمۡۖ فَكَيۡفَ كَانَ نَكِيرِ4410aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 143،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=2d69c2fc00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03141ctm a2200325 i b254326261016s1896    xx            000 0 ara d00a(DROMH) dromh-254326-36a2c02100aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 189600c(300aMS1421 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1314هـ = [1896]00a13 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : ٱلَّذِينَ يُوفُونَ بِعَهۡدِ ٱللَّهِ وَلَا يَنقُضُونَ ٱلۡمِيثَٰقَ20
وَٱلَّذِينَ يَصِلُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ وَيَخۡشَوۡنَ رَبَّهُمۡ وَيَخَافُونَ سُوٓءَ ٱلۡحِسَابِ21
وَٱلَّذِينَ صَبَرُواْ ٱبۡتِغَآءَ وَجۡهِ رَبِّهِمۡ وَأَقَامُواْ ٱلصَّلَوٰةَ وَأَنفَقُواْ مِمَّا رَزَقۡنَٰهُمۡ سِرࣰّا وَعَلَانِيَةࣰ وَيَدۡرَءُونَ بِٱلۡحَسَنَةِ ٱلسَّيِّئَةَ أُوْلَـٰٓئِكَ لَهُمۡ عُقۡبَى ٱلدَّارِ22
جَنَّـٰتُ عَدۡنࣲ يَدۡخُلُونَهَا وَمَن صَلَحَ مِنۡ ءَابَآئِهِمۡ وَأَزۡوَٰجِهِمۡ وَذُرِّيَّـٰتِهِمۡۖ وَٱلۡمَلَـٰٓئِكَةُ يَدۡخُلُونَ عَلَيۡهِم مِّن كُلِّ00aاخره : هَٰذَا بَلَٰغࣱ لِّلنَّاسِ وَلِيُنذَرُواْ بِهِۦ وَلِيَعۡلَمُوٓاْ أَنَّمَا هُوَ إِلَٰهࣱ وَٰحِدࣱ وَلِيَذَّكَّرَ أُوْلُواْ ٱلۡأَلۡبَٰبِ52 بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ
