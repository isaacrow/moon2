6s18uu    xx            000 0 ara d00a(DROMH) dromh-250257-f2b5452b00aIQ-KaCCSbaracIQ-KaCCSerda04aPJ7541b.M3600c(300aMS11400aالمنتخب من شرح نهج البلاغة00aالمنتخب من شرح نهج البلاغة.00cق13هـ = [القرن 19 م]00a216 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحَمدُ لله الّذي تفرّد بالكمال فكلّ..فإنّي لمّا أتيت إلى اصطهبانا رأيت شرح نهج البلاغة لابن أبي الحديد، فانتخبت منه..00aاخره : فإبليس لعنه الله أعرف منه بهذه الصّناعة بل ربمّا قيل: أنّه أخذ عنه إبليس لعنه الله (تعالى) نوعًا من الغناء...00aناقصة الآخر، في آخرها فوائد ومطالب وقصص وتواريخ وأشعار مختلفة منها: بعض القصائد العلويّات لابن أبي الحديد، وقد خُلط بعض أوراقها10aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق : 114،cالعراقgiq00aاللغة : عربي.00aناقصة الآخر، في آخرها فوائد ومطالب وقصص وتواريخ وأشعار مختلفة منها: بعض القصائد العلويّات لابن أبي الحديد، وقد خُلط بعض أوراقها 4aأدبvمخطوطات.40uhttps://dromh.org/?view=f2b5452b00aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق02037ctm a2200349 i b250256261016s18uu    xx            000 0 per d00a(DROMH) dromh-250256-81b92a0000aIQ-KaCCSbaracIQ-KaCCSerda00aper04aPJ7541b.M3600c(300aMS1131 aصائب التّبريزيّ، محمّد عليّ بن عبد الرّحيم،dتوفي 1086 هجري،eمؤلف.10aديوان صائب تبريزي10aديوان صائب تبريزي = ديوان غزليات صائب تبريزي /cصائب التّبريزيّ، محمّد عليّ بن عبد الرّحيم (ت1086هـ).33aديوان غزليات صائب تبريزي00cق13هـ = [القرن 19 م]00a226 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نستعليق.00aاوله : ..اى دفتر حسن ترا فهراست خط و خالها ** تفصيلها پنهان شده در پرده اجمالها/ پيشانى عفو ترا پر چين نسازد جرم ما** آينه كى برهم خورد از زشتى تمثالها...00aاخره : بس خون كه كند در جگر گوشه نشينان ** اين كنج لب و كنج دهان كه تو دارى/ صائب چه خيالت كه بتوان به‏نشان يافت** اين گوشه با نامو نشان كه تو دارى00aناقصة الأوّل10aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق : 113،cالعراقgiq00aاللغة : فارسي.00aناقصة الأوّل 4aشعرvمخطوطات.40uhttps://dromh.org/?view=81b92a0000aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق03121ctm a2200325 i b250255261016s18uu    xx            000 0 ara d00a(DROMH) dromh-250255-cce8548000aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS1121 aالطباطبائي، محمد بن علي،dتوفي 1242 هجري،eمؤلف.10aمصابيح الأصول10aمصابيح الأصول /cالطباطبائي، محمد بن علي (ت1242هـ).00cق13هـ = [القرن 19 م]00a267 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : باب الأفعال والتّأسي قَالَ الله‏ (تعالى):﴿لَّقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ..﴾، إعلم أنّ فعل النّبيّ (ص) إن كان بيانًا لمجمل..00aاخره : عدّ القياس، وهل يترجح أحدهما على الآخر باعتضاده بمثله من دليل تعبدي آخر أو لا ؟ فيه إشكال ولكنّ الاحتمال الأوّل لا يخلو عن قوّة00aاشتملت على باب الأفعال والتّأسي إلى نهاية القول في القياس، وقفها الميرزا محمّد سليم بن عبد الكريم النّوريّ الكربلائيّ وحمل توليتها لنفسه، ثمّ لسيّد المجتهدين...آقا سيّد إبراهيم القزوينيّ، ثمّ لمجتهدين وعلماء بلدة كربلاء المقدّسة بشرط أن لا تخرج من بلدة كربلاء المقدّسة والنّجف الأشرف، وتأريخ الوقف في شهر رجب1250هـ، مع ختمه البيضوي:«الرّاجي إلى الله، عبده محمّد سليم»10aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق : 112،cالعراقgiq00aاللغة : عربي.00aاشتملت على باب الأفعال والتّأسي إلى نهاية القول في القياس، وقفها الميرزا محمّد سليم بن عبد الكريم النّوريّ الكربلائيّ وحمل توليتها لنفسه، ثمّ لسيّد المجتهدين...آقا سيّد إبراهيم القزوينيّ، ثمّ لمجتهدين وعلماء بلدة كربلاء المقدّسة بشرط أن لا تخرج من بلدة كربلاء المقدّسة والنّجف الأشرف، وتأريخ الوقف في شهر رجب1250هـ، مع ختمه البيضوي:«الرّاجي إلى الله، عبده محمّد سليم» 4aاصول الفقهvمخطوطات.40uhttps://dromh.org/?view=cce8548000aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق02185ctm a2200325 i b250254261016s16uu    xx            000 0 ara d00a(DROMH) dromh-250254-0ff0021800aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS1111 aالحداديّ العبّاديّ، أبو بكر بن عليّ،dتوفي 800 هجري،eمؤلف.10aسراج الظلام (وبدر التمام)10aسراج الظلام (وبدر التمام) /cالحداديّ العبّاديّ، أبو بكر بن عليّ (ت800هـ).00cق11هـ = [القرن 17 م]00a199 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : وبه نستعين، على القوم الكافرين. كتاب (الزّكاة) العبادات ثلاثة أنواع، بدني محض كالصّلاة والصّوم والجهاد، ومالي محض كالزّكاة، ومركب منهما كالحجّ..00aاخره : كذا في الهداية وقوله: فاحفظوا تفصيلي، أي هذا الّذي بينته من ذكر النّسختين وبيان حجّتيهما وخلاف زفر، وبالله التّوفيق والله سبحانه أعلم00aاشتملت على كتاب الزّكاة إلى كتاب الحجّ، عليها بلاغ المقابلة، والمتن كتب بالمداد الأحمر10aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق : 111،cالعراقgiq00aاللغة : عربي.00aاشتملت على كتاب الزّكاة إلى كتاب الحجّ، عليها بلاغ المقابلة، والمتن كتب بالمداد الأحمر 4aفقهvمخطوطات.40uhttps://dromh.org/?view=0ff0021800aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق01798ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001700116066000700133098001000140240008300150245008400233264003400317300001600351336003800367337003500405338002900440340004300469500023000512500022700742500005000969535014001019546002701159650002801186700011901214856003701333949011401370b250253261016s17uu    xx            000 0 ara d00a(DROMH) dromh-250253-7e724a4200aIQ-KaCCSbaracIQ-KaCCSerda04aPJ6101b.M3600c(300aMS11000aحاشية على حاشية اللقاني على شرح التفتازاني00aحاشية على حاشية اللقاني على شرح التفتازاني.00cق12هـ = [القرن 18 م]00a34 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحَمدُ لله ربّ العالمين، والصّلاة والسّلام على أفضل خلق الله محمّد وعلى آله وصحبه أجمعين. وبعد، فهذه فوائد بل زوائد..00aاخره : مضارع المتكلّم الأمر الواحد المخاطب، قَالَ: وتقدّمها أي الحال عليه أي على ذي الحال مع كونه معرفة وهو بدون ضرورة ضعيف00aعليها حواشٍ بإمضاء:«منه»10aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق : 110،cالعراقgiq00aاللغة : عربي. 4aصرفvمخطوطات.10aابراهيم ابن السيد قاسم ابن السيد حسن بن بايزيد البرزنجي،eناسخ.40uhttps://dromh.org/?view=7e724a4200aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق02590ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001600116066000700132098001200139240004100151245004200192264003400234300001600268336003800284337003500322338002900357340004300386500022300429500019700652500053300849535014201382546002701524561053301551650004102084856003702125949011402162b250252261016s18uu    xx            000 0 ara d00a(DROMH) dromh-250252-b02b079d00aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS109/200aحاشية معالم الأُصول00aحاشية معالم الأُصول.00cق13هـ = [القرن 19 م]00a81 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : إعلم أنّ من العلوم مبادئ تصوريّة أو تصديقيّة، ومن المبادئ التّصوريّة معرفة العلم وهي تحصل بحدّه فيكون حد كلّ علم..00aاخره : كذلك لانّه..يسلم أنّ المدّعى ثبوت الوجوب لغة لكن يقول إنّه لا يثبت إلّا بالشّرع وهو ظاهر الفساد لانّ00aغير تامة الآخر، اشتملت من أوّل الكتاب إلى بحث الأوامر ودلالتها على الوجوب، وهناك نسخة من هذه الحاشية ذكرت في فهرس مكتبة آية الله العظمى الگلپايگانيّ (قم) الجزء (3) الصّفحة (1555) واحتمل انّها من تأليفات السّيّد الميرزا حسن المدرّس، عليها وقفيّة عبد الحميد الفراهانيّ للعتبات المقدّسة في العراق10aمكتبة العتبة العباسية المقدسة (ج1) في كربلاء المقدسة - العراق : 109/2،cالعراقgiq00aاللغة : عربي.00aغير تامة الآخر، اشتملت من أوّل الكتاب إلى بحث الأوامر ودلالتها على الوجوب، وهناك نسخة من هذه الحاشية ذكرت في فهرس مكتبة آية الله العظمى الگلپايگانيّ (قم) الجزء (3) الصّفحة (1555) واحتمل انّها من تأليفات السّيّد الميرزا حسن المدرّس، عليها وقفيّة عبد الحميد الف