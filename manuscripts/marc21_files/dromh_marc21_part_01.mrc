فَأُمُّهُۥ هَاوِيَةࣱ9
وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ10
نَارٌ حَامِيَةُۢ1110aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 196،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=9d51f5c300aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04579ctm a2200325 i b254379261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254379-d45c352900aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1951 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a9 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَيَٰقَوۡمِ لَا يَجۡرِمَنَّكُمۡ شِقَاقِيٓ أَن يُصِيبَكُم مِّثۡلُ مَآ أَصَابَ قَوۡمَ نُوحٍ أَوۡ قَوۡمَ هُودٍ أَوۡ قَوۡمَ صَٰلِحࣲۚ وَمَا قَوۡمُ لُوطࣲ مِّنكُم بِبَعِيدࣲ89
وَٱسۡتَغۡفِرُواْ رَبَّكُمۡ ثُمَّ تُوبُوٓاْ إِلَيۡهِۚ إِنَّ رَبِّي رَحِيمࣱ وَدُودࣱ90
قَالُواْ يَٰشُعَيۡبُ مَا نَفۡقَهُ كَثِيرࣰا مِّمَّا تَقُولُ وَإِنَّا لَنَرَىٰكَ فِينَا ضَعِيفࣰاۖ وَلَوۡلَا رَهۡطُكَ لَرَجَمۡنَٰكَۖ وَمَآ أَنتَ عَلَيۡنَا بِعَزِيزࣲ91
قَالَ يَٰقَوۡمِ أَرَهۡطِيٓ أَعَزُّ عَلَيۡكُم مِّنَ ٱللَّهِ وَٱتَّخَذۡتُمُوهُ وَرَآءَكُمۡ ظِهۡرِيًّاۖ إِنَّ رَبِّي بِمَا تَعۡمَلُونَ مُحِيطࣱ92
وَيَٰقَوۡمِ ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ إِنِّي عَٰمِلࣱۖ سَوۡفَ تَعۡلَمُونَ مَن يَأۡتِيهِ عَذَابࣱ يُخۡزِيهِ وَمَنۡ هُوَ كَٰذِبࣱۖ وَٱرۡتَقِبُوٓاْ إِنِّي مَعَكُمۡ رَقِيبࣱ9300aاخره : ثُمَّ يَأۡتِي مِنۢ بَعۡدِ ذَٰلِكَ سَبۡعࣱ شِدَادࣱ يَأۡكُلۡنَ مَا قَدَّمۡتُمۡ لَهُنَّ إِلَّا قَلِيلࣰا مِّمَّا تُحۡصِنُونَ48
ثُمَّ يَأۡتِي مِنۢ بَعۡدِ ذَٰلِكَ عَامࣱ فِيهِ يُغَاثُ ٱلنَّاسُ وَفِيهِ يَعۡصِرُونَ49
وَقَالَ ٱلۡمَلِكُ ٱئۡتُونِي بِهِۦۖ فَلَمَّا جَآءَهُ ٱلرَّسُولُ قَالَ ٱرۡجِعۡ إِلَىٰ رَبِّكَ فَسۡـَٔلۡهُ مَا بَالُ ٱلنِّسۡوَةِ ٱلَّـٰتِي قَطَّعۡنَ أَيۡدِيَهُنَّۚ إِنَّ رَبِّي بِكَيۡدِهِنَّ عَلِيمࣱ50
قَالَ مَا خَطۡبُكُنَّ إِذۡ رَٰوَدتُّنَّ يُوسُفَ عَن نَّفۡسِهِۦۚ قُلۡنَ حَٰشَ لِلَّهِ مَا عَلِمۡنَا عَلَيۡهِ مِن سُوٓءࣲۚ قَالَتِ ٱمۡرَأَتُ ٱلۡعَزِيزِ ٱلۡـَٰٔنَ حَصۡحَصَ ٱلۡحَقُّ أَنَا۠ رَٰوَدتُّهُۥ عَن نَّفۡسِهِۦ وَإِنَّهُۥ لَمِنَ ٱلصَّـٰدِقِينَ51
ذَٰلِكَ لِيَعۡلَمَ أَنِّي لَمۡ أَخُنۡهُ بِٱلۡغَيۡبِ وَأَنَّ ٱللَّهَ لَا يَهۡدِي كَيۡدَ ٱلۡخَآئِنِينَ52
وَمَآ أُبَرِّئُ نَفۡسِيٓ00aوقفية الحاج مهديشان النائب لهذا المصحف الشريف على كافة الناس في دارالخلافة طهران والتولية مع الواقف بتاریخ 1304هـ، الختم المربع (يا امام محمد مهدي)10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 195،cايرانgir00aاللغة : عربي.00aوقفية الحاج مهديشان النائب لهذا المصحف الشريف على كافة الناس في دارالخلافة طهران والتولية مع الواقف بتاریخ 1304هـ، الختم المربع (يا امام محمد مهدي) 4aقرانvمخطوطات.40uhttps://dromh.org/?view=d45c352900aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03296ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500107700525500109401602535011402696546002702810650003002837856003702867949009002904b254378261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254378-a09d1f0900aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1941 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a9 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : لَا يَمۡلِكُونَ شَيۡـࣰٔا وَلَا يَعۡقِلُونَ43
قُل لِّلَّهِ ٱلشَّفَٰعَةُ جَمِيعࣰاۖ لَّهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ ثُمَّ إِلَيۡهِ تُرۡجَعُونَ44
وَإِذَا ذُكِرَ ٱللَّهُ وَحۡدَهُ ٱشۡمَأَزَّتۡ قُلُوبُ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِۖ وَإِذَا ذُكِرَ ٱلَّذِينَ مِن دُونِهِۦٓ إِذَا هُمۡ يَسۡتَبۡشِرُونَ45
قُلِ ٱللَّهُمَّ فَاطِرَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ عَٰلِمَ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ أَنتَ تَحۡكُمُ بَيۡنَ عِبَادِكَ فِي مَا كَانُواْ فِيهِ يَخۡتَلِفُونَ46
وَلَوۡ أَنَّ لِلَّذِينَ ظَلَمُواْ مَا فِي ٱلۡأَرۡضِ جَمِيعࣰا وَمِثۡلَهُۥ مَعَهُۥ لَٱفۡتَدَوۡاْ بِ00aاخره : مُّرۡتَابٌ34
ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ بِغَيۡرِ سُلۡطَٰنٍ أَتَىٰهُمۡۖ كَبُرَ مَقۡتًا عِندَ ٱللَّهِ وَعِندَ ٱلَّذِينَ ءَامَنُواْۚ كَذَٰلِكَ يَطۡبَعُ ٱللَّهُ عَلَىٰ كُلِّ قَلۡبِ مُتَكَبِّرࣲ جَبَّارࣲ35
وَقَالَ فِرۡعَوۡنُ يَٰهَٰمَٰنُ ٱبۡنِ لِي صَرۡحࣰا لَّعَلِّيٓ أَبۡلُغُ ٱلۡأَسۡبَٰبَ36
أَسۡبَٰبَ ٱلسَّمَٰوَٰتِ فَأَطَّلِعَ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّي لَأَظُنُّهُۥ كَٰذِبࣰاۚ وَكَذَٰلِكَ زُيِّنَ لِفِرۡعَوۡنَ سُوٓءُ عَمَلِهِۦ وَصُدَّ عَنِ ٱلسَّبِيلِۚ وَمَا كَيۡدُ فِرۡعَوۡنَ إِلَّا فِي تَبَابࣲ37
وَقَالَ ٱلَّذِيٓ ءَامَنَ يَٰقَوۡمِ ٱتَّبِعُونِ أَهۡدِكُمۡ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 194،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=a09d1f0900aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03984ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500137800525500148101903535011403384546002703498650003003525856003703555949009003592b254377261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254377-58bd504400aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1931 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ
سُبۡحَٰنَ ٱلَّذِيٓ أَسۡرَىٰ بِعَبۡدِهِۦ لَيۡلࣰا مِّنَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ إِلَى ٱلۡمَسۡجِدِ ٱلۡأَقۡصَا ٱلَّذِي بَٰرَكۡنَا حَوۡلَهُۥ لِنُرِيَهُۥ مِنۡ ءَايَٰتِنَآۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ1
وَءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ وَجَعَلۡنَٰهُ هُدࣰى لِّبَنِيٓ إِسۡرَـٰٓءِيلَ أَلَّا تَتَّخِذُواْ مِن دُونِي وَكِيلࣰا2
ذُرِّيَّةَ مَنۡ حَمَلۡنَا مَعَ نُوحٍۚ إِنَّهُۥ كَانَ عَبۡدࣰا شَكُورࣰا3
وَقَضَيۡنَآ إِلَىٰ بَنِيٓ إِسۡرَـٰٓءِيلَ فِي ٱلۡكِتَٰبِ لَتُفۡسِدُنَّ فِي ٱلۡأَرۡضِ مَرَّتَيۡنِ وَلَتَعۡلُنَّ عُلُوࣰّا كَبِيرࣰا4
فَإِذَا جَآءَ وَعۡدُ أُولَىٰهُمَا بَعَثۡنَا عَلَيۡكُمۡ عِبَادࣰا لَّنَآ أُوْلِي بَأۡسࣲ شَدِيدࣲ فَجَاسُواْ خِلَٰلَ ٱلدِّيَارِۚ وَكَانَ وَعۡدࣰا مَّفۡعُولࣰا500aاخره : ٱلۡقُرۡءَانِ مَا هُوَ شِفَآءࣱ وَرَحۡمَةࣱ لِّلۡمُؤۡمِنِينَۙ وَلَا يَزِيدُ ٱلظَّـٰلِمِينَ إِلَّا خَسَارࣰا82
وَإِذَآ أَنۡعَمۡنَا عَلَى ٱلۡإِنسَٰنِ أَعۡرَضَ وَنَـَٔا بِجَانِبِهِۦ وَإِذَا مَسَّهُ ٱلشَّرُّ كَانَ يَـُٔوسࣰا83
قُلۡ كُلࣱّ يَعۡمَلُ عَلَىٰ شَاكِلَتِهِۦ فَرَبُّكُمۡ أَعۡلَمُ بِمَنۡ هُوَ أَهۡدَىٰ سَبِيلࣰا84
وَيَسۡـَٔلُونَكَ عَنِ ٱلرُّوحِۖ قُلِ ٱلرُّوحُ مِنۡ أَمۡرِ رَبِّي وَمَآ أُوتِيتُم مِّنَ ٱلۡعِلۡمِ إِلَّا قَلِيلࣰا85
وَلَئِن شِئۡنَا لَنَذۡهَبَنَّ بِٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ ثُمَّ لَا تَجِدُ لَكَ بِهِۦ عَلَيۡنَا وَكِيلًا86
إِلَّا رَحۡمَةࣰ مِّن رَّبِّكَۚ إِنَّ فَضۡلَهُۥ كَانَ عَلَيۡكَ كَبِيرࣰا87
قُل لَّئِنِ ٱجۡتَمَعَتِ ٱلۡإِنسُ وَٱلۡجِنُّ عَلَىٰٓ أَن يَأۡتُواْ بِمِثۡلِ هَٰذَا ٱلۡقُرۡءَانِ لَا يَأۡتُونَ بِمِثۡلِهِۦ وَلَوۡ كَانَ بَعۡضُهُمۡ لِبَعۡضࣲ ظَهِيرࣰا8810aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 193،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=58bd504400aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02544ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500071400525500070501239535011401944546002702058650003002085856003702115949009002152b254376261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254376-b91e67df00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1921 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَٰحِدࣲ فَٱدۡعُ لَنَا رَبَّكَ يُخۡرِجۡ لَنَا مِمَّا تُنۢبِتُ ٱلۡأَرۡضُ مِنۢ بَقۡلِهَا وَقِثَّآئِهَا وَفُومِهَا وَعَدَسِهَا وَبَصَلِهَاۖ قَالَ أَتَسۡتَبۡدِلُونَ ٱلَّذِي هُوَ أَدۡنَىٰ بِٱلَّذِي هُوَ خَيۡرٌۚ ٱهۡبِطُواْ مِصۡرࣰا فَإِنَّ لَكُم مَّا سَأَلۡتُمۡۗ وَضُرِبَتۡ عَلَيۡهِمُ ٱلذِّلَّةُ وَٱلۡمَسۡكَنَةُ وَبَآءُو بِغَضَبࣲ مِّنَ ٱللَّهِۚ ذَٰلِكَ بِأَنَّهُمۡ كَانُواْ00aاخره : قَالُواْ سُبۡحَٰنَكَ لَا عِلۡمَ لَنَآ إِلَّا مَا عَلَّمۡتَنَآۖ إِنَّكَ أَنتَ ٱلۡعَلِيمُ ٱلۡحَكِيمُ32
قَالَ يَـٰٓـَٔادَمُ أَنۢبِئۡهُم بِأَسۡمَآئِهِمۡۖ فَلَمَّآ أَنۢبَأَهُم بِأَسۡمَآئِهِمۡ قَالَ أَلَمۡ أَقُل لَّكُمۡ إِنِّيٓ أَعۡلَمُ غَيۡبَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَأَعۡلَمُ مَا تُبۡدُونَ وَمَا كُنتُمۡ تَكۡتُمُونَ33
وَإِذۡ قُلۡنَا لِلۡمَلَـٰٓئِكَةِ ٱسۡجُدُواْ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 192،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=b91e67df00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02017ctm a2200301 i 4500001000800000008004100008035003400049040003300083050002000116066000700136098001000143100004900153240004200202245007800244264002200322300001600344336003800360337003500398338002900433340004300462500024900505500066300754535011401417546002701531650003001558856003701588949009001625b254375261016s1922    xx            000 0 ara d00a(DROMH) dromh-254375-a309305300aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 192200c(300aMS1911 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1341هـ = [1922]00a17 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَمَا هُوَ بِٱلۡهَزۡلِ14
