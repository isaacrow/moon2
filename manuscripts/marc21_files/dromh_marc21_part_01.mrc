ٱلَّذِينَ يَحۡمِلُونَ ٱلۡعَرۡشَ وَمَنۡ حَوۡلَهُۥ يُسَبِّحُونَ بِحَمۡدِ رَبِّهِمۡ وَيُؤۡمِنُونَ بِهِۦ وَيَسۡتَغۡفِرُونَ لِلَّذِينَ ءَامَنُواْۖ رَبَّنَا وَسِعۡتَ كُلَّ شَيۡءࣲ رَّحۡمَةࣰ وَعِلۡمࣰا فَٱغۡفِرۡ لِلَّذِينَ تَابُواْ وَٱتَّبَعُواْ سَبِيلَكَ وَقِهِمۡ عَذَابَ ٱلۡجَحِيمِ7
رَبَّنَا وَأَدۡخِلۡهُمۡ جَنَّـٰتِ عَدۡنٍ ٱلَّتِي وَعَدتَّهُمۡ وَمَن صَلَحَ مِنۡ ءَابَآئِهِمۡ وَأَزۡوَٰجِهِمۡ وَذُرِّيَّـٰتِهِمۡۚ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ800aاخره : إِنَّ ٱلَّذِينَ فَرَّقُواْ دِينَهُمۡ وَكَانُواْ شِيَعࣰا لَّسۡتَ مِنۡهُمۡ فِي شَيۡءٍۚ إِنَّمَآ أَمۡرُهُمۡ إِلَى ٱللَّهِ ثُمَّ يُنَبِّئُهُم بِمَا كَانُواْ يَفۡعَلُونَ159
مَن جَآءَ بِٱلۡحَسَنَةِ فَلَهُۥ عَشۡرُ أَمۡثَالِهَاۖ وَمَن جَآءَ بِٱلسَّيِّئَةِ فَلَا يُجۡزَىٰٓ إِلَّا مِثۡلَهَا وَهُمۡ لَا يُظۡلَمُونَ160
قُلۡ إِنَّنِي هَدَىٰنِي رَبِّيٓ إِلَىٰ صِرَٰطࣲ مُّسۡتَقِيمࣲ دِينࣰا قِيَمࣰا مِّلَّةَ إِبۡرَٰهِيمَ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 186،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=d69ee5ba00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03195ctm a2200301 i 4500001000800000008004100008035003400049040003300083050002000116066000700136098001000143100004900153240004200202245007800244264002200322300001500344336003800359337003500397338002900432340004300461500098300504500110801487535011402595546002702709650003002736856003702766949009002803b254369261016s1934    xx            000 0 ara d00a(DROMH) dromh-254369-251d506500aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 193400c(300aMS1851 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1353هـ = [1934]00a6 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡحَكِيمِ1
أَكَانَ لِلنَّاسِ عَجَبًا أَنۡ أَوۡحَيۡنَآ إِلَىٰ رَجُلࣲ مِّنۡهُمۡ أَنۡ أَنذِرِ ٱلنَّاسَ وَبَشِّرِ ٱلَّذِينَ ءَامَنُوٓاْ أَنَّ لَهُمۡ قَدَمَ صِدۡقٍ عِندَ رَبِّهِمۡۗ قَالَ ٱلۡكَٰفِرُونَ إِنَّ هَٰذَا لَسَٰحِرࣱ مُّبِينٌ2
إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامࣲ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ يُدَبِّرُ ٱلۡأَمۡرَۖ مَا مِن شَفِيعٍ إِلَّا مِنۢ بَعۡدِ إِذۡنِهِۦۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ فَٱعۡبُدُوهُۚ أَفَلَا تَذَكَّرُونَ300aاخره : ٱلنَّاسُ إِنَّمَا بَغۡيُكُمۡ عَلَىٰٓ أَنفُسِكُمۖ مَّتَٰعَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ ثُمَّ إِلَيۡنَا مَرۡجِعُكُمۡ فَنُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ23
إِنَّمَا مَثَلُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا كَمَآءٍ أَنزَلۡنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ مِمَّا يَأۡكُلُ ٱلنَّاسُ وَٱلۡأَنۡعَٰمُ حَتَّىٰٓ إِذَآ أَخَذَتِ ٱلۡأَرۡضُ زُخۡرُفَهَا وَٱزَّيَّنَتۡ وَظَنَّ أَهۡلُهَآ أَنَّهُمۡ قَٰدِرُونَ عَلَيۡهَآ أَتَىٰهَآ أَمۡرُنَا لَيۡلًا أَوۡ نَهَارࣰا فَجَعَلۡنَٰهَا حَصِيدࣰا كَأَن لَّمۡ تَغۡنَ بِٱلۡأَمۡسِۚ كَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمࣲ يَتَفَكَّرُونَ2410aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 185،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=251d506500aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03028ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500104200525500086101567535011402428546002702542650003002569856003702599949009002636b254368261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254368-33f77c8700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1841 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a9 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَتُزَكِّيهِم بِهَا وَصَلِّ عَلَيۡهِمۡۖ إِنَّ صَلَوٰتَكَ سَكَنࣱ لَّهُمۡۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ103
أَلَمۡ يَعۡلَمُوٓاْ أَنَّ ٱللَّهَ هُوَ يَقۡبَلُ ٱلتَّوۡبَةَ عَنۡ عِبَادِهِۦ وَيَأۡخُذُ ٱلصَّدَقَٰتِ وَأَنَّ ٱللَّهَ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ104
وَقُلِ ٱعۡمَلُواْ فَسَيَرَى ٱللَّهُ عَمَلَكُمۡ وَرَسُولُهُۥ وَٱلۡمُؤۡمِنُونَۖ وَسَتُرَدُّونَ إِلَىٰ عَٰلِمِ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ فَيُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ105
وَءَاخَرُونَ مُرۡجَوۡنَ لِأَمۡرِ ٱللَّهِ إِمَّا يُعَذِّبُهُمۡ وَإِمَّا يَتُوبُ عَلَيۡهِمۡۗ وَٱللَّهُ عَلِيمٌ حَكِيمࣱ10600aاخره : عَلَيۡهِمۡ كَلِمَتُ رَبِّكَ لَا يُؤۡمِنُونَ96
وَلَوۡ جَآءَتۡهُمۡ كُلُّ ءَايَةٍ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ97
فَلَوۡلَا كَانَتۡ قَرۡيَةٌ ءَامَنَتۡ فَنَفَعَهَآ إِيمَٰنُهَآ إِلَّا قَوۡمَ يُونُسَ لَمَّآ ءَامَنُواْ كَشَفۡنَا عَنۡهُمۡ عَذَابَ ٱلۡخِزۡيِ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينࣲ98
وَلَوۡ شَآءَ رَبُّكَ لَأٓمَنَ مَن فِي ٱلۡأَرۡضِ كُلُّهُمۡ جَمِيعًاۚ أَفَأَنتَ تُكۡرِهُ ٱلنَّاسَ حَتَّىٰ يَكُونُواْ مُؤۡمِنِينَ9910aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 184،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=33f77c8700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04467ctm a2200325 i b254367261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254367-d87c2da400aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1831 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a8 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : تِلۡكَ ٱلرُّسُلُ فَضَّلۡنَا بَعۡضَهُمۡ عَلَىٰ بَعۡضࣲۘ مِّنۡهُم مَّن كَلَّمَ ٱللَّهُۖ وَرَفَعَ بَعۡضَهُمۡ دَرَجَٰتࣲۚ وَءَاتَيۡنَا عِيسَى ٱبۡنَ مَرۡيَمَ ٱلۡبَيِّنَٰتِ وَأَيَّدۡنَٰهُ بِرُوحِ ٱلۡقُدُسِۗ وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلَ ٱلَّذِينَ مِنۢ بَعۡدِهِم مِّنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ وَلَٰكِنِ ٱخۡتَلَفُواْ فَمِنۡهُم مَّنۡ ءَامَنَ وَمِنۡهُم مَّن كَفَرَۚ وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلُواْ وَلَٰكِنَّ ٱللَّهَ يَفۡعَلُ مَا يُرِيدُ253
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَنفِقُواْ مِمَّا رَزَقۡنَٰكُم مِّن قَبۡلِ أَن يَأۡتِيَ يَوۡمࣱ لَّا بَيۡعࣱ فِيهِ وَلَا خُلَّةࣱ وَلَا شَفَٰعَةࣱۗ وَٱلۡكَٰفِرُونَ هُمُ ٱلظَّـٰلِمُونَ25400aاخره : ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا وَأَزۡوَٰجࣱ مُّطَهَّرَةࣱ وَرِضۡوَٰنࣱ مِّنَ ٱللَّهِۗ وَٱللَّهُ بَصِيرُۢ بِٱلۡعِبَادِ15
ٱلَّذِينَ يَقُولُونَ رَبَّنَآ إِنَّنَآ ءَامَنَّا فَٱغۡفِرۡ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ ٱلنَّارِ16
ٱلصَّـٰبِرِينَ وَٱلصَّـٰدِقِينَ وَٱلۡقَٰنِتِينَ وَٱلۡمُنفِقِينَ وَٱلۡمُسۡتَغۡفِرِينَ بِٱلۡأَسۡحَارِ17
شَهِدَ ٱللَّهُ أَنَّهُۥ لَآ إِلَٰهَ إِلَّا هُوَ وَٱلۡمَلَـٰٓئِكَةُ وَأُوْلُواْ ٱلۡعِلۡمِ قَآئِمَۢا بِٱلۡقِسۡطِۚ لَآ إِلَٰهَ إِلَّا هُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ18
إِنَّ ٱلدِّينَ عِندَ ٱللَّهِ ٱلۡإِسۡلَٰمُۗ وَمَا ٱخۡتَلَفَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَآءَهُمُ ٱلۡعِلۡمُ بَغۡيَۢا بَيۡنَهُمۡۗ وَمَن يَكۡفُرۡ بِـَٔايَٰتِ ٱللَّهِ فَإِنَّ ٱللَّهَ سَرِيعُ ٱلۡحِسَابِ1900aوقفية خادم حرم السيدة المعصومة الحاج محمد حسن بن المرحوم كربلايي اقا بابا لهذا المصحف الشريف على كافة المؤمنين بأرض قم المقدسة والتولية مع الواقف بتاريخ 1209هـ، ختمه بيضوي (رمضان علي شوكت التولية 1320)10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 183،cايرانgir00aاللغة : عربي.00aوقفية خادم حرم السيدة المعصومة الحاج محمد حسن بن المرحوم كربلايي اقا بابا لهذا المصحف الشريف على كافة المؤمنين بأرض قم المقدسة والتولية مع الواقف بتاريخ 1209هـ، ختمه بيضوي (رمضان علي شوكت التولية 1320) 4aقرانvمخطوطات.40uhttps://dromh.org/?view=d87c2da400aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03148ctm a2200325 i b254366261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254366-1396e50200aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1821 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a8 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَلَوۡلَآ أَن يَكُونَ ٱلنَّاسُ أُمَّةࣰ وَٰحِدَةࣰ لَّجَعَلۡنَا لِمَن يَكۡفُرُ بِٱلرَّحۡمَٰنِ لِبُيُوتِهِمۡ سُقُفࣰا مِّن فِضَّةࣲ وَمَعَارِجَ عَلَيۡهَا يَظۡهَرُونَ33
وَلِبُيُوتِهِمۡ أَبۡوَٰبࣰا وَسُرُرًا عَلَيۡهَا يَتَّكِـُٔونَ34
وَزُخۡرُفࣰاۚ وَإِن كُلُّ ذَٰلِكَ لَمَّا مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَٱلۡأٓخِرَةُ عِندَ رَبِّكَ لِلۡمُتَّقِينَ35
وَمَن يَعۡشُ عَن ذِكۡرِ ٱلرَّحۡمَٰنِ نُقَيِّضۡ لَهُۥ شَيۡطَٰنࣰا فَهُوَ لَهُۥ قَرِينࣱ36
وَإِنَّهُمۡ لَيَصُدُّونَهُمۡ عَنِ ٱلسَّبِيلِ وَيَحۡسَبُونَ أَنَّهُم مُّهۡتَدُونَ37
حَتَّىٰٓ إِذَا جَآءَنَا قَالَ يَٰلَيۡتَ بَيۡنِي وَبَيۡنَكَ بُعۡدَ ٱلۡمَشۡرِقَيۡنِ فَبِئۡسَ ٱلۡقَرِينُ38
وَلَن يَنفَعَكُمُ ٱلۡيَوۡمَ إِذ ظَّلَمۡتُمۡ أَنَّكُمۡ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ3900aاخره : يُسۡتَعۡتَبُونَ35
فَلِلَّهِ ٱلۡحَمۡدُ رَبِّ ٱلسَّمَٰوَٰتِ وَرَبِّ ٱلۡأَرۡضِ رَبِّ ٱلۡعَٰلَمِينَ36
وَلَهُ ٱلۡكِبۡرِيَآءُ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ3700aوقفية الحاج محمد بيك بن المرحوم ملا نوروز التبريزي على كافة الشيعة بتاريخ 1270هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 182،cايرانgir00aاللغة : عربي.00aوقفية الحاج محمد بيك بن المرحوم ملا نوروز التبريزي على كافة الشيعة بتاريخ 1270هـ 4aقرانvمخطوطات.40uhttps://dromh.org/?view=1396e50200aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02439ctm a2200325 i b254365261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254365-a5a1b9f700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1811 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a13 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : عَمَّ يَتَسَآءَلُونَ1
