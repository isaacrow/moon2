 = [القرن 17 م]00a230 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نستعليق.00aاوله : قَالَ الشّيخ الإمام الحَبْرُ الكامل علاء الدين عليّ بن أبي الحزم القرشيّ المتطبّب..قد رَتَّبتُ هذا الكتاب على أربعة فنون. (التّرتيبُ) وضعُ كُلِّ شيءٍ00aاخره : الترتيب المذكور إذا لم يحدث بسبب آخر بعين المرض ويضادّ الطبيعة ، ولا يرد على هذا الوجه من الإيرادات ما يرد على الوجه الأوّل00aمصحّحة ، عليها تعاليق ، أثّرت فيها الأُرضة ، وقد خُطّ على متن الموجز في الطبّ بالمداد الاحمر10aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق : 605،cالعراقgiq00aاللغة : عربي.00aمصحّحة ، عليها تعاليق ، أثّرت فيها الأُرضة ، وقد خُطّ على متن الموجز في الطبّ بالمداد الاحمر00aمصحّحة ، عليها تعاليق ، أثّرت فيها الأُرضة ، وقد خُطّ على متن الموجز في الطبّ بالمداد الاحمر 4aطبvمخطوطات.40uhttps://dromh.org/?view=1d37a97600aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق02866ctm a2200361 i b255091261016s18uu    xx            000 0 ara d00a(DROMH) dromh-255091-e3d2da4d00aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS6041 aالطباطبائي الكربلائي، علي بن محمد علي،dتوفي 1231 هجري،eمؤلف.10aرياض المسائل في بيان (تحقيق) الاحكام بالدلائل10aرياض المسائل في بيان (تحقيق) الاحكام بالدلائل = الشرح الكبير = شرح المختصر النافع = رياض المسائل وحياض الدلائل /cالطباطبائي الكربلائي، علي بن محمد علي (ت1231هـ).33aالشرح الكبير33aشرح المختصر النافع33aرياض المسائل وحياض الدلائل00cق13هـ = [القرن 19 م]00a288 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله ربّ العالمين ... كتاب الطهارة ، وأركانه أربعة : الأوّل : في المياه ، جمعه باعتبار تعدّد أفراده ، والمراد بها الأعمّ من الحقيقة والمجاز00aاخره : على قَدْر ما يُطيقون ، له أن يأخذهم به حتّى يُسْلموا ، فإنّ الله (تعالى) قال : « حَتّى يُعْطُوا الْجِزْيَةَ عَنْ يَدٍ وَهُمْ صَاغِرُونَ » ، وكيف يكون صاغراً وهو لا ...00aتحتوي هذه المخطوطة على أوّل كتاب الطهارة إلى مقدار الجزية من كتاب الحجّ، النسخة من عصر المؤلّف، مصحّحة ، عليها بعض التعاليق ، وكتب في آخرها :« قد تمّ ما وُجِد من الشرح »10aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق : 604،cالعراقgiq00aاللغة : عربي.00aتحتوي هذه المخطوطة على أوّل كتاب الطهارة إلى مقدار الجزية من كتاب الحجّ، النسخة من عصر المؤلّف، مصحّحة ، عليها بعض التعاليق ، وكتب في آخرها :« قد تمّ ما وُجِد من الشرح » 4aفقهvمخطوطات.40uhttps://dromh.org/?view=e3d2da4d00aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق02946ctm a2200349 i b255090261016s18uu    xx            000 0 ara d00a(DROMH) dromh-255090-9f3504b300aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS6031 aالمجلسي، محمد باقر بن محمد تقي،dتوفي 1110 هجري،eمؤلف.10aبحار الانوار الجامعة لدرر اخبار الائمة الاطهار (عليهم السلام)10aبحار الانوار الجامعة لدرر اخبار الائمة الاطهار (عليهم السلام) /cالمجلسي، محمد باقر بن محمد تقي (ت1110هـ).00cق13هـ = [القرن 19 م]00a229 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله الذي شيّد أساس الدين ونوّر مناهج اليقين بمحمّد سيّد المرسلين وعليٍّ أميرالمؤمنين ، والأبرار ومن عترتهما الغرّ الميامين ، صلوات الله00aاخره : (ناقص) حين ركب وصَفن ثيابه في سرجه . بيان : قال الجَزَريّ في ( النهاية ) : فيه أنّ عليّاً حين ركب وصفن ثيابه في سرجه ، أي جمعها فيه...00aاشتملت هذه المخطوطة على أوّل المجلّد التاسع إلى « باب مسابقته صلوات الله عليه في الهجرة على سائر الصحابة » ، وهو الباب السادس والستّون من نفس المجلّد،  نسخة مصحّحة جيّدة10aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق : 603،cالعراقgiq00aاللغة : عربي.00aاشتملت هذه المخطوطة على أوّل المجلّد التاسع إلى « باب مسابقته صلوات الله عليه في الهجرة على سائر الصحابة » ، وهو الباب السادس والستّون من نفس المجلّد،  نسخة مصحّحة جيّدة00aاشتملت هذه المخطوطة على أوّل المجلّد التاسع إلى « باب مسابقته صلوات الله عليه في الهجرة على سائر الصحابة » ، وهو الباب السادس والستّون من نفس المجلّد،  نسخة مصحّحة جيّدة00aالنسخة ناقصة الآخر. 4aحديثvمخطوطات.40uhttps://dromh.org/?view=9f3504b300aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق02976ctm a2200349 i b255089261016s1844    xx            000 0 ara d00a(DROMH) dromh-255089-525dcf0c00aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M36 184400c(300aMS6021 aالمجلسي، محمد باقر بن محمد تقي،dتوفي 1110 هجري،eمؤلف.10aبحار الانوار الجامعة لدرر اخبار الائمة الاطهار (عليهم السلام)10aبحار الانوار الجامعة لدرر اخبار الائمة الاطهار (عليهم السلام) /cالمجلسي، محمد باقر بن محمد تقي (ت1110هـ).00cالسبت 12شهر صفر سنة1260هـ = [1844]00a411 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله خالق الأرضين والسماوات وسامك المسموكات ، وداحي المدحوّات ، ومخرج عباده إلى النور من الظلمات00aاخره : عن محمّد بن الحسن الصفّار ، عن محمّد بن الحسين بن أبي الخطّاب ، عن محمّد بن سنان ، عن المفضّل ، عن أبي عبد الله (عليه‏ السلام) ، قال : قِوامُ الإنسان00aاشتملت هذه النسخة على أوّل المجلّد الرابع عشر إلى أوائل « باب ما به قوام بدن الإنسان وأجزائه ، وتشريح أعضائه ومنافعها وما يترتّب عليها من أحوال النفس » من نفس المجلّد، مصحّحة10aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق : 602،cالعراقgiq00aاللغة : عربي.00aاشتملت هذه النسخة على أوّل المجلّد الرابع عشر إلى أوائل « باب ما به قوام بدن الإنسان وأجزائه ، وتشريح أعضائه ومنافعها وما يترتّب عليها من أحوال النفس » من نفس المجلّد، مصحّحة00aاشتملت هذه النسخة على أوّل المجلّد الرابع عشر إلى أوائل « باب ما به قوام بدن الإنسان وأجزائه ، وتشريح أعضائه ومنافعها وما يترتّب عليها من أحوال النفس » من نفس المجلّد، مصحّحة 4aحديثvمخطوطات.10aأبو القاسم الاصفهاني،eناسخ.40uhttps://dromh.org/?view=525dcf0c00aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق03152ctm a2200373 i b255088261016s18uu    xx            000 0 ara d00a(DROMH) dromh-255088-e2fb7ab400aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M3600c(300aMS6011 aالطباطبائي الكربلائي، علي بن محمد علي،dتوفي 1231 هجري،eمؤلف.10aرياض المسائل في بيان (تحقيق) الاحكام بالدلائل10aرياض المسائل في بيان (تحقيق) الاحكام بالدلائل = الشرح الكبير = شرح المختصر النافع = رياض المسائل وحياض الدلائل /cالطباطبائي الكربلائي، علي بن محمد علي (ت1231هـ).33aالشرح الكبير33aشرح المختصر النافع33aرياض المسائل وحياض الدلائل00cق 13 هـ = [القرن 19 م]00a321 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الحمد لله ربّ العالمين...كتاب النكاح: هو في اللغة الوط‏ء ، على الأشهر، كما نُقل ، بل عليه الإجماع في ( المختلف ) ، وهو الظاهر من الجوهري كغيره00aاخره : (ناقص) لو لم يكن هو مراداً بتلك العبارة . ويُحتمل إرادتهما مطلقاً الضمان ، كما حمل الفاضل في ( المختلف ) عليه عبارة ( النهاية ) ، فقال : والشيخ...00aاشتملت على أوّل كتاب النكاح إلى آخر الكتاب، النسخة من عصر المؤلّف، مصحّحة ، عليها علامة البلاغ ، وبعض التعاليق بخطّ غير الناسخ ، عليها تاريخ 1270 هـ ، وهي ناقصة صفحةً واحدة10aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق : 601،cالعراقgiq00aاللغة : عربي.00aاشتملت على أوّل كتاب النكاح إلى آخر الكتاب، النسخة من عصر المؤلّف، مصحّحة ، عليها علامة البلاغ ، وبعض التعاليق بخطّ غير الناسخ ، عليها تاريخ 1270 هـ ، وهي ناقصة صفحةً واحدة00aاشتملت على أوّل كتاب النكاح إلى آخر الكتاب، النسخة من عصر المؤلّف، مصحّحة ، عليها علامة البلاغ ، وبعض التعاليق بخطّ غير الناسخ ، عليها تاريخ 1270 هـ ، وهي ناقصة صفحةً واحدة 4aفقهvمخطوطات.40uhttps://dromh.org/?view=e2fb7ab400aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق03455ctm a2200349 i b255087261016s12uu    xx            000 0 ara d00a(DROMH) dromh-255087-ec0e1b0400aIQ-KaCCSbaracIQ-KaCCSerda04aBP135b.M3600c(300aMS6001 aالبخاري، محمد بن إسماعيل،dتوفي 256 هجري،eمؤلف.10aالجامع الصحيح10aالجامع الصحيح = صحيح البخاري = صحيح بخاري /cالبخاري، محمد بن إسماعيل (ت 256هـ).33aصحيح البخاري33aصحيح بخاري00cق 7 هـ = [القرن 13 م]00a193 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسود واحمرdخط نسخ.00aاوله : كتاب البيوع ، باب ما جاء في قول الله عزّ وجلّ « وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا » ، وقوله : « إِلاَّ أَنْ تَكُونَ تِجَارَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ » ، باب ما جاء00aاخره : ينقلون ذلك الصخر وهم يرتجزون ورسول الله صلّى الله عليه وسلّم معهم ، يقولون: اللّهمّ إنّه لا خير إلّا خير الآخرة ** فانصر الأنصار والمهاجرة00aاشتملت على أوّل كتاب البيوع إلى باب هجرة النبي (صلى‏الله‏عليه‏و‏آله) من كتاب بدء الخَلق، مصحّحة عليها تعاليق ، وعليها بلاغات وقراءات عدّة في هوامش الصفحات كُتب فيها : « بلغ على الحافظ الشيخ أبي الحسن نور الدين الفتح السماحي الحنفي » ، و« بلغ على الأطفلي قراءةً » .. وغيرها غير واضحة ، وأُكملت الصفحة الأُولى والأخيرة وبعض الصفحات في وسطها بالخطّ المغربي ولكنّها حديثة ، وكُتبت الأبواب بالمداد الاحمر10aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق : 600،cالعراقgiq00aاللغة : عربي.00aاشتملت على أوّل كتاب البيوع إلى باب هجرة النبي (صلى‏الله‏عليه‏و‏آله) من كتاب بدء الخَلق، مصحّحة عليها تعاليق ، وعليها بلاغات وقراءات عدّة في هوامش الصفحات كُتب فيها : « بلغ على الحافظ الشيخ أبي الحسن نور الدين الفتح السماحي الحنفي » ، و« بلغ على الأطفلي قراءةً » .. وغيرها غير واضحة ، وأُكملت الصفحة الأُولى والأخيرة وبعض الصفحات في وسطها بالخطّ المغربي ولكنّها حديثة ، وكُتبت الأبواب بالمداد الاحمر 4aحديثvمخطوطات.40uhttps://dromh.org/?view=ec0e1b0400aمكتبة العتبة العباسية المقدسة (ج2) في كربلاء المقدسة - العراق03071ctm a2200361 i b255086261016s1834    xx            000 0 ara d00a(DROMH) dromh-255086-5e832fd100aIQ-KaCCSbaracIQ-KaCCSerda04aBP144b.M36 183400c(300aMS5991 aالشهيد الثاني، زين الدين بن علي،dتوفي 965 هجري،eمؤلف.10aالروضة البهية في شرح اللمعة الدمشقية10aالروضة البهية في شرح اللمعة الدمشقية /cالشهيد الثاني، زين الدين بن علي (ت965هـ).00c1250 هـ = [1834]00a264 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) ...المساواة بين ال