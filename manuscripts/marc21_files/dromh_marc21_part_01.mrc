إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ3500aاخره : وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةࣰۙ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنࣰاۙ وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَۙ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضࣱ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلࣰاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ31
كَلَّا وَٱلۡقَمَرِ32
وَٱلَّيۡلِ إِذۡ أَدۡبَرَ33
وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ34
إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ3510aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 107،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=f443f18b00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران05013ctm a2200349 i b254289261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254289-6dcba88000aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1061 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) ٱلَّذِينَ أُخۡرِجُواْ مِن دِيَٰرِهِم بِغَيۡرِ حَقٍّ إِلَّآ أَن يَقُولُواْ رَبُّنَا ٱللَّهُۗ وَلَوۡلَا دَفۡعُ ٱللَّهِ ٱلنَّاسَ بَعۡضَهُم بِبَعۡضࣲ لَّهُدِّمَتۡ صَوَٰمِعُ وَبِيَعࣱ وَصَلَوَٰتࣱ وَمَسَٰجِدُ يُذۡكَرُ فِيهَا ٱسۡمُ ٱللَّهِ كَثِيرࣰاۗ وَلَيَنصُرَنَّ ٱللَّهُ مَن يَنصُرُهُۥٓۚ إِنَّ ٱللَّهَ لَقَوِيٌّ عَزِيزٌ40
ٱلَّذِينَ إِن مَّكَّنَّـٰهُمۡ فِي ٱلۡأَرۡضِ أَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ وَأَمَرُواْ بِٱلۡمَعۡرُوفِ وَنَهَوۡاْ عَنِ ٱلۡمُنكَرِۗ وَلِلَّهِ عَٰقِبَةُ ٱلۡأُمُورِ41
وَإِن يُكَذِّبُوكَ فَقَدۡ كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحࣲ وَعَادࣱ وَثَمُودُ42
وَقَوۡمُ إِبۡرَٰهِيمَ وَقَوۡمُ لُوطࣲ4300aاخره : يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡۚ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ76
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱرۡكَعُواْ وَٱسۡجُدُواْۤ وَٱعۡبُدُواْ رَبَّكُمۡ وَٱفۡعَلُواْ ٱلۡخَيۡرَ لَعَلَّكُمۡ تُفۡلِحُونَ77
وَجَٰهِدُواْ فِي ٱللَّهِ حَقَّ جِهَادِهِۦۚ هُوَ ٱجۡتَبَىٰكُمۡ وَمَا جَعَلَ عَلَيۡكُمۡ فِي ٱلدِّينِ مِنۡ حَرَجࣲۚ مِّلَّةَ أَبِيكُمۡ إِبۡرَٰهِيمَۚ هُوَ سَمَّىٰكُمُ ٱلۡمُسۡلِمِينَ مِن قَبۡلُ وَفِي هَٰذَا لِيَكُونَ ٱلرَّسُولُ شَهِيدًا عَلَيۡكُمۡ وَتَكُونُواْ شُهَدَآءَ عَلَى ٱلنَّاسِۚ فَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ وَٱعۡتَصِمُواْ بِٱللَّهِ هُوَ مَوۡلَىٰكُمۡۖ فَنِعۡمَ ٱلۡمَوۡلَىٰ وَنِعۡمَ ٱلنَّصِيرُ7800aحزب 68 ، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 106،cايرانgir00aاللغة : عربي.00aحزب 68 ، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=6dcba88000aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03015ctm a2200325 i b254288261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254288-896651fe00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1051 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a17 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) لَّقَدۡ أَضَلَّنِي عَنِ ٱلذِّكۡرِ بَعۡدَ إِذۡ جَآءَنِيۗ وَكَانَ ٱلشَّيۡطَٰنُ لِلۡإِنسَٰنِ خَذُولࣰا29
وَقَالَ ٱلرَّسُولُ يَٰرَبِّ إِنَّ قَوۡمِي ٱتَّخَذُواْ هَٰذَا ٱلۡقُرۡءَانَ مَهۡجُورࣰا30
وَكَذَٰلِكَ جَعَلۡنَا لِكُلِّ نَبِيٍّ عَدُوࣰّا مِّنَ ٱلۡمُجۡرِمِينَۗ وَكَفَىٰ بِرَبِّكَ هَادِيࣰا وَنَصِيرࣰا31
وَقَالَ ٱلَّذِينَ كَفَرُواْ لَوۡلَا نُزِّلَ عَلَيۡهِ ٱلۡقُرۡءَانُ جُمۡلَةࣰ وَٰحِدَةࣰۚ كَذَٰلِكَ لِنُثَبِّتَ بِهِۦ فُؤَادَكَۖ وَرَتَّلۡنَٰهُ تَرۡتِيلࣰا3200aاخره : رَهۡطࣲ يُفۡسِدُونَ فِي ٱلۡأَرۡضِ وَلَا يُصۡلِحُونَ48
قَالُواْ تَقَاسَمُواْ بِٱللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهۡلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ مَا شَهِدۡنَا مَهۡلِكَ أَهۡلِهِۦ وَإِنَّا لَصَٰدِقُونَ49
وَمَكَرُواْ مَكۡرࣰا وَمَكَرۡنَا مَكۡرࣰا وَهُمۡ لَا يَشۡعُرُونَ50
فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ مَكۡرِهِمۡ أَنَّا دَمَّرۡنَٰهُمۡ وَقَوۡمَهُمۡ أَجۡمَعِينَ51
فَتِلۡكَ بُيُوتُهُمۡ خَاوِيَةَۢ بِمَا ظَلَمُوٓاْۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰ لِّقَوۡمࣲ يَعۡلَمُونَ5210aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 105،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.10aمحمد تقي ابن شرف علي،eناسخ.40uhttps://dromh.org/?view=896651fe00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03059ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001600365336003800381337003500419338002900454340004300483500082100526500106001347535011402407546002702521583004002548650003002588856003702618949009002655b254287261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254287-88a59ac800aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1041 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a14 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) وَإِذَا رَءَاكَ ٱلَّذِينَ كَفَرُوٓاْ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِي يَذۡكُرُ ءَالِهَتَكُمۡ وَهُم بِذِكۡرِ ٱلرَّحۡمَٰنِ هُمۡ كَٰفِرُونَ36
خُلِقَ ٱلۡإِنسَٰنُ مِنۡ عَجَلࣲۚ سَأُوْرِيكُمۡ ءَايَٰتِي فَلَا تَسۡتَعۡجِلُونِ37
وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ38
لَوۡ يَعۡلَمُ ٱلَّذِينَ كَفَرُواْ حِينَ لَا يَكُفُّونَ عَن وُجُوهِهِمُ ٱلنَّارَ وَلَا عَن ظُهُورِهِمۡ وَلَا هُمۡ يُنصَرُونَ3900aاخره : (ناقص) وَإِذَا تُتۡلَىٰ عَلَيۡهِمۡ ءَايَٰتُنَا بَيِّنَٰتࣲ تَعۡرِفُ فِي وُجُوهِ ٱلَّذِينَ كَفَرُواْ ٱلۡمُنكَرَۖ يَكَادُونَ يَسۡطُونَ بِٱلَّذِينَ يَتۡلُونَ عَلَيۡهِمۡ ءَايَٰتِنَاۗ قُلۡ أَفَأُنَبِّئُكُم بِشَرࣲّ مِّن ذَٰلِكُمُۚ ٱلنَّارُ وَعَدَهَا ٱللَّهُ ٱلَّذِينَ كَفَرُواْۖ وَبِئۡسَ ٱلۡمَصِيرُ72
يَـٰٓأَيُّهَا ٱلنَّاسُ ضُرِبَ مَثَلࣱ فَٱسۡتَمِعُواْ لَهُۥٓۚ إِنَّ ٱلَّذِينَ تَدۡعُونَ مِن دُونِ ٱللَّهِ لَن يَخۡلُقُواْ ذُبَابࣰا وَلَوِ ٱجۡتَمَعُواْ لَهُۥۖ وَإِن يَسۡلُبۡهُمُ ٱلذُّبَابُ شَيۡـࣰٔا لَّا يَسۡتَنقِذُوهُ مِنۡهُۚ ضَعُفَ ٱلطَّالِبُ وَٱلۡمَطۡلُوبُ7310aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 104،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=88a59ac800aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03383ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001600365336003800381337003500419338002900454340004300483500090100526500130401427535011402731546002702845583004002872650003002912856003702942949009002979b254286261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254286-01d1d86f00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1031 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a14 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) كَدَأۡبِ ءَالِ فِرۡعَوۡنَۙ وَٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَذَّبُواْ بِـَٔايَٰتِ رَبِّهِمۡ فَأَهۡلَكۡنَٰهُم بِذُنُوبِهِمۡ وَأَغۡرَقۡنَآ ءَالَ فِرۡعَوۡنَۚ وَكُلࣱّ كَانُواْ ظَٰلِمِينَ54
إِنَّ شَرَّ ٱلدَّوَآبِّ عِندَ ٱللَّهِ ٱلَّذِينَ كَفَرُواْ فَهُمۡ لَا يُؤۡمِنُونَ55
ٱلَّذِينَ عَٰهَدتَّ مِنۡهُمۡ ثُمَّ يَنقُضُونَ عَهۡدَهُمۡ فِي كُلِّ مَرَّةࣲ وَهُمۡ لَا يَتَّقُونَ56
فَإِمَّا تَثۡقَفَنَّهُمۡ فِي ٱلۡحَرۡبِ فَشَرِّدۡ بِهِم مَّنۡ خَلۡفَهُمۡ لَعَلَّهُمۡ يَذَّكَّرُونَ5700aاخره : (ناقص) لَّيۡسَ عَلَى ٱلۡأَعۡمَىٰ حَرَجࣱ وَلَا عَلَى ٱلۡأَعۡرَجِ حَرَجࣱ وَلَا عَلَى ٱلۡمَرِيضِ حَرَجࣱ وَلَا عَلَىٰٓ أَنفُسِكُمۡ أَن تَأۡكُلُواْ مِنۢ بُيُوتِكُمۡ أَوۡ بُيُوتِ ءَابَآئِكُمۡ أَوۡ بُيُوتِ أُمَّهَٰتِكُمۡ أَوۡ بُيُوتِ إِخۡوَٰنِكُمۡ أَوۡ بُيُوتِ أَخَوَٰتِكُمۡ أَوۡ بُيُوتِ أَعۡمَٰمِكُمۡ أَوۡ بُيُوتِ عَمَّـٰتِكُمۡ أَوۡ بُيُوتِ أَخۡوَٰلِكُمۡ أَوۡ بُيُوتِ خَٰلَٰتِكُمۡ أَوۡ مَا مَلَكۡتُم مَّفَاتِحَهُۥٓ أَوۡ صَدِيقِكُمۡۚ لَيۡسَ عَلَيۡكُمۡ جُنَاحٌ أَن تَأۡكُلُواْ جَمِيعًا أَوۡ أَشۡتَاتࣰاۚ فَإِذَا دَخَلۡتُم بُيُوتࣰا فَسَلِّمُواْ عَلَىٰٓ أَنفُسِكُمۡ تَحِيَّةࣰ مِّنۡ عِندِ ٱللَّهِ مُبَٰرَكَةࣰ طَيِّبَةࣰۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِ لَعَلَّكُمۡ تَعۡقِلُونَ6110aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 103،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=01d1d86f00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03456ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001600365336003800381337003500419338002900454340004300483500120400526500107401730535011402804546002702918583004002945650003002985856003703015949009003052b254285261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254285-e324f9cc00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1021 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a17 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص)  ٱلصُّدُورِ43
وَإِذۡ يُرِيكُمُوهُمۡ إِذِ ٱلۡتَقَيۡتُمۡ فِيٓ أَعۡيُنِكُمۡ قَلِيلࣰا وَيُقَلِّلُكُمۡ فِيٓ أَعۡيُنِهِمۡ لِيَقۡضِيَ ٱللَّهُ أَمۡرࣰا كَانَ مَفۡعُولࣰاۗ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ44
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا لَقِيتُمۡ فِئَةࣰ فَٱثۡبُتُواْ وَٱذۡكُرُواْ ٱللَّهَ كَثِيرࣰا لَّعَلَّكُمۡ تُفۡلِحُونَ45
وَأَطِيعُواْ ٱللَّهَ وَرَسُولَهُۥ وَلَا تَنَٰزَعُواْ فَتَفۡشَلُواْ وَتَذۡهَبَ رِيحُكُمۡۖ وَٱصۡبِرُوٓاْۚ إِنَّ ٱللَّهَ مَعَ ٱلصَّـٰبِرِينَ46
وَلَا تَكُونُواْ كَٱلَّذِينَ خَرَجُواْ مِن دِيَٰرِهِم بَطَرࣰا وَرِئَآءَ ٱلنَّاسِ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِۚ وَٱللَّهُ بِمَا يَعۡمَلُونَ مُحِيطࣱ4700aاخره : (ناقص) إِن تَجۡتَنِبُواْ كَبَآئِرَ مَا تُنۡهَوۡنَ عَنۡهُ نُكَفِّرۡ عَنكُمۡ سَيِّـَٔاتِكُمۡ وَنُدۡخِلۡكُم مُّدۡخَلࣰا كَرِيمࣰا31
وَلَا تَتَمَنَّوۡاْ مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعۡضَكُمۡ عَلَىٰ بَعۡضࣲۚ لِّلرِّجَالِ نَصِيبࣱ مِّمَّا ٱكۡتَسَبُواْۖ وَلِلنِّسَآءِ نَصِيبࣱ مِّمَّا ٱكۡتَسَبۡنَۚ وَسۡـَٔلُواْ ٱللَّهَ مِن فَضۡلِهِۦٓۚ إِنَّ ٱللَّهَ كَانَ بِكُلِّ شَيۡءٍ عَلِيمࣰا32
وَلِكُلࣲّ جَعَلۡنَا مَوَٰلِيَ مِمَّا تَرَكَ ٱلۡوَٰلِدَانِ وَٱلۡأَقۡرَبُونَۚ وَٱلَّذِينَ عَقَدَتۡ أَيۡمَٰنُكُمۡ فَـَٔاتُوهُمۡ نَصِيبَهُمۡۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَيۡءࣲ شَهِيدًا3310aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 102،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=e324f9cc00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03732ctm a2200337 i b254284261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254284-babf71d300aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1011 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a12 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) وَمَآ أُبَرِّئُ نَفۡسِيٓۚ إِنَّ ٱلنَّفۡسَ لَأَمَّارَةُۢ بِٱلسُّوٓءِ إِلَّا مَا رَحِمَ رَبِّيٓۚ إِنَّ رَبِّي غَفُورࣱ رَّحِيمࣱ53
وَقَالَ ٱلۡمَلِكُ ٱئۡتُونِي بِهِۦٓ أَسۡتَخۡلِصۡهُ لِنَفۡسِيۖ فَلَمَّا كَلَّمَهُۥ قَالَ إِنَّكَ ٱلۡيَوۡمَ لَدَيۡنَا مَكِينٌ أَمِينࣱ54
قَالَ ٱجۡعَلۡنِي عَلَىٰ خَزَآئِنِ ٱلۡأَرۡضِۖ إِنِّي حَفِيظٌ عَلِيمࣱ55
وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِي ٱلۡأَرۡضِ يَتَبَوَّأُ مِنۡهَا حَيۡثُ يَشَآءُۚ نُصِيبُ بِرَحۡمَتِنَا مَن نَّشَآءُۖ وَلَا نُضِيعُ أَجۡرَ ٱلۡمُحۡسِنِينَ5600aاخره : (ناقص) رَّبَّنَآ إِنِّيٓ أَسۡكَنتُ مِن ذُرِّيَّتِي بِوَادٍ غَيۡرِ ذِي زَرۡعٍ عِندَ بَيۡتِكَ ٱلۡمُحَرَّمِ رَبَّنَا لِيُقِيمُواْ ٱلصَّلَوٰةَ فَٱجۡعَلۡ أَفۡـِٔدَةࣰ مِّنَ ٱلنَّاسِ تَهۡوِيٓ إِلَيۡهِمۡ وَٱرۡزُقۡهُم مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمۡ يَشۡكُرُونَ37
رَبَّنَآ إِنَّكَ تَعۡلَمُ مَا نُخۡفِي وَمَا نُعۡلِنُۗ وَمَا يَخۡفَىٰ عَلَى ٱللَّهِ مِن شَيۡءࣲ فِي ٱلۡأَرۡضِ وَلَا فِي ٱلسَّمَآءِ38
ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي وَهَبَ لِي عَلَى ٱلۡكِبَرِ إِسۡمَٰعِيلَ وَإِسۡحَٰقَۚ إِنَّ رَبِّي لَسَمِيعُ ٱلدُّعَآءِ39
رَبِّ ٱجۡعَلۡنِي مُقِيمَ ٱلصَّلَوٰةِ وَمِن ذُرِّيَّتِيۚ رَبَّنَا وَتَقَبَّلۡ دُعَآءِ4000aوقف صحيح شرعي وحبس موبدعلى  طالب..زائر المعصومين كربلائي مهدي ..كه از براي مهدي هادي ثواب انرا بروح مرحوم فرستاده نمايد..1287هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 101،cايرانgir00aاللغة : عربي.00aوقف صحيح شرعي وحبس موبدعلى  طالب..زائر المعصومين كربلائي مهدي ..كه از براي مهدي هادي ثواب انرا بروح مرحوم فرستاده نمايد..1287هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=babf71d300aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04421ctm a2200337 i b254283261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254283-b131281c00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1001 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a6 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : أَتَىٰٓ أَمۡرُ ٱللَّهِ فَلَا تَسۡتَعۡجِلُوهُۚ سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ1
يُنَزِّلُ ٱلۡمَلَـٰٓئِكَةَ بِٱلرُّوحِ مِنۡ أَمۡرِهِۦ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦٓ أَنۡ أَنذِرُوٓاْ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱتَّقُونِ2
خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۚ تَعَٰلَىٰ عَمَّا يُشۡرِكُونَ3
خَلَقَ ٱلۡإِنسَٰنَ مِن نُّطۡفَةࣲ فَإِذَا هُوَ خَصِيمࣱ مُّبِينࣱ4
وَٱلۡأَنۡعَٰمَ خَلَقَهَاۖ لَكُمۡ فِيهَا دِفۡءࣱ وَمَنَٰفِعُ وَمِنۡهَا تَأۡكُلُونَ500aاخره : مِنۡ حَيۡثُ لَا يَشۡعُرُونَ45
أَوۡ يَأۡخُذَهُمۡ فِي تَقَلُّبِهِمۡ فَمَا هُم بِمُعۡجِزِينَ46
أَوۡ يَأۡخُذَهُمۡ عَلَىٰ تَخَوُّفࣲ فَإِنَّ رَبَّكُمۡ لَرَءُوفࣱ رَّحِيمٌ47
أَوَلَمۡ يَرَوۡاْ إِلَىٰ مَا خَلَقَ ٱللَّهُ مِن شَيۡءࣲ يَتَفَيَّؤُاْ ظِلَٰلُهُۥ عَنِ ٱلۡيَمِينِ وَٱلشَّمَآئِلِ سُجَّدࣰا لِّلَّهِ وَهُمۡ دَٰخِرُونَ48
وَلِلَّهِۤ يَسۡجُدُۤ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ مِن دَآبَّةࣲ وَٱلۡمَلَـٰٓئِكَةُ وَهُمۡ لَا يَسۡتَكۡبِرُونَ49
يَخَافُونَ رَبَّهُم مِّن فَوۡقِهِمۡ وَيَفۡعَلُونَ مَا يُؤۡمَرُونَ5000aحزب 54،وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 100،cايرانgir00aاللغة : عربي.00aحزب 54،وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=b131281c00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04185ctm a2200337 i b254282261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254282-122c233000aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS991 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a5 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : يَـٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُواْ رَبَّكُمۡۚ إِنَّ زَلۡزَلَةَ ٱلسَّاعَةِ شَيۡءٌ عَظِيمࣱ1
يَوۡمَ تَرَوۡنَهَا تَذۡهَلُ كُلُّ مُرۡضِعَةٍ عَمَّآ أَرۡضَعَتۡ وَتَضَعُ كُلُّ ذَاتِ حَمۡلٍ حَمۡلَهَا وَتَرَى ٱلنَّاسَ سُكَٰرَىٰ وَمَا هُم بِسُكَٰرَىٰ وَلَٰكِنَّ عَذَابَ ٱللَّهِ شَدِيدࣱ2
وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمࣲ وَيَتَّبِعُ كُلَّ شَيۡطَٰنࣲ مَّرِيدࣲ3
كُتِبَ عَلَيۡهِ أَنَّهُۥ مَن تَوَلَّاهُ فَأَنَّهُۥ يُضِلُّهُۥ وَيَهۡدِيهِ إِلَىٰ عَذَابِ ٱلسَّعِيرِ400aاخره : لَن يَنَالَ ٱللَّهَ لُحُومُهَا وَلَا دِمَآؤُهَا وَلَٰكِن يَنَالُهُ ٱلتَّقۡوَىٰ مِنكُمۡۚ كَذَٰلِكَ سَخَّرَهَا لَكُمۡ لِتُكَبِّرُواْ ٱللَّهَ عَلَىٰ مَا هَدَىٰكُمۡۗ وَبَشِّرِ ٱلۡمُحۡسِنِينَ37
إِنَّ ٱللَّهَ يُدَٰفِعُ عَنِ ٱلَّذِينَ ءَامَنُوٓاْۗ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ خَوَّانࣲ كَفُورٍ38
أُذِنَ لِلَّذِينَ يُقَٰتَلُونَ بِأَنَّهُمۡ ظُلِمُواْۚ وَإِنَّ ٱللَّهَ عَلَىٰ نَصۡرِهِمۡ لَقَدِيرٌ3900aوردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 99،cايرانgir00aاللغة : عربي.00aوردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=122c233000aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04618ctm a2200337 i b254281261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254281-5027378400aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS981 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a6 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَمَن يُسۡلِمۡ وَجۡهَهُۥٓ إِلَى ٱللَّهِ وَهُوَ مُحۡسِنࣱ فَقَدِ ٱسۡتَمۡسَكَ بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰۗ وَإِلَى ٱللَّهِ عَٰقِبَةُ ٱلۡأُمُورِ22
وَمَن كَفَرَ فَلَا يَحۡزُنكَ كُفۡرُهُۥٓۚ إِلَيۡنَا مَرۡجِعُهُمۡ فَنُنَبِّئُهُم بِمَا عَمِلُوٓاْۚ إِنَّ ٱللَّهَ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ23
نُمَتِّعُهُمۡ قَلِيلࣰا ثُمَّ نَضۡطَرُّهُمۡ إِلَىٰ عَذَابٍ غَلِيظࣲ24
وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ ٱللَّهُۚ قُلِ ٱلۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ25
لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ إِنَّ ٱللَّهَ هُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ2600aاخره : أَوَلَمۡ يَهۡدِ لَهُمۡ كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّنَ ٱلۡقُرُونِ يَمۡشُونَ فِي مَسَٰكِنِهِمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٍۚ أَفَلَا يَسۡمَعُونَ26
أَوَلَمۡ يَرَوۡاْ أَنَّا نَسُوقُ ٱلۡمَآءَ إِلَى ٱلۡأَرۡضِ ٱلۡجُرُزِ فَنُخۡرِجُ بِهِۦ زَرۡعࣰا تَأۡكُلُ مِنۡهُ أَنۡعَٰمُهُمۡ وَأَنفُسُهُمۡۚ أَفَلَا يُبۡصِرُونَ27
وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡفَتۡحُ إِن كُنتُمۡ صَٰدِقِينَ28
قُلۡ يَوۡمَ ٱلۡفَتۡحِ لَا يَنفَعُ ٱلَّذِينَ كَفَرُوٓاْ إِيمَٰنُهُمۡ وَلَا هُمۡ يُنظَرُونَ29
فَأَعۡرِضۡ عَنۡهُمۡ وَٱنتَظِرۡ إِنَّهُم مُّنتَظِرُونَ3000aوردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 98،cايرانgir00aاللغة : عربي.00aوردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=5027378400aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04550ctm a2200337 i b254280261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254280-baf2413700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS971 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a5 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : أَفَحُكۡمَ ٱلۡجَٰهِلِيَّةِ يَبۡغُونَۚ وَمَنۡ أَحۡسَنُ مِنَ ٱللَّهِ حُكۡمࣰا لِّقَوۡمࣲ يُوقِنُونَ50
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُواْ ٱلۡيَهُودَ وَٱلنَّصَٰرَىٰٓ أَوۡلِيَآءَۘ بَعۡضُهُمۡ أَوۡلِيَآءُ بَعۡضࣲۚ وَمَن يَتَوَلَّهُم مِّنكُمۡ فَإِنَّهُۥ مِنۡهُمۡۗ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّـٰلِمِينَ51
فَتَرَى ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضࣱ يُسَٰرِعُونَ فِيهِمۡ يَقُولُونَ نَخۡشَىٰٓ أَن تُصِيبَنَا دَآئِرَةࣱۚ فَعَسَى ٱللَّهُ أَن يَأۡتِيَ بِٱلۡفَتۡحِ أَوۡ أَمۡرࣲ مِّنۡ عِندِهِۦ فَيُصۡبِحُواْ عَلَىٰ مَآ أَسَرُّواْ فِيٓ أَنفُسِهِمۡ نَٰدِمِينَ5200aاخره : لَتَجِدَنَّ أَشَدَّ ٱلنَّاسِ عَدَٰوَةࣰ لِّلَّذِينَ ءَامَنُواْ ٱلۡيَهُودَ وَٱلَّذِينَ أَشۡرَكُواْۖ وَلَتَجِدَنَّ أَقۡرَبَهُم مَّوَدَّةࣰ لِّلَّذِينَ ءَامَنُواْ ٱلَّذِينَ قَالُوٓاْ إِنَّا نَصَٰرَىٰۚ ذَٰلِكَ بِأَنَّ مِنۡهُمۡ قِسِّيسِينَ وَرُهۡبَانࣰا وَأَنَّهُمۡ لَا يَسۡتَكۡبِرُونَ82
وَإِذَا سَمِعُواْ مَآ أُنزِلَ إِلَى ٱلرَّسُولِ تَرَىٰٓ أَعۡيُنَهُمۡ تَفِيضُ مِنَ ٱلدَّمۡعِ مِمَّا عَرَفُواْ مِنَ ٱلۡحَقِّۖ يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱكۡتُبۡنَا مَعَ ٱلشَّـٰهِدِينَ8300aحزب 83،وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 97،cايرانgir00aاللغة : عربي.00aحزب 83،وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=baf2413700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03978ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001600364336003800380337003500418338002900453340004300482500162900525500117302154535011303327546002703440583004003467650003003507856003703537949009003574b254279261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254279-f909aa0500aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS961 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a63 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص)هُوَ خَيۡرࣰا لَّهُمۖ بَلۡ هُوَ شَرࣱّ لَّهُمۡۖ سَيُطَوَّقُونَ مَا بَخِلُواْ بِهِۦ يَوۡمَ ٱلۡقِيَٰمَةِۗ وَلِلَّهِ مِيرَٰثُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرࣱ180
لَّقَدۡ سَمِعَ ٱللَّهُ قَوۡلَ ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ فَقِيرࣱ وَنَحۡنُ أَغۡنِيَآءُۘ سَنَكۡتُبُ مَا قَالُواْ وَقَتۡلَهُمُ ٱلۡأَنۢبِيَآءَ بِغَيۡرِ حَقࣲّ وَنَقُولُ ذُوقُواْ عَذَابَ ٱلۡحَرِيقِ181
ذَٰلِكَ بِمَا قَدَّمَتۡ أَيۡدِيكُمۡ وَأَنَّ ٱللَّهَ لَيۡسَ بِظَلَّامࣲ لِّلۡعَبِيدِ182
ٱلَّذِينَ قَالُوٓاْ إِنَّ ٱللَّهَ عَهِدَ إِلَيۡنَآ أَلَّا نُؤۡمِنَ لِرَسُولٍ حَتَّىٰ يَأۡتِيَنَا بِقُرۡبَانࣲ تَأۡكُلُهُ ٱلنَّارُۗ قُلۡ قَدۡ جَآءَكُمۡ رُسُلࣱ مِّن قَبۡلِي بِٱلۡبَيِّنَٰتِ وَبِٱلَّذِي قُلۡتُمۡ فَلِمَ قَتَلۡتُمُوهُمۡ إِن كُنتُمۡ صَٰدِقِينَ183
فَإِن كَذَّبُوكَ فَقَدۡ كُذِّبَ رُسُلࣱ مِّن قَبۡلِكَ جَآءُو بِٱلۡبَيِّنَٰتِ وَٱلزُّبُرِ وَٱلۡكِتَٰبِ ٱلۡمُنِيرِ18400aاخره : (ناقص) وَلَا تَدۡعُ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكَ وَلَا يَضُرُّكَۖ فَإِن فَعَلۡتَ فَإِنَّكَ إِذࣰا مِّنَ ٱلظَّـٰلِمِينَ106
وَإِن يَمۡسَسۡكَ ٱللَّهُ بِضُرࣲّ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَۖ وَإِن يُرِدۡكَ بِخَيۡرࣲ فَلَا رَآدَّ لِفَضۡلِهِۦۚ يُصِيبُ بِهِۦ مَن يَشَآءُ مِنۡ عِبَادِهِۦۚ وَهُوَ ٱلۡغَفُورُ ٱلرَّحِيمُ107
قُلۡ يَـٰٓأَيُّهَا ٱلنَّاسُ قَدۡ جَآءَكُمُ ٱلۡحَقُّ مِن رَّبِّكُمۡۖ فَمَنِ ٱهۡتَدَىٰ فَإِنَّمَا يَهۡتَدِي لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيۡهَاۖ وَمَآ أَنَا۠ عَلَيۡكُم بِوَكِيلࣲ108
وَٱتَّبِعۡ مَا يُوحَىٰٓ إِلَيۡكَ وَٱصۡبِرۡ حَتَّىٰ يَحۡكُمَ ٱللَّهُۚ وَهُوَ خَيۡرُ ٱلۡحَٰكِمِينَ10910aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 96،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=f909aa0500aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03282ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500139100524500071601915535011302631546002702744583004002771650003002811856003702841949009002878b254278261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254278-bfb2168c00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS951 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) فَأَكَلَا مِنۡهَا فَبَدَتۡ لَهُمَا سَوۡءَٰتُهُمَا وَطَفِقَا يَخۡصِفَانِ عَلَيۡهِمَا مِن وَرَقِ ٱلۡجَنَّةِۚ وَعَصَىٰٓ ءَادَمُ رَبَّهُۥ فَغَوَىٰ121
ثُمَّ ٱجۡتَبَٰهُ رَبُّهُۥ فَتَابَ عَلَيۡهِ وَهَدَىٰ122
قَالَ ٱهۡبِطَا مِنۡهَا جَمِيعَۢاۖ بَعۡضُكُمۡ لِبَعۡضٍ عَدُوࣱّۖ فَإِمَّا يَأۡتِيَنَّكُم مِّنِّي هُدࣰى فَمَنِ ٱتَّبَعَ هُدَايَ فَلَا يَضِلُّ وَلَا يَشۡقَىٰ123
وَمَنۡ أَعۡرَضَ عَن ذِكۡرِي فَإِنَّ لَهُۥ مَعِيشَةࣰ ضَنكࣰا وَنَحۡشُرُهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ أَعۡمَىٰ124
قَالَ رَبِّ لِمَ حَشَرۡتَنِيٓ أَعۡمَىٰ وَقَدۡ كُنتُ بَصِيرࣰا125
قَالَ كَذَٰلِكَ أَتَتۡكَ ءَايَٰتُنَا فَنَسِيتَهَاۖ وَكَذَٰلِكَ ٱلۡيَوۡمَ تُنسَىٰ126
وَكَذَٰلِكَ نَجۡزِي مَنۡ أَسۡرَفَ وَلَمۡ يُؤۡمِنۢ بِـَٔايَٰتِ رَبِّهِۦۚ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَشَدُّ وَأَبۡقَىٰٓ12700aاخره : وَٱلَّتِيٓ أَحۡصَنَتۡ فَرۡجَهَا فَنَفَخۡنَا فِيهَا مِن رُّوحِنَا وَجَعَلۡنَٰهَا وَٱبۡنَهَآ ءَايَةࣰ لِّلۡعَٰلَمِينَ91
إِنَّ هَٰذِهِۦٓ أُمَّتُكُمۡ أُمَّةࣰ وَٰحِدَةࣰ وَأَنَا۠ رَبُّكُمۡ فَٱعۡبُدُونِ92
وَتَقَطَّعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡۖ كُلٌّ إِلَيۡنَا رَٰجِعُونَ93
فَمَن يَعۡمَلۡ مِنَ ٱلصَّـٰلِحَٰتِ وَهُوَ مُؤۡمِنࣱ فَلَا كُفۡرَانَ لِسَعۡيِهِۦ وَإِنَّا لَهُۥ كَٰتِبُونَ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 95،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=bfb2168c00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03189ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500085000524500116401374535011302538546002702651583004002678650003002718856003702748949009002785b254277261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254277-29ecffa100aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS941 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) ءَأَتَّخِذُ مِن دُونِهِۦٓ ءَالِهَةً إِن يُرِدۡنِ ٱلرَّحۡمَٰنُ بِضُرࣲّ لَّا تُغۡنِ عَنِّي شَفَٰعَتُهُمۡ شَيۡـࣰٔا وَلَا يُنقِذُونِ23
إِنِّيٓ إِذࣰا لَّفِي ضَلَٰلࣲ مُّبِينٍ24
إِنِّيٓ ءَامَنتُ بِرَبِّكُمۡ فَٱسۡمَعُونِ25
قِيلَ ٱدۡخُلِ ٱلۡجَنَّةَۖ قَالَ يَٰلَيۡتَ قَوۡمِي يَعۡلَمُونَ26
بِمَا غَفَرَ لِي رَبِّي وَجَعَلَنِي مِنَ ٱلۡمُكۡرَمِينَ27
وَمَآ أَنزَلۡنَا عَلَىٰ قَوۡمِهِۦ مِنۢ بَعۡدِهِۦ مِن جُندࣲ مِّنَ ٱلسَّمَآءِ وَمَا كُنَّا مُنزِلِينَ2800aاخره : وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ114
وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ115
وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ116
وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ117
وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ118
وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ119
سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ120
إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ121
إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ122
وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ123
إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ124
أَتَدۡعُونَ بَعۡلࣰا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ125
ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ12610aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 94،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=29ecffa100aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03086ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500110200524500086101626535011302487546002702600650003002627856003702657949009002694b254276261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254276-386ec94400aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS931 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a5 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : أَمَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَأَنزَلَ لَكُم مِّنَ ٱلسَّمَآءِ مَآءࣰ فَأَنۢبَتۡنَا بِهِۦ حَدَآئِقَ ذَاتَ بَهۡجَةࣲ مَّا كَانَ لَكُمۡ أَن تُنۢبِتُواْ شَجَرَهَآۗ أَءِلَٰهࣱ مَّعَ ٱللَّهِۚ بَلۡ هُمۡ قَوۡمࣱ يَعۡدِلُونَ60
أَمَّن جَعَلَ ٱلۡأَرۡضَ قَرَارࣰا وَجَعَلَ خِلَٰلَهَآ أَنۡهَٰرࣰا وَجَعَلَ لَهَا رَوَٰسِيَ وَجَعَلَ بَيۡنَ ٱلۡبَحۡرَيۡنِ حَاجِزًاۗ أَءِلَٰهࣱ مَّعَ ٱللَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ61
أَمَّن يُجِيبُ ٱلۡمُضۡطَرَّ إِذَا دَعَاهُ وَيَكۡشِفُ ٱلسُّوٓءَ وَيَجۡعَلُكُمۡ خُلَفَآءَ ٱلۡأَرۡضِۗ أَءِلَٰهࣱ مَّعَ ٱللَّهِۚ قَلِيلࣰا مَّا تَذَكَّرُونَ00aاخره : قُلۡ فَأۡتُواْ بِكِتَٰبࣲ مِّنۡ عِندِ ٱللَّهِ هُوَ أَهۡدَىٰ مِنۡهُمَآ أَتَّبِعۡهُ إِن كُنتُمۡ صَٰدِقِينَ49
فَإِن لَّمۡ يَسۡتَجِيبُواْ لَكَ فَٱعۡلَمۡ أَنَّمَا يَتَّبِعُونَ أَهۡوَآءَهُمۡۚ وَمَنۡ أَضَلُّ مِمَّنِ ٱتَّبَعَ هَوَىٰهُ بِغَيۡرِ هُدࣰى مِّنَ ٱللَّهِۚ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّـٰلِمِينَ50
وَلَقَدۡ وَصَّلۡنَا لَهُمُ ٱلۡقَوۡلَ لَعَلَّهُمۡ يَتَذَكَّرُونَ51
ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ مِن قَبۡلِهِۦ هُم بِهِۦ يُؤۡمِنُونَ5210aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 93،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=386ec94400aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02896ctm a2200301 i 4500001000800000008004100008035003400049040003300083050002000116066000700136098000900143100004900152240004200201245007800243264002200321300001500343336003800358337003500396338002900431340004300460500083900503500095501342535011302297546002702410650003002437856003702467949009002504b254275261016s1923    xx            000 0 ara d00a(DROMH) dromh-254275-ecf5fec800aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 192300c(300aMS921 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1342هـ = [1923]00a9 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : ثُمَّ إِذَا كَشَفَ ٱلضُّرَّ عَنكُمۡ إِذَا فَرِيقࣱ مِّنكُم بِرَبِّهِمۡ يُشۡرِكُونَ54
لِيَكۡفُرُواْ بِمَآ ءَاتَيۡنَٰهُمۡۚ فَتَمَتَّعُواْ فَسَوۡفَ تَعۡلَمُونَ55
وَيَجۡعَلُونَ لِمَا لَا يَعۡلَمُونَ نَصِيبࣰا مِّمَّا رَزَقۡنَٰهُمۡۗ تَٱللَّهِ لَتُسۡـَٔلُنَّ عَمَّا كُنتُمۡ تَفۡتَرُونَ56
وَيَجۡعَلُونَ لِلَّهِ ٱلۡبَنَٰتِ سُبۡحَٰنَهُۥ ۙوَلَهُم مَّا يَشۡتَهُونَ57
وَإِذَا بُشِّرَ أَحَدُهُم بِٱلۡأُنثَىٰ ظَلَّ وَجۡهُهُۥ مُسۡوَدࣰّا وَهُوَ كَظِيمࣱ00aاخره : ٱدۡعُ إِلَىٰ سَبِيلِ رَبِّكَ بِٱلۡحِكۡمَةِ وَٱلۡمَوۡعِظَةِ ٱلۡحَسَنَةِۖ وَجَٰدِلۡهُم بِٱلَّتِي هِيَ أَحۡسَنُۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ125
وَإِنۡ عَاقَبۡتُمۡ فَعَاقِبُواْ بِمِثۡلِ مَا عُوقِبۡتُم بِهِۦۖ وَلَئِن صَبَرۡتُمۡ لَهُوَ خَيۡرࣱ لِّلصَّـٰبِرِينَ126
وَٱصۡبِرۡ وَمَا صَبۡرُكَ إِلَّا بِٱللَّهِۚ وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَلَا تَكُ فِي ضَيۡقࣲ مِّمَّا يَمۡكُرُونَ127
إِنَّ ٱللَّهَ مَعَ ٱلَّذِينَ ٱتَّقَواْ وَّٱلَّذِينَ هُم مُّحۡسِنُونَ12810aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 92،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=ecf5fec800aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03146ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500084200524500112901366535011302495546002702608583004002635650003002675856003702705949009002742b254274261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254274-d8a5ceb200aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS911 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) يَنتَصِرُونَ93
فَكُبۡكِبُواْ فِيهَا هُمۡ وَٱلۡغَاوُۥنَ94
وَجُنُودُ إِبۡلِيسَ أَجۡمَعُونَ95
قَالُواْ وَهُمۡ فِيهَا يَخۡتَصِمُونَ96
تَٱللَّهِ إِن كُنَّا لَفِي ضَلَٰلࣲ مُّبِينٍ97
إِذۡ نُسَوِّيكُم بِرَبِّ ٱلۡعَٰلَمِينَ98
وَمَآ أَضَلَّنَآ إِلَّا ٱلۡمُجۡرِمُونَ99
فَمَا لَنَا مِن شَٰفِعِينَ100
وَلَا صَدِيقٍ حَمِيمࣲ101
فَلَوۡ أَنَّ لَنَا كَرَّةࣰ فَنَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ102
إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ10300aاخره : (ناقص) وَصَدَّهَا مَا كَانَت تَّعۡبُدُ مِن دُونِ ٱللَّهِۖ إِنَّهَا كَانَتۡ مِن قَوۡمࣲ كَٰفِرِينَ43
قِيلَ لَهَا ٱدۡخُلِي ٱلصَّرۡحَۖ فَلَمَّا رَأَتۡهُ حَسِبَتۡهُ لُجَّةࣰ وَكَشَفَتۡ عَن سَاقَيۡهَاۚ قَالَ إِنَّهُۥ صَرۡحࣱ مُّمَرَّدࣱ مِّن قَوَارِيرَۗ قَالَتۡ رَبِّ إِنِّي ظَلَمۡتُ نَفۡسِي وَأَسۡلَمۡتُ مَعَ سُلَيۡمَٰنَ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ44
وَلَقَدۡ أَرۡسَلۡنَآ إِلَىٰ ثَمُودَ أَخَاهُمۡ صَٰلِحًا أَنِ ٱعۡبُدُواْ ٱللَّهَ فَإِذَا هُمۡ فَرِيقَانِ يَخۡتَصِمُونَ45
قَالَ يَٰقَوۡمِ لِمَ تَسۡتَعۡجِلُونَ بِٱلسَّيِّئَةِ قَبۡلَ ٱلۡحَسَنَةِۖ لَوۡلَا تَسۡتَغۡفِرُونَ ٱللَّهَ لَعَلَّكُمۡ تُرۡحَمُونَ4610aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 91،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=d8a5ceb200aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03766ctm a2200337 i b254273261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254273-14ee577700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS901 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a3 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) وَمَن يَهۡدِ ٱللَّهُ فَهُوَ ٱلۡمُهۡتَدِۖ وَمَن يُضۡلِلۡ فَلَن تَجِدَ لَهُمۡ أَوۡلِيَآءَ مِن دُونِهِۦۖ وَنَحۡشُرُهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ عَلَىٰ وُجُوهِهِمۡ عُمۡيࣰا وَبُكۡمࣰا وَصُمࣰّاۖ مَّأۡوَىٰهُمۡ جَهَنَّمُۖ كُلَّمَا خَبَتۡ زِدۡنَٰهُمۡ سَعِيرࣰا97
ذَٰلِكَ جَزَآؤُهُم بِأَنَّهُمۡ كَفَرُواْ بِـَٔايَٰتِنَا وَقَالُوٓاْ أَءِذَا كُنَّا عِظَٰمࣰا وَرُفَٰتًا أَءِنَّا لَمَبۡعُوثُونَ خَلۡقࣰا جَدِيدًا98
أَوَلَمۡ يَرَوۡاْ أَنَّ ٱللَّهَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ قَادِرٌ عَلَىٰٓ أَن يَخۡلُقَ مِثۡلَهُمۡ وَجَعَلَ لَهُمۡ أَجَلࣰا لَّا رَيۡبَ فِيهِ فَأَبَى ٱلظَّـٰلِمُونَ إِلَّا كُفُورࣰا9900aاخره : ف(ناقص) َلَمَّا جَاوَزَا قَالَ لِفَتَىٰهُ ءَاتِنَا غَدَآءَنَا لَقَدۡ لَقِينَا مِن سَفَرِنَا هَٰذَا نَصَبࣰا62
قَالَ أَرَءَيۡتَ إِذۡ أَوَيۡنَآ إِلَى ٱلصَّخۡرَةِ فَإِنِّي نَسِيتُ ٱلۡحُوتَ وَمَآ أَنسَىٰنِيهُ إِلَّا ٱلشَّيۡطَٰنُ أَنۡ أَذۡكُرَهُۥۚ وَٱتَّخَذَ سَبِيلَهُۥ فِي ٱلۡبَحۡرِ عَجَبࣰا63
قَالَ ذَٰلِكَ مَا كُنَّا نَبۡغِۚ فَٱرۡتَدَّا عَلَىٰٓ ءَاثَارِهِمَا قَصَصࣰا64
فَوَجَدَا عَبۡدࣰا مِّنۡ عِبَادِنَآ ءَاتَيۡنَٰهُ رَحۡمَةࣰ مِّنۡ عِندِنَا وَعَلَّمۡنَٰهُ مِن لَّدُنَّا عِلۡمࣰا6500aوقفية احمد شاهي عرب لهذا المصحف الشريف على كافة القراء الاثنى عشرية والمتولي اغا محمد حسين بن اغا محمد بتاريخ الخميس 22 محرم الحرام 1258هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 90،cايرانgir00aاللغة : عربي.00aوقفية احمد شاهي عرب لهذا المصحف الشريف على كافة القراء الاثنى عشرية والمتولي اغا محمد حسين بن اغا محمد بتاريخ الخميس 22 محرم الحرام 1258هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=14ee577700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02854ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001600364336003800380337003500418338002900453340004300482500090300525500077501428535011302203546002702316583004002343650003002383856003702413949009002450b254272261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254272-2b84dd8000aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS891 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a14 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) أَنفُسَهُمۡ فَهُمۡ لَا يُؤۡمِنُونَ20
وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلظَّـٰلِمُونَ21
وَيَوۡمَ نَحۡشُرُهُمۡ جَمِيعࣰا ثُمَّ نَقُولُ لِلَّذِينَ أَشۡرَكُوٓاْ أَيۡنَ شُرَكَآؤُكُمُ ٱلَّذِينَ كُنتُمۡ تَزۡعُمُونَ22
ثُمَّ لَمۡ تَكُن فِتۡنَتُهُمۡ إِلَّآ أَن قَالُواْ وَٱللَّهِ رَبِّنَا مَا كُنَّا مُشۡرِكِينَ23
ٱنظُرۡ كَيۡفَ كَذَبُواْ عَلَىٰٓ أَنفُسِهِمۡۚ وَضَلَّ عَنۡهُم مَّا كَانُواْ يَفۡتَرُونَ2400aاخره : (ناقص) هَلۡ يَنظُرُونَ إِلَّآ أَن تَأۡتِيَهُمُ ٱلۡمَلَـٰٓئِكَةُ أَوۡ يَأۡتِيَ رَبُّكَ أَوۡ يَأۡتِيَ بَعۡضُ ءَايَٰتِ رَبِّكَۗ يَوۡمَ يَأۡتِي بَعۡضُ ءَايَٰتِ رَبِّكَ لَا يَنفَعُ نَفۡسًا إِيمَٰنُهَا لَمۡ تَكُنۡ ءَامَنَتۡ مِن قَبۡلُ أَوۡ كَسَبَتۡ فِيٓ إِيمَٰنِهَا خَيۡرࣰاۗ قُلِ ٱنتَظِرُوٓاْ إِنَّا مُنتَظِرُونَ158
إِنَّ ٱلَّذِينَ فَرَّقُواْ دِينَهُمۡ وَكَانُواْ شِيَعࣰا لَّسۡتَ مِنۡهُمۡ فِي شَيۡءٍۚ إِنَّمَآ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 89،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=2b84dd8000aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03243ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001600364336003800380337003500418338002900453340004300482500112500525500094201650535011302592546002702705583004002732650003002772856003702802949009002839b254271261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254271-bf38c3b700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS881 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a13 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص)  وَلَآ أَوۡلَٰدُهُم مِّنَ ٱللَّهِ شَيۡـࣰٔاۖ وَأُوْلَـٰٓئِكَ هُمۡ وَقُودُ ٱلنَّارِ10
كَدَأۡبِ ءَالِ فِرۡعَوۡنَ وَٱلَّذِينَ مِن قَبۡلِهِمۡۚ كَذَّبُواْ بِـَٔايَٰتِنَا فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمۡۗ وَٱللَّهُ شَدِيدُ ٱلۡعِقَابِ11
قُل لِّلَّذِينَ كَفَرُواْ سَتُغۡلَبُونَ وَتُحۡشَرُونَ إِلَىٰ جَهَنَّمَۖ وَبِئۡسَ ٱلۡمِهَادُ12
قَدۡ كَانَ لَكُمۡ ءَايَةࣱ فِي فِئَتَيۡنِ ٱلۡتَقَتَاۖ فِئَةࣱ تُقَٰتِلُ فِي سَبِيلِ ٱللَّهِ وَأُخۡرَىٰ كَافِرَةࣱ يَرَوۡنَهُم مِّثۡلَيۡهِمۡ رَأۡيَ ٱلۡعَيۡنِۚ وَٱللَّهُ يُؤَيِّدُ بِنَصۡرِهِۦ مَن يَشَآءُۚ إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّأُوْلِي ٱلۡأَبۡصَٰرِ1300aاخره : (ناقص) وَٱلَّذَانِ يَأۡتِيَٰنِهَا مِنكُمۡ فَـَٔاذُوهُمَاۖ فَإِن تَابَا وَأَصۡلَحَا فَأَعۡرِضُواْ عَنۡهُمَآۗ إِنَّ ٱللَّهَ كَانَ تَوَّابࣰا رَّحِيمًا16
إِنَّمَا ٱلتَّوۡبَةُ عَلَى ٱللَّهِ لِلَّذِينَ يَعۡمَلُونَ ٱلسُّوٓءَ بِجَهَٰلَةࣲ ثُمَّ يَتُوبُونَ مِن قَرِيبࣲ فَأُوْلَـٰٓئِكَ يَتُوبُ ٱللَّهُ عَلَيۡهِمۡۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمࣰا17
وَلَيۡسَتِ ٱلتَّوۡبَةُ لِلَّذِينَ يَعۡمَلُونَ ٱلسَّيِّـَٔاتِ حَتَّىٰٓ إِذَا حَضَرَ أَحَدَهُمُ ٱلۡمَوۡتُ قَالَ إِنِّي تُبۡتُ ٱلۡـَٰٔنَ وَلَا ٱلَّذِينَ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 88،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=bf38c3b700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03360ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500118100524500100401705535011302709546002702822583004002849650003002889856003702919949009002956b254270261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254270-ed11c7e000aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS871 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) فَإِن لَّمۡ يَسۡتَجِيبُواْ لَكَ فَٱعۡلَمۡ أَنَّمَا يَتَّبِعُونَ أَهۡوَآءَهُمۡۚ وَمَنۡ أَضَلُّ مِمَّنِ ٱتَّبَعَ هَوَىٰهُ بِغَيۡرِ هُدࣰى مِّنَ ٱللَّهِۚ إِنَّ ٱللَّهَ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّـٰلِمِينَ50
وَلَقَدۡ وَصَّلۡنَا لَهُمُ ٱلۡقَوۡلَ لَعَلَّهُمۡ يَتَذَكَّرُونَ51
ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ مِن قَبۡلِهِۦ هُم بِهِۦ يُؤۡمِنُونَ52
وَإِذَا يُتۡلَىٰ عَلَيۡهِمۡ قَالُوٓاْ ءَامَنَّا بِهِۦٓ إِنَّهُ ٱلۡحَقُّ مِن رَّبِّنَآ إِنَّا كُنَّا مِن قَبۡلِهِۦ مُسۡلِمِينَ53
أُوْلَـٰٓئِكَ يُؤۡتَوۡنَ أَجۡرَهُم مَّرَّتَيۡنِ بِمَا صَبَرُواْ وَيَدۡرَءُونَ بِٱلۡحَسَنَةِ ٱلسَّيِّئَةَ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ5400aاخره : (ناقص) وَوَهَبۡنَا لَهُۥٓ إِسۡحَٰقَ وَيَعۡقُوبَ وَجَعَلۡنَا فِي ذُرِّيَّتِهِ ٱلنُّبُوَّةَ وَٱلۡكِتَٰبَ وَءَاتَيۡنَٰهُ أَجۡرَهُۥ فِي ٱلدُّنۡيَاۖ وَإِنَّهُۥ فِي ٱلۡأٓخِرَةِ لَمِنَ ٱلصَّـٰلِحِينَ27
وَلُوطًا إِذۡ قَالَ لِقَوۡمِهِۦٓ إِنَّكُمۡ لَتَأۡتُونَ ٱلۡفَٰحِشَةَ مَا سَبَقَكُم بِهَا مِنۡ أَحَدࣲ مِّنَ ٱلۡعَٰلَمِينَ28
أَئِنَّكُمۡ لَتَأۡتُونَ ٱلرِّجَالَ وَتَقۡطَعُونَ ٱلسَّبِيلَ وَتَأۡتُونَ فِي نَادِيكُمُ ٱلۡمُنكَرَۖ فَمَا كَانَ جَوَابَ قَوۡمِهِۦٓ إِلَّآ أَن قَالُواْ ٱئۡتِنَا بِعَذَابِ ٱللَّهِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 87،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=ed11c7e000aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03517ctm a2200325 i b254269261016s1858    xx            000 0 ara d00a(DROMH) dromh-254269-0585c9f700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 185800c(300aMS861 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1275هـ = [1858]00a9 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ
ٱقۡتَرَبَ لِلنَّاسِ حِسَابُهُمۡ وَهُمۡ فِي غَفۡلَةࣲ مُّعۡرِضُونَ1
مَا يَأۡتِيهِم مِّن ذِكۡرࣲ مِّن رَّبِّهِم مُّحۡدَثٍ إِلَّا ٱسۡتَمَعُوهُ وَهُمۡ يَلۡعَبُونَ2
لَاهِيَةࣰ قُلُوبُهُمۡۗ وَأَسَرُّواْ ٱلنَّجۡوَى ٱلَّذِينَ ظَلَمُواْ هَلۡ هَٰذَآ إِلَّا بَشَرࣱ مِّثۡلُكُمۡۖ أَفَتَأۡتُونَ ٱلسِّحۡرَ وَأَنتُمۡ تُبۡصِرُونَ3
قَالَ رَبِّي يَعۡلَمُ ٱلۡقَوۡلَ فِي ٱلسَّمَآءِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ4
بَلۡ قَالُوٓاْ أَضۡغَٰثُ أَحۡلَٰمِۭ بَلِ ٱفۡتَرَىٰهُ بَلۡ هُوَ شَاعِرࣱ فَلۡيَأۡتِنَا بِـَٔايَةࣲ كَمَآ أُرۡسِلَ ٱلۡأَوَّلُونَ500aاخره : قُلۡ إِنَّمَا يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهࣱ وَٰحِدࣱۖ فَهَلۡ أَنتُم مُّسۡلِمُونَ108
فَإِن تَوَلَّوۡاْ فَقُلۡ ءَاذَنتُكُمۡ عَلَىٰ سَوَآءࣲۖ وَإِنۡ أَدۡرِيٓ أَقَرِيبٌ أَم بَعِيدࣱ مَّا تُوعَدُونَ109
إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ مِنَ ٱلۡقَوۡلِ وَيَعۡلَمُ مَا تَكۡتُمُونَ110
وَإِنۡ أَدۡرِي لَعَلَّهُۥ فِتۡنَةࣱ لَّكُمۡ وَمَتَٰعٌ إِلَىٰ حِينࣲ111
قَٰلَ رَبِّ ٱحۡكُم بِٱلۡحَقِّۗ وَرَبُّنَا ٱلرَّحۡمَٰنُ ٱلۡمُسۡتَعَانُ عَلَىٰ مَا تَصِفُونَ11200aوقفية الحاج حمزة كفش دوز لهذا المصحف الشریف على كافة المؤمنين الاثني عشرية والمتولي مشهدي مهدي كفش دوز بتاريخ 9 صفر 1276هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 86،cايرانgir00aاللغة : عربي.00aوقفية الحاج حمزة كفش دوز لهذا المصحف الشریف على كافة المؤمنين الاثني عشرية والمتولي مشهدي مهدي كفش دوز بتاريخ 9 صفر 1276هـ 4aقرانvمخطوطات.40uhttps://dromh.org/?view=0585c9f700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03616ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001600364336003800380337003500418338002900453340004300482500137800525500106201903535011302965546002703078583004003105650003003145856003703175949009003212b254268261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254268-7764a79100aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS851 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a13 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) رَبِّ أَرِنِي كَيۡفَ تُحۡيِ ٱلۡمَوۡتَىٰۖ قَالَ أَوَلَمۡ تُؤۡمِنۖ قَالَ بَلَىٰ وَلَٰكِن لِّيَطۡمَئِنَّ قَلۡبِيۖ قَالَ فَخُذۡ أَرۡبَعَةࣰ مِّنَ ٱلطَّيۡرِ فَصُرۡهُنَّ إِلَيۡكَ ثُمَّ ٱجۡعَلۡ عَلَىٰ كُلِّ جَبَلࣲ مِّنۡهُنَّ جُزۡءࣰا ثُمَّ ٱدۡعُهُنَّ يَأۡتِينَكَ سَعۡيࣰاۚ وَٱعۡلَمۡ أَنَّ ٱللَّهَ عَزِيزٌ حَكِيمࣱ260
مَّثَلُ ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمۡ فِي سَبِيلِ ٱللَّهِ كَمَثَلِ حَبَّةٍ أَنۢبَتَتۡ سَبۡعَ سَنَابِلَ فِي كُلِّ سُنۢبُلَةࣲ مِّاْئَةُ حَبَّةࣲۗ وَٱللَّهُ يُضَٰعِفُ لِمَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ261
ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمۡ فِي سَبِيلِ ٱللَّهِ ثُمَّ لَا يُتۡبِعُونَ مَآ أَنفَقُواْ مَنࣰّا وَلَآ أَذࣰىۙ لَّهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ26200aاخره : إِلَّا ٱلَّذِينَ تَابُواْ مِنۢ بَعۡدِ ذَٰلِكَ وَأَصۡلَحُواْ فَإِنَّ ٱللَّهَ غَفُورࣱ رَّحِيمٌ89
إِنَّ ٱلَّذِينَ كَفَرُواْ بَعۡدَ إِيمَٰنِهِمۡ ثُمَّ ٱزۡدَادُواْ كُفۡرࣰا لَّن تُقۡبَلَ تَوۡبَتُهُمۡ وَأُوْلَـٰٓئِكَ هُمُ ٱلضَّآلُّونَ90
إِنَّ ٱلَّذِينَ كَفَرُواْ وَمَاتُواْ وَهُمۡ كُفَّارࣱ فَلَن يُقۡبَلَ مِنۡ أَحَدِهِم مِّلۡءُ ٱلۡأَرۡضِ ذَهَبࣰا وَلَوِ ٱفۡتَدَىٰ بِهِۦٓۗ أُوْلَـٰٓئِكَ لَهُمۡ عَذَابٌ أَلِيمࣱ وَمَا لَهُم مِّن نَّـٰصِرِينَ91
لَن تَنَالُواْ ٱلۡبِرَّ حَتَّىٰ تُنفِقُواْ مِمَّا تُحِبُّونَۚ وَمَا تُنفِقُواْ مِن شَيۡءࣲ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمࣱ9210aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 85،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=7764a79100aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03260ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001600364336003800380337003500418338002900453340004300482500108900525500099501614535011302609546002702722583004002749650003002789856003702819949009002856b254267261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254267-ba97498700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS841 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a11 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) يَٰنِسَآءَ ٱلنَّبِيِّ لَسۡتُنَّ كَأَحَدࣲ مِّنَ ٱلنِّسَآءِ إِنِ ٱتَّقَيۡتُنَّۚ فَلَا تَخۡضَعۡنَ بِٱلۡقَوۡلِ فَيَطۡمَعَ ٱلَّذِي فِي قَلۡبِهِۦ مَرَضࣱ وَقُلۡنَ قَوۡلࣰا مَّعۡرُوفࣰا32
وَقَرۡنَ فِي بُيُوتِكُنَّ وَلَا تَبَرَّجۡنَ تَبَرُّجَ ٱلۡجَٰهِلِيَّةِ ٱلۡأُولَىٰۖ وَأَقِمۡنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعۡنَ ٱللَّهَ وَرَسُولَهُۥٓۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذۡهِبَ عَنكُمُ ٱلرِّجۡسَ أَهۡلَ ٱلۡبَيۡتِ وَيُطَهِّرَكُمۡ تَطۡهِيرࣰا33
وَٱذۡكُرۡنَ مَا يُتۡلَىٰ فِي بُيُوتِكُنَّ مِنۡ ءَايَٰتِ ٱللَّهِ وَٱلۡحِكۡمَةِۚ إِنَّ ٱللَّهَ كَانَ لَطِيفًا خَبِيرًا3400aاخره : (ناقص) إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكۡرَ وَخَشِيَ ٱلرَّحۡمَٰنَ بِٱلۡغَيۡبِۖ فَبَشِّرۡهُ بِمَغۡفِرَةࣲ وَأَجۡرࣲ كَرِيمٍ11
إِنَّا نَحۡنُ نُحۡيِ ٱلۡمَوۡتَىٰ وَنَكۡتُبُ مَا قَدَّمُواْ وَءَاثَٰرَهُمۡۚ وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ فِيٓ إِمَامࣲ مُّبِينࣲ12
وَٱضۡرِبۡ لَهُم مَّثَلًا أَصۡحَٰبَ ٱلۡقَرۡيَةِ إِذۡ جَآءَهَا ٱلۡمُرۡسَلُونَ13
إِذۡ أَرۡسَلۡنَآ إِلَيۡهِمُ ٱثۡنَيۡنِ فَكَذَّبُوهُمَا فَعَزَّزۡنَا بِثَالِثࣲ فَقَالُوٓاْ إِنَّآ إِلَيۡكُم مُّرۡسَلُونَ14
قَالُواْ مَآ أَنتُمۡ إِلَّا بَشَرࣱ مِّثۡلُنَا وَمَآ أَنزَلَ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 84،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=ba97498700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02814ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500049700524500114201021535011302163546002702276583004002303650003002343856003702373949009002410b254266261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254266-499deebf00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS831 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) تَتۡبَعُهَا ٱلرَّادِفَةُ7
قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ8
أَبۡصَٰرُهَا خَٰشِعَةࣱ9
يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ10
أَءِذَا كُنَّا عِظَٰمࣰا نَّخِرَةࣰ11
قَالُواْ تِلۡكَ إِذࣰا كَرَّةٌ خَاسِرَةࣱ12
فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ1300aاخره : بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ
وَٱلسَّمَآءِ وَٱلطَّارِقِ1
وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ2
ٱلنَّجۡمُ ٱلثَّاقِبُ3
إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ4
فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ5
خُلِقَ مِن مَّآءࣲ دَافِقࣲ6
يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ7
إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ8
يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ9
فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ10
وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ11
وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ12
إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ13
وَمَا هُوَ بِٱلۡهَزۡلِ14
إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰا15
وَأَكِيدُ كَيۡدࣰا16
فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا1710aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 83،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=499deebf00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03536ctm a2200337 i b254265261016s1858    xx            000 0 ara d00a(DROMH) dromh-254265-343fcd9f00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 185800c(300aMS821 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1275هـ = [1858]00a9 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) وَإِذۡ قَالَ إِبۡرَٰهِيمُ لِأَبِيهِ وَقَوۡمِهِۦٓ إِنَّنِي بَرَآءࣱ مِّمَّا تَعۡبُدُونَ26
إِلَّا ٱلَّذِي فَطَرَنِي فَإِنَّهُۥ سَيَهۡدِينِ27
وَجَعَلَهَا كَلِمَةَۢ بَاقِيَةࣰ فِي عَقِبِهِۦ لَعَلَّهُمۡ يَرۡجِعُونَ28
بَلۡ مَتَّعۡتُ هَـٰٓؤُلَآءِ وَءَابَآءَهُمۡ حَتَّىٰ جَآءَهُمُ ٱلۡحَقُّ وَرَسُولࣱ مُّبِينࣱ29
وَلَمَّا جَآءَهُمُ ٱلۡحَقُّ قَالُواْ هَٰذَا سِحۡرࣱ وَإِنَّا بِهِۦ كَٰفِرُونَ30
وَقَالُواْ لَوۡلَا نُزِّلَ هَٰذَا ٱلۡقُرۡءَانُ عَلَىٰ رَجُلࣲ مِّنَ ٱلۡقَرۡيَتَيۡنِ عَظِيمٍ3100aاخره : وَأَمَّا ٱلَّذِينَ كَفَرُوٓاْ أَفَلَمۡ تَكُنۡ ءَايَٰتِي تُتۡلَىٰ عَلَيۡكُمۡ فَٱسۡتَكۡبَرۡتُمۡ وَكُنتُمۡ قَوۡمࣰا مُّجۡرِمِينَ31
وَإِذَا قِيلَ إِنَّ وَعۡدَ ٱللَّهِ حَقࣱّ وَٱلسَّاعَةُ لَا رَيۡبَ فِيهَا قُلۡتُم مَّا نَدۡرِي مَا ٱلسَّاعَةُ إِن نَّظُنُّ إِلَّا ظَنࣰّا وَمَا نَحۡنُ بِمُسۡتَيۡقِنِينَ32
وَبَدَا لَهُمۡ سَيِّـَٔاتُ مَا عَمِلُواْ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ33
وَقِيلَ ٱلۡيَوۡمَ نَنسَىٰكُمۡ كَمَا نَسِيتُمۡ لِقَآءَ يَوۡمِكُمۡ هَٰذَا وَمَأۡوَىٰكُمُ ٱلنَّارُ وَمَا لَكُم مِّن نَّـٰصِرِينَ3400aوقفية الحاج حمزة كفش دوز لهذا المصحف الشریف على كافة المؤمنين الاثني عشرية والمتولي مشهدي مهدي كفش دوز بتاريخ 9 صفر 1276هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 82،cايرانgir00aاللغة : عربي.00aوقفية الحاج حمزة كفش دوز لهذا المصحف الشریف على كافة المؤمنين الاثني عشرية والمتولي مشهدي مهدي كفش دوز بتاريخ 9 صفر 1276هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=343fcd9f00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04074ctm a2200337 i b254264261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254264-0f7609bb00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS811 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a8 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) وَلَوۡ أَنَّنَا نَزَّلۡنَآ إِلَيۡهِمُ ٱلۡمَلَـٰٓئِكَةَ وَكَلَّمَهُمُ ٱلۡمَوۡتَىٰ وَحَشَرۡنَا عَلَيۡهِمۡ كُلَّ شَيۡءࣲ قُبُلࣰا مَّا كَانُواْ لِيُؤۡمِنُوٓاْ إِلَّآ أَن يَشَآءَ ٱللَّهُ وَلَٰكِنَّ أَكۡثَرَهُمۡ يَجۡهَلُونَ111
وَكَذَٰلِكَ جَعَلۡنَا لِكُلِّ نَبِيٍّ عَدُوࣰّا شَيَٰطِينَ ٱلۡإِنسِ وَٱلۡجِنِّ يُوحِي بَعۡضُهُمۡ إِلَىٰ بَعۡضࣲ زُخۡرُفَ ٱلۡقَوۡلِ غُرُورࣰاۚ وَلَوۡ شَآءَ رَبُّكَ مَا فَعَلُوهُۖ فَذَرۡهُمۡ وَمَا يَفۡتَرُونَ112
وَلِتَصۡغَىٰٓ إِلَيۡهِ أَفۡـِٔدَةُ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ وَلِيَرۡضَوۡهُ وَلِيَقۡتَرِفُواْ مَا هُم مُّقۡتَرِفُونَ113
أَفَغَيۡرَ ٱللَّهِ أَبۡتَغِي حَكَمࣰا وَهُوَ ٱلَّذِيٓ أَنزَلَ إِلَيۡكُمُ ٱلۡكِتَٰبَ مُفَصَّلࣰاۚ وَٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَعۡلَمُونَ أَنَّهُۥ مُنَزَّلࣱ مِّن رَّبِّكَ بِٱلۡحَقِّۖ فَلَا تَكُونَنَّ مِنَ ٱلۡمُمۡتَرِينَ11400aاخره : يَكُونُ لَكَ أَن تَتَكَبَّرَ فِيهَا فَٱخۡرُجۡ إِنَّكَ مِنَ ٱلصَّـٰغِرِينَ13
قَالَ أَنظِرۡنِيٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ14
قَالَ إِنَّكَ مِنَ ٱلۡمُنظَرِينَ15
قَالَ فَبِمَآ أَغۡوَيۡتَنِي لَأَقۡعُدَنَّ لَهُمۡ صِرَٰطَكَ ٱلۡمُسۡتَقِيمَ16
ثُمَّ لَأٓتِيَنَّهُم مِّنۢ بَيۡنِ أَيۡدِيهِمۡ وَمِنۡ خَلۡفِهِمۡ وَعَنۡ أَيۡمَٰنِهِمۡ وَعَن شَمَآئِلِهِمۡۖ وَلَا تَجِدُ أَكۡثَرَهُمۡ شَٰكِرِينَ17
قَالَ ٱخۡرُجۡ مِنۡهَا مَذۡءُومࣰا مَّدۡحُورࣰاۖ لَّمَن تَبِعَكَ مِنۡهُمۡ لَأَمۡلَأَنَّ جَهَنَّمَ مِنكُمۡ أَجۡمَعِينَ1800aوقفية الحاج محمد كيلك وأخيه الحاج نصير لهذا المصحف الشريف على كافة المؤمنين والمؤمنات بتاريخ شهر صفر 1236هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 81،cايرانgir00aاللغة : عربي.00aوقفية الحاج محمد كيلك وأخيه الحاج نصير لهذا المصحف الشريف على كافة المؤمنين والمؤمنات بتاريخ شهر صفر 1236هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=0f7609bb00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04252ctm a2200337 i b254263261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254263-18406eb200aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS801 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) يَسۡتَبۡشِرُونَ بِنِعۡمَةࣲ مِّنَ ٱللَّهِ وَفَضۡلࣲ وَأَنَّ ٱللَّهَ لَا يُضِيعُ أَجۡرَ ٱلۡمُؤۡمِنِينَ171
ٱلَّذِينَ ٱسۡتَجَابُواْ لِلَّهِ وَٱلرَّسُولِ مِنۢ بَعۡدِ مَآ أَصَابَهُمُ ٱلۡقَرۡحُۚ لِلَّذِينَ أَحۡسَنُواْ مِنۡهُمۡ وَٱتَّقَوۡاْ أَجۡرٌ عَظِيمٌ172
ٱلَّذِينَ قَالَ لَهُمُ ٱلنَّاسُ إِنَّ ٱلنَّاسَ قَدۡ جَمَعُواْ لَكُمۡ فَٱخۡشَوۡهُمۡ فَزَادَهُمۡ إِيمَٰنࣰا وَقَالُواْ حَسۡبُنَا ٱللَّهُ وَنِعۡمَ ٱلۡوَكِيلُ173
فَٱنقَلَبُواْ بِنِعۡمَةࣲ مِّنَ ٱللَّهِ وَفَضۡلࣲ لَّمۡ يَمۡسَسۡهُمۡ سُوٓءࣱ وَٱتَّبَعُواْ رِضۡوَٰنَ ٱللَّهِۗ وَٱللَّهُ ذُو فَضۡلٍ عَظِيمٍ17400aاخره : حُرِّمَتۡ عَلَيۡكُمۡ أُمَّهَٰتُكُمۡ وَبَنَاتُكُمۡ وَأَخَوَٰتُكُمۡ وَعَمَّـٰتُكُمۡ وَخَٰلَٰتُكُمۡ وَبَنَاتُ ٱلۡأَخِ وَبَنَاتُ ٱلۡأُخۡتِ وَأُمَّهَٰتُكُمُ ٱلَّـٰتِيٓ أَرۡضَعۡنَكُمۡ وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَٰعَةِ وَأُمَّهَٰتُ نِسَآئِكُمۡ وَرَبَـٰٓئِبُكُمُ ٱلَّـٰتِي فِي حُجُورِكُم مِّن نِّسَآئِكُمُ ٱلَّـٰتِي دَخَلۡتُم بِهِنَّ فَإِن لَّمۡ تَكُونُواْ دَخَلۡتُم بِهِنَّ فَلَا جُنَاحَ عَلَيۡكُمۡ وَحَلَـٰٓئِلُ أَبۡنَآئِكُمُ ٱلَّذِينَ مِنۡ أَصۡلَٰبِكُمۡ وَأَن تَجۡمَعُواْ بَيۡنَ ٱلۡأُخۡتَيۡنِ إِلَّا مَا قَدۡ سَلَفَۗ إِنَّ ٱللَّهَ كَانَ غَفُورࣰا رَّحِيمࣰا2300aعليها وقفية الحاج اقا محمد كيلك واخوه الحاج نصير  لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة المؤمنين ويعطى ثوابه للواقفين وأن لا يعطى بيد الاطفال وتوليتها مع الواقف ومن بعده مع اولاده الذكور والوقفية بتاريخ شهر صفر المظفر 1236هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 80،cايرانgir00aاللغة : عربي.00aعليها وقفية الحاج اقا محمد كيلك واخوه الحاج نصير  لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة المؤمنين ويعطى ثوابه للواقفين وأن لا يعطى بيد الاطفال وتوليتها مع الواقف ومن بعده مع اولاده الذكور والوقفية بتاريخ شهر صفر المظفر 1236هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=18406eb200aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03225ctm a2200325 i b254262261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254262-d612002200aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS791 aكلام الله (عز وجل)،eمؤلف.10aجزء من القرآن الكريم10aجزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) سَيَحۡلِفُونَ بِٱللَّهِ لَكُمۡ إِذَا ٱنقَلَبۡتُمۡ إِلَيۡهِمۡ لِتُعۡرِضُواْ عَنۡهُمۡۖ فَأَعۡرِضُواْ عَنۡهُمۡۖ إِنَّهُمۡ رِجۡسࣱۖ وَمَأۡوَىٰهُمۡ جَهَنَّمُ جَزَآءَۢ بِمَا كَانُواْ يَكۡسِبُونَ95
يَحۡلِفُونَ لَكُمۡ لِتَرۡضَوۡاْ عَنۡهُمۡۖ فَإِن تَرۡضَوۡاْ عَنۡهُمۡ فَإِنَّ ٱللَّهَ لَا يَرۡضَىٰ عَنِ ٱلۡقَوۡمِ ٱلۡفَٰسِقِينَ96
ٱلۡأَعۡرَابُ أَشَدُّ كُفۡرࣰا وَنِفَاقࣰا وَأَجۡدَرُ أَلَّا يَعۡلَمُواْ حُدُودَ مَآ أَنزَلَ ٱللَّهُ عَلَىٰ رَسُولِهِۦۗ وَٱللَّهُ عَلِيمٌ حَكِيمࣱ97
وَمِنَ ٱلۡأَعۡرَابِ مَن يَتَّخِذُ مَا يُنفِقُ مَغۡرَمࣰا وَيَتَرَبَّصُ بِكُمُ ٱلدَّوَآئِرَۚ عَلَيۡهِمۡ دَآئِرَةُ ٱلسَّوۡءِۗ وَٱللَّهُ سَمِيعٌ عَلِيمࣱ9800aاخره : (ناقص) إِنَّمَا مَثَلُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا كَمَآءٍ أَنزَلۡنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ مِمَّا يَأۡكُلُ ٱلنَّاسُ وَٱلۡأَنۡعَٰمُ حَتَّىٰٓ إِذَآ أَخَذَتِ ٱلۡأَرۡضُ زُخۡرُفَهَا وَٱزَّيَّنَتۡ وَظَنَّ أَهۡلُهَآ أَنَّهُمۡ قَٰدِرُونَ عَلَيۡهَآ أَتَىٰهَآ أَمۡرُنَا لَيۡلًا أَوۡ نَهَارࣰا فَجَعَلۡنَٰهَا حَصِيدࣰا كَأَن لَّمۡ تَغۡنَ بِٱلۡأَمۡسِۚ كَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمࣲ00aجزء 11 من القرآن الكريم10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 79،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=d612002200aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03390ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004600196245008200242264004800324300001600372336003800388337003500426338002900461340004300490500123900533500096701772535011302739546002702852583004002879650003002919856003702949949009002986b254261261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254261-6ea9bf7700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS781 aكلام الله (عز وجل)،eمؤلف.10aاوراق من القرآن الكريم10aاوراق من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a10 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) تِلۡكَ ٱلرُّسُلُ فَضَّلۡنَا بَعۡضَهُمۡ عَلَىٰ بَعۡضࣲۘ مِّنۡهُم مَّن كَلَّمَ ٱللَّهُۖ وَرَفَعَ بَعۡضَهُمۡ دَرَجَٰتࣲۚ وَءَاتَيۡنَا عِيسَى ٱبۡنَ مَرۡيَمَ ٱلۡبَيِّنَٰتِ وَأَيَّدۡنَٰهُ بِرُوحِ ٱلۡقُدُسِۗ وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلَ ٱلَّذِينَ مِنۢ بَعۡدِهِم مِّنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ وَلَٰكِنِ ٱخۡتَلَفُواْ فَمِنۡهُم مَّنۡ ءَامَنَ وَمِنۡهُم مَّن كَفَرَۚ وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلُواْ وَلَٰكِنَّ ٱللَّهَ يَفۡعَلُ مَا يُرِيدُ253
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَنفِقُواْ مِمَّا رَزَقۡنَٰكُم مِّن قَبۡلِ أَن يَأۡتِيَ يَوۡمࣱ لَّا بَيۡعࣱ فِيهِ وَلَا خُلَّةࣱ وَلَا شَفَٰعَةࣱۗ وَٱلۡكَٰفِرُونَ هُمُ ٱلظَّـٰلِمُونَ25400aاخره : (ناقص) وَلَا تُؤۡمِنُوٓاْ إِلَّا لِمَن تَبِعَ دِينَكُمۡ قُلۡ إِنَّ ٱلۡهُدَىٰ هُدَى ٱللَّهِ أَن يُؤۡتَىٰٓ أَحَدࣱ مِّثۡلَ مَآ أُوتِيتُمۡ أَوۡ يُحَآجُّوكُمۡ عِندَ رَبِّكُمۡۗ قُلۡ إِنَّ ٱلۡفَضۡلَ بِيَدِ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۗ وَٱللَّهُ وَٰسِعٌ عَلِيمࣱ73
