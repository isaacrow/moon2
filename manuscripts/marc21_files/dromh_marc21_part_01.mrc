وَقَالُواْ يَـٰٓأَيُّهَا ٱلَّذِي نُزِّلَ عَلَيۡهِ ٱلذِّكۡرُ إِنَّكَ لَمَجۡنُونࣱ6
لَّوۡ مَا تَأۡتِينَا بِٱلۡمَلَـٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ7
مَا نُنَزِّلُ ٱلۡمَلَـٰٓئِكَةَ إِلَّا بِٱلۡحَقِّ وَمَا كَانُوٓاْ إِذࣰا مُّنظَرِينَ8
إِنَّا نَحۡنُ نَزَّلۡنَا ٱلذِّكۡرَ وَإِنَّا لَهُۥ لَحَٰفِظُونَ9
وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ فِي شِيَعِ ٱلۡأَوَّلِينَ10
وَمَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ11
كَذَٰلِكَ نَسۡلُكُهُۥ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ1200aاخره : عَمَّا كَانُواْ يَعۡمَلُونَ93
فَٱصۡدَعۡ بِمَا تُؤۡمَرُ وَأَعۡرِضۡ عَنِ ٱلۡمُشۡرِكِينَ94
إِنَّا كَفَيۡنَٰكَ ٱلۡمُسۡتَهۡزِءِينَ95
ٱلَّذِينَ يَجۡعَلُونَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۚ فَسَوۡفَ يَعۡلَمُونَ96
وَلَقَدۡ نَعۡلَمُ أَنَّكَ يَضِيقُ صَدۡرُكَ بِمَا يَقُولُونَ97
فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَكُن مِّنَ ٱلسَّـٰجِدِينَ98
وَٱعۡبُدۡ رَبَّكَ حَتَّىٰ يَأۡتِيَكَ ٱلۡيَقِينُ9910aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 72،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=97ef212900aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03534ctm a2200325 i b254254261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254254-6d370ab400aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS711 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) وَمَن يَهۡدِ ٱللَّهُ فَهُوَ ٱلۡمُهۡتَدِۖ وَمَن يُضۡلِلۡ فَلَن تَجِدَ لَهُمۡ أَوۡلِيَآءَ مِن دُونِهِۦۖ وَنَحۡشُرُهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ عَلَىٰ وُجُوهِهِمۡ عُمۡيࣰا وَبُكۡمࣰا وَصُمࣰّاۖ مَّأۡوَىٰهُمۡ جَهَنَّمُۖ كُلَّمَا خَبَتۡ زِدۡنَٰهُمۡ سَعِيرࣰا97
ذَٰلِكَ جَزَآؤُهُم بِأَنَّهُمۡ كَفَرُواْ بِـَٔايَٰتِنَا وَقَالُوٓاْ أَءِذَا كُنَّا عِظَٰمࣰا وَرُفَٰتًا أَءِنَّا لَمَبۡعُوثُونَ خَلۡقࣰا جَدِيدًا98
أَوَلَمۡ يَرَوۡاْ أَنَّ ٱللَّهَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ قَادِرٌ عَلَىٰٓ أَن يَخۡلُقَ مِثۡلَهُمۡ وَجَعَلَ لَهُمۡ أَجَلࣰا لَّا رَيۡبَ فِيهِ فَأَبَى ٱلظَّـٰلِمُونَ إِلَّا كُفُورࣰا9900aاخره : قَالَ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ صَابِرࣰا وَلَآ أَعۡصِي لَكَ أَمۡرࣰا69
قَالَ فَإِنِ ٱتَّبَعۡتَنِي فَلَا تَسۡـَٔلۡنِي عَن شَيۡءٍ حَتَّىٰٓ أُحۡدِثَ لَكَ مِنۡهُ ذِكۡرࣰا70
فَٱنطَلَقَا حَتَّىٰٓ إِذَا رَكِبَا فِي ٱلسَّفِينَةِ خَرَقَهَاۖ قَالَ أَخَرَقۡتَهَا لِتُغۡرِقَ أَهۡلَهَا لَقَدۡ جِئۡتَ شَيۡـًٔا إِمۡرࣰا71
قَالَ أَلَمۡ أَقُلۡ إِنَّكَ لَن تَسۡتَطِيعَ مَعِيَ صَبۡرࣰا72
قَالَ لَا تُؤَاخِذۡنِي بِمَا نَسِيتُ وَلَا تُرۡهِقۡنِي مِنۡ أَمۡرِي عُسۡرࣰا73
فَٱنطَلَقَا حَتَّىٰٓ إِذَا لَقِيَا غُلَٰمࣰا فَقَتَلَهُۥ قَالَ أَقَتَلۡتَ نَفۡسࣰا زَكِيَّةَۢ بِغَيۡرِ نَفۡسࣲ لَّقَدۡ جِئۡتَ شَيۡـࣰٔا نُّكۡرࣰا7400aنصف الجزء 15 من القرآن الكريم10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 71،cايرانgir00aاللغة : عربي.00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=6d370ab400aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03055ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500087400524500100101398500004502399535011302444546002702557650003002584856003702614949009002651b254253261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254253-2078ae5e00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS701 aكلام الله (عز وجل)،eمؤلف.10aجزء من القرآن الكريم10aجزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَقِيلَ ٱلۡيَوۡمَ نَنسَىٰكُمۡ كَمَا نَسِيتُمۡ لِقَآءَ يَوۡمِكُمۡ هَٰذَا وَمَأۡوَىٰكُمُ ٱلنَّارُ وَمَا لَكُم مِّن نَّـٰصِرِينَ34
ذَٰلِكُم بِأَنَّكُمُ ٱتَّخَذۡتُمۡ ءَايَٰتِ ٱللَّهِ هُزُوࣰا وَغَرَّتۡكُمُ ٱلۡحَيَوٰةُ ٱلدُّنۡيَاۚ فَٱلۡيَوۡمَ لَا يُخۡرَجُونَ مِنۡهَا وَلَا هُمۡ يُسۡتَعۡتَبُونَ35
فَلِلَّهِ ٱلۡحَمۡدُ رَبِّ ٱلسَّمَٰوَٰتِ وَرَبِّ ٱلۡأَرۡضِ رَبِّ ٱلۡعَٰلَمِينَ36
وَلَهُ ٱلۡكِبۡرِيَآءُ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ3700aاخره : لِّيُدۡخِلَ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ جَنَّـٰتࣲ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا وَيُكَفِّرَ عَنۡهُمۡ سَيِّـَٔاتِهِمۡۚ وَكَانَ ذَٰلِكَ عِندَ ٱللَّهِ فَوۡزًا عَظِيمࣰا5
وَيُعَذِّبَ ٱلۡمُنَٰفِقِينَ وَٱلۡمُنَٰفِقَٰتِ وَٱلۡمُشۡرِكِينَ وَٱلۡمُشۡرِكَٰتِ ٱلظَّآنِّينَ بِٱللَّهِ ظَنَّ ٱلسَّوۡءِۚ عَلَيۡهِمۡ دَآئِرَةُ ٱلسَّوۡءِۖ وَغَضِبَ ٱللَّهُ عَلَيۡهِمۡ وَلَعَنَهُمۡ وَأَعَدَّ لَهُمۡ جَهَنَّمَۖ وَسَآءَتۡ مَصِيرࣰا6
وَلِلَّهِ جُنُودُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا700aجزء 26 من القرآن الكريم10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 70،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=2078ae5e00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04409ctm a2200325 i b254252261016s1878    xx            000 0 ara d00a(DROMH) dromh-254252-abe7d84f00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 187800c(300aMS691 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c1295هـ = [1878]00a9 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَإِذَا سَمِعُواْ مَآ أُنزِلَ إِلَى ٱلرَّسُولِ تَرَىٰٓ أَعۡيُنَهُمۡ تَفِيضُ مِنَ ٱلدَّمۡعِ مِمَّا عَرَفُواْ مِنَ ٱلۡحَقِّۖ يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱكۡتُبۡنَا مَعَ ٱلشَّـٰهِدِينَ83
وَمَا لَنَا لَا نُؤۡمِنُ بِٱللَّهِ وَمَا جَآءَنَا مِنَ ٱلۡحَقِّ وَنَطۡمَعُ أَن يُدۡخِلَنَا رَبُّنَا مَعَ ٱلۡقَوۡمِ ٱلصَّـٰلِحِينَ84
فَأَثَٰبَهُمُ ٱللَّهُ بِمَا قَالُواْ جَنَّـٰتࣲ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ ٱلۡمُحۡسِنِينَ85
وَٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَآ أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلۡجَحِيمِ8600aاخره : وَلَقَدۡ كُذِّبَتۡ رُسُلࣱ مِّن قَبۡلِكَ فَصَبَرُواْ عَلَىٰ مَا كُذِّبُواْ وَأُوذُواْ حَتَّىٰٓ أَتَىٰهُمۡ نَصۡرُنَاۚ وَلَا مُبَدِّلَ لِكَلِمَٰتِ ٱللَّهِۚ وَلَقَدۡ جَآءَكَ مِن نَّبَإِيْ ٱلۡمُرۡسَلِينَ34
وَإِن كَانَ كَبُرَ عَلَيۡكَ إِعۡرَاضُهُمۡ فَإِنِ ٱسۡتَطَعۡتَ أَن تَبۡتَغِيَ نَفَقࣰا فِي ٱلۡأَرۡضِ أَوۡ سُلَّمࣰا فِي ٱلسَّمَآءِ فَتَأۡتِيَهُم بِـَٔايَةࣲۚ وَلَوۡ شَآءَ ٱللَّهُ لَجَمَعَهُمۡ عَلَى ٱلۡهُدَىٰۚ فَلَا تَكُونَنَّ مِنَ ٱلۡجَٰهِلِينَ3500aحزب 7، عليها زخرفة قرآنية مذهبة بالمينا (سرلوح) في ابتداء السورة، عليها وقفية الحاج حسن اغا بن الاغا ميرزا احمد  لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة القراء واهداء ثواب القراءة الى والديّ الواقف وتوليتها مع الواقف ومن بعده مع الاخوند المجتهد (الشيخ) ملا محمد حسين المعروف بالبركاني وكانت الوقفية بتاريخ 5 ذي الحجة 1297هـ، الختم البيضوي: يا حسن التجاوز10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 69،cايرانgir00aاللغة : عربي.00aحزب 7، عليها زخرفة قرآنية مذهبة بالمينا (سرلوح) في ابتداء السورة، عليها وقفية الحاج حسن اغا بن الاغا ميرزا احمد  لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة القراء واهداء ثواب القراءة الى والديّ الواقف وتوليتها مع الواقف ومن بعده مع الاخوند المجتهد (الشيخ) ملا محمد حسين المعروف بالبركاني وكانت الوقفية بتاريخ 5 ذي الحجة 1297هـ، الختم البيضوي: يا حسن التجاوز 4aقرانvمخطوطات.40uhttps://dromh.org/?view=abe7d84f00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03965ctm a2200337 i b254251261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254251-f4f4723000aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS681 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) إِنَّكَ مَيِّتࣱ وَإِنَّهُم مَّيِّتُونَ30
ثُمَّ إِنَّكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ عِندَ رَبِّكُمۡ تَخۡتَصِمُونَ31
فَمَنۡ أَظۡلَمُ مِمَّن كَذَبَ عَلَى ٱللَّهِ وَكَذَّبَ بِٱلصِّدۡقِ إِذۡ جَآءَهُۥٓۚ أَلَيۡسَ فِي جَهَنَّمَ مَثۡوࣰى لِّلۡكَٰفِرِينَ32
وَٱلَّذِي جَآءَ بِٱلصِّدۡقِ وَصَدَّقَ بِهِۦٓ ۙأُوْلَـٰٓئِكَ هُمُ ٱلۡمُتَّقُونَ33
لَهُم مَّا يَشَآءُونَ عِندَ رَبِّهِمۡۚ ذَٰلِكَ جَزَآءُ ٱلۡمُحۡسِنِينَ3400aاخره : فَوَقَىٰهُ ٱللَّهُ سَيِّـَٔاتِ مَا مَكَرُواْۖ وَحَاقَ بِـَٔالِ فِرۡعَوۡنَ سُوٓءُ ٱلۡعَذَابِ45
ٱلنَّارُ يُعۡرَضُونَ عَلَيۡهَا غُدُوࣰّا وَعَشِيࣰّاۚ وَيَوۡمَ تَقُومُ ٱلسَّاعَةُ أَدۡخِلُوٓاْ ءَالَ فِرۡعَوۡنَ أَشَدَّ ٱلۡعَذَابِ46
وَإِذۡ يَتَحَآجُّونَ فِي ٱلنَّارِ فَيَقُولُ ٱلضُّعَفَـٰٓؤُاْ لِلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا كُنَّا لَكُمۡ تَبَعࣰا فَهَلۡ أَنتُم مُّغۡنُونَ عَنَّا نَصِيبࣰا مِّنَ ٱلنَّارِ47
قَالَ ٱلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا كُلࣱّ فِيهَآ إِنَّ ٱللَّهَ قَدۡ حَكَمَ بَيۡنَ ٱلۡعِبَادِ4800aوقفية الحاج محمد هادي بن الحاج اقا محمد ليكك لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية واهداء ثواب القراءة الى الواقف وتوليتها مع الواقف ومن بعده مع أولاده الذكور وأن لا تبقى في مجالس العزاء لاكثر من 4 ايام وكانت الوقفية بتاريخ شهر شوال 1238هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 68،cايرانgir00aاللغة : عربي.00aوقفية الحاج محمد هادي بن الحاج اقا محمد ليكك لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية واهداء ثواب القراءة الى الواقف وتوليتها مع الواقف ومن بعده مع أولاده الذكور وأن لا تبقى في مجالس العزاء لاكثر من 4 ايام وكانت الوقفية بتاريخ شهر شوال 1238هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=f4f4723000aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04398ctm a2200337 i b254250261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254250-745db13800aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS671 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) وَمَآ أَصَٰبَكُمۡ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِ فَبِإِذۡنِ ٱللَّهِ وَلِيَعۡلَمَ ٱلۡمُؤۡمِنِينَ166
وَلِيَعۡلَمَ ٱلَّذِينَ نَافَقُواْۚ وَقِيلَ لَهُمۡ تَعَالَوۡاْ قَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ أَوِ ٱدۡفَعُواْۖ قَالُواْ لَوۡ نَعۡلَمُ قِتَالࣰا لَّٱتَّبَعۡنَٰكُمۡۗ هُمۡ لِلۡكُفۡرِ يَوۡمَئِذٍ أَقۡرَبُ مِنۡهُمۡ لِلۡإِيمَٰنِۚ يَقُولُونَ بِأَفۡوَٰهِهِم مَّا لَيۡسَ فِي قُلُوبِهِمۡۚ وَٱللَّهُ أَعۡلَمُ بِمَا يَكۡتُمُونَ167
ٱلَّذِينَ قَالُواْ لِإِخۡوَٰنِهِمۡ وَقَعَدُواْ لَوۡ أَطَاعُونَا مَا قُتِلُواْۗ قُلۡ فَٱدۡرَءُواْ عَنۡ أَنفُسِكُمُ ٱلۡمَوۡتَ إِن كُنتُمۡ صَٰدِقِينَ16800aاخره : حُرِّمَتۡ عَلَيۡكُمۡ أُمَّهَٰتُكُمۡ وَبَنَاتُكُمۡ وَأَخَوَٰتُكُمۡ وَعَمَّـٰتُكُمۡ وَخَٰلَٰتُكُمۡ وَبَنَاتُ ٱلۡأَخِ وَبَنَاتُ ٱلۡأُخۡتِ وَأُمَّهَٰتُكُمُ ٱلَّـٰتِيٓ أَرۡضَعۡنَكُمۡ وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَٰعَةِ وَأُمَّهَٰتُ نِسَآئِكُمۡ وَرَبَـٰٓئِبُكُمُ ٱلَّـٰتِي فِي حُجُورِكُم مِّن نِّسَآئِكُمُ ٱلَّـٰتِي دَخَلۡتُم بِهِنَّ فَإِن لَّمۡ تَكُونُواْ دَخَلۡتُم بِهِنَّ فَلَا جُنَاحَ عَلَيۡكُمۡ وَحَلَـٰٓئِلُ أَبۡنَآئِكُمُ ٱلَّذِينَ مِنۡ أَصۡلَٰبِكُمۡ وَأَن تَجۡمَعُواْ بَيۡنَ ٱلۡأُخۡتَيۡنِ إِلَّا مَا قَدۡ سَلَفَۗ إِنَّ ٱللَّهَ كَانَ غَفُورࣰا رَّحِيمࣰا2300aوقفية الحاج محمد هادي بن الحاج اقا محمد ليكك لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية واهداء ثواب القراءة الى الواقف وتوليتها مع الواقف ومن بعده مع أولاده الذكور وأن لا تبقى في مجالس العزاء لاكثر من 4 ايام وكانت الوقفية بتاريخ شهر شوال 1238هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 67،cايرانgir00aاللغة : عربي.00aوقفية الحاج محمد هادي بن الحاج اقا محمد ليكك لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية واهداء ثواب القراءة الى الواقف وتوليتها مع الواقف ومن بعده مع أولاده الذكور وأن لا تبقى في مجالس العزاء لاكثر من 4 ايام وكانت الوقفية بتاريخ شهر شوال 1238هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=745db13800aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04139ctm a2200325 i b254249261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254249-b7dbe27a00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS661 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a10 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَلِلَّذِينَ كَفَرُواْ بِرَبِّهِمۡ عَذَابُ جَهَنَّمَۖ وَبِئۡسَ ٱلۡمَصِيرُ6
إِذَآ أُلۡقُواْ فِيهَا سَمِعُواْ لَهَا شَهِيقࣰا وَهِيَ تَفُورُ7
تَكَادُ تَمَيَّزُ مِنَ ٱلۡغَيۡظِۖ كُلَّمَآ أُلۡقِيَ فِيهَا فَوۡجࣱ سَأَلَهُمۡ خَزَنَتُهَآ أَلَمۡ يَأۡتِكُمۡ نَذِيرࣱ8
قَالُواْ بَلَىٰ قَدۡ جَآءَنَا نَذِيرࣱ فَكَذَّبۡنَا وَقُلۡنَا مَا نَزَّلَ ٱللَّهُ مِن شَيۡءٍ إِنۡ أَنتُمۡ إِلَّا فِي ضَلَٰلࣲ كَبِيرࣲ9
وَقَالُواْ لَوۡ كُنَّا نَسۡمَعُ أَوۡ نَعۡقِلُ مَا كُنَّا فِيٓ أَصۡحَٰبِ ٱلسَّعِيرِ1000aاخره : َقالَ نُوحࣱ رَّبِّ إِنَّهُمۡ عَصَوۡنِي وَٱتَّبَعُواْ مَن لَّمۡ يَزِدۡهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارࣰا21
وَمَكَرُواْ مَكۡرࣰا كُبَّارࣰا22
وَقَالُواْ لَا تَذَرُنَّ ءَالِهَتَكُمۡ وَلَا تَذَرُنَّ وَدࣰّا وَلَا سُوَاعࣰا وَلَا يَغُوثَ وَيَعُوقَ وَنَسۡرࣰا23
وَقَدۡ أَضَلُّواْ كَثِيرࣰاۖ وَلَا تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا ضَلَٰلࣰا24
مِّمَّا خَطِيٓـَٰٔتِهِمۡ أُغۡرِقُواْ فَأُدۡخِلُواْ نَارࣰا00aنصف جزء 29 من القرآن الكريم، وقفية الحاج غلام رضا معتمدي والمرحوم الحاج حسن معتمدي من مدينة رشت لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية في المساجد ومجالس الترحيم واهداء ثواب القراءة الى ارواح المعصومين الاربعة عشر وشيعة امير المؤمنين وروح الواقف وتوليتها مع الواقف ومن بعده مع أولاده وكانت الوقفية بتاريخ 9 رمضان 1344هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 66،cايرانgir00aاللغة : عربي.00aنصف جزء 29 من القرآن الكريم، وقفية الحاج غلام رضا معتمدي والمرحوم الحاج حسن معتمدي من مدينة رشت لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية في المساجد ومجالس الترحيم واهداء ثواب القراءة الى ارواح المعصومين الاربعة عشر وشيعة امير المؤمنين وروح الواقف وتوليتها مع الواقف ومن بعده مع أولاده وكانت الوقفية بتاريخ 9 رمضان 1344هـ 4aقرانvمخطوطات.40uhttps://dromh.org/?view=b7dbe27a00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03821ctm a2200337 i b254248261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254248-11d94adf00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS651 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a6 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) فِيهِ مِن شَيۡءࣲ فَحُكۡمُهُۥٓ إِلَى ٱللَّهِۚ ذَٰلِكُمُ ٱللَّهُ رَبِّي عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ أُنِيبُ10
فَاطِرُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ جَعَلَ لَكُم مِّنۡ أَنفُسِكُمۡ أَزۡوَٰجࣰا وَمِنَ ٱلۡأَنۡعَٰمِ أَزۡوَٰجࣰا يَذۡرَؤُكُمۡ فِيهِۚ لَيۡسَ كَمِثۡلِهِۦ شَيۡءࣱۖ وَهُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ11
لَهُۥ مَقَالِيدُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يَبۡسُطُ ٱلرِّزۡقَ لِمَن يَشَآءُ وَيَقۡدِرُۚ إِنَّهُۥ بِكُلِّ شَيۡءٍ عَلِيمࣱ1200aاخره : وَلَوۡلَآ أَن يَكُونَ ٱلنَّاسُ أُمَّةࣰ وَٰحِدَةࣰ لَّجَعَلۡنَا لِمَن يَكۡفُرُ بِٱلرَّحۡمَٰنِ لِبُيُوتِهِمۡ سُقُفࣰا مِّن فِضَّةࣲ وَمَعَارِجَ عَلَيۡهَا يَظۡهَرُونَ33
وَلِبُيُوتِهِمۡ أَبۡوَٰبࣰا وَسُرُرًا عَلَيۡهَا يَتَّكِـُٔونَ34
وَزُخۡرُفࣰاۚ وَإِن كُلُّ ذَٰلِكَ لَمَّا مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَٱلۡأٓخِرَةُ عِندَ رَبِّكَ لِلۡمُتَّقِينَ35
وَمَن يَعۡشُ عَن ذِكۡرِ ٱلرَّحۡمَٰنِ نُقَيِّضۡ لَهُۥ شَيۡطَٰنࣰا فَهُوَ لَهُۥ قَرِينࣱ3600aوقفية الحاج اقا محمد ليكك لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية واهداء ثواب القراءة الى الواقف وتوليتها معه ومع أولاده الذكور فيما بعد وأن لا يتم بقاءه اكثر من 4 أيام في مجالس العزاء وكانت الوقفية بتاريخ شهر شوال 1238هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 65،cايرانgir00aاللغة : عربي.00aوقفية الحاج اقا محمد ليكك لهذا النصف من جزء القرآن الكريم مع مجموع 59 نصف جزء آخر على كافة قراء الاثني عشرية واهداء ثواب القراءة الى الواقف وتوليتها معه ومع أولاده الذكور فيما بعد وأن لا يتم بقاءه اكثر من 4 أيام في مجالس العزاء وكانت الوقفية بتاريخ شهر شوال 1238هـ00aالنسخة ناقصة الأول. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=11d94adf00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04159ctm a2200337 i b254247261016s1956    xx            000 0 ara d00a(DROMH) dromh-254247-895b9e6300aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 195600c(300aMS641 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1376هـ = [1956]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : مُنِيبِينَ إِلَيۡهِ وَٱتَّقُوهُ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَلَا تَكُونُواْ مِنَ ٱلۡمُشۡرِكِينَ31
مِنَ ٱلَّذِينَ فَرَّقُواْ دِينَهُمۡ وَكَانُواْ شِيَعࣰاۖ كُلُّ حِزۡبِۭ بِمَا لَدَيۡهِمۡ فَرِحُونَ32
وَإِذَا مَسَّ ٱلنَّاسَ ضُرࣱّ دَعَوۡاْ رَبَّهُم مُّنِيبِينَ إِلَيۡهِ ثُمَّ إِذَآ أَذَاقَهُم مِّنۡهُ رَحۡمَةً إِذَا فَرِيقࣱ مِّنۡهُم بِرَبِّهِمۡ يُشۡرِكُونَ33
لِيَكۡفُرُواْ بِمَآ ءَاتَيۡنَٰهُمۡۚ فَتَمَتَّعُواْ فَسَوۡفَ تَعۡلَمُونَ3400aاخره : أَلَمۡ تَرَوۡاْ أَنَّ ٱللَّهَ سَخَّرَ لَكُم مَّا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ وَأَسۡبَغَ عَلَيۡكُمۡ نِعَمَهُۥ ظَٰهِرَةࣰ وَبَاطِنَةࣰۗ وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِي ٱللَّهِ بِغَيۡرِ عِلۡمࣲ وَلَا هُدࣰى وَلَا كِتَٰبࣲ مُّنِيرࣲ20
وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُواْ مَآ أَنزَلَ ٱللَّهُ قَالُواْ بَلۡ نَتَّبِعُ مَا وَجَدۡنَا عَلَيۡهِ ءَابَآءَنَآۚ أَوَلَوۡ كَانَ ٱلشَّيۡطَٰنُ يَدۡعُوهُمۡ إِلَىٰ عَذَابِ ٱلسَّعِيرِ2100aحزب 82، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 64،cايرانgir00aاللغة : عربي.00aحزب 82، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=895b9e6300aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02594ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098000900138100004900147240004200196245007800238264004800316300001500364336003800379337003500417338002900452340004300481500076700524500067801291500001401969535011301983546002702096650003002123856003702153949009002190b254246261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254246-600d70e000aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS631 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a6 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : الٓمٓ1
أَحَسِبَ ٱلنَّاسُ أَن يُتۡرَكُوٓاْ أَن يَقُولُوٓاْ ءَامَنَّا وَهُمۡ لَا يُفۡتَنُونَ2
وَلَقَدۡ فَتَنَّا ٱلَّذِينَ مِن قَبۡلِهِمۡۖ فَلَيَعۡلَمَنَّ ٱللَّهُ ٱلَّذِينَ صَدَقُواْ وَلَيَعۡلَمَنَّ ٱلۡكَٰذِبِينَ3
أَمۡ حَسِبَ ٱلَّذِينَ يَعۡمَلُونَ ٱلسَّيِّـَٔاتِ أَن يَسۡبِقُونَاۚ سَآءَ مَا يَحۡكُمُونَ4
مَن كَانَ يَرۡجُواْ لِقَآءَ ٱللَّهِ فَإِنَّ أَجَلَ ٱللَّهِ لَأٓتࣲۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ500aاخره : يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَوۡفُواْ بِٱلۡعُقُودِۚ أُحِلَّتۡ لَكُم بَهِيمَةُ ٱلۡأَنۡعَٰمِ إِلَّا مَا يُتۡلَىٰ عَلَيۡكُمۡ غَيۡرَ مُحِلِّي ٱلصَّيۡدِ وَأَنتُمۡ حُرُمٌۗ إِنَّ ٱللَّهَ يَحۡكُمُ مَا يُرِيدُ1
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تُحِلُّواْ شَعَـٰٓئِرَ ٱللَّهِ وَلَا ٱلشَّهۡرَ ٱلۡحَرَامَ وَلَا ٱلۡهَدۡيَ وَلَا ٱلۡقَلَـٰٓئِدَ وَلَآ00aحزب 8010aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 63،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=600d70e000aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04230ctm a2200337 i b254245261016s1956    xx            000 0 ara d00a(DROMH) dromh-254245-2b0ae88900aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 195600c(300aMS621 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1376هـ = [1956]00a5 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : لَّيۡسَ عَلَيۡكَ هُدَىٰهُمۡ وَلَٰكِنَّ ٱللَّهَ يَهۡدِي مَن يَشَآءُۗ وَمَا تُنفِقُواْ مِنۡ خَيۡرࣲ فَلِأَنفُسِكُمۡۚ وَمَا تُنفِقُونَ إِلَّا ٱبۡتِغَآءَ وَجۡهِ ٱللَّهِۚ وَمَا تُنفِقُواْ مِنۡ خَيۡرࣲ يُوَفَّ إِلَيۡكُمۡ وَأَنتُمۡ لَا تُظۡلَمُونَ272
لِلۡفُقَرَآءِ ٱلَّذِينَ أُحۡصِرُواْ فِي سَبِيلِ ٱللَّهِ لَا يَسۡتَطِيعُونَ ضَرۡبࣰا فِي ٱلۡأَرۡضِ يَحۡسَبُهُمُ ٱلۡجَاهِلُ أَغۡنِيَآءَ مِنَ ٱلتَّعَفُّفِ تَعۡرِفُهُم بِسِيمَٰهُمۡ لَا يَسۡـَٔلُونَ ٱلنَّاسَ إِلۡحَافࣰاۗ وَمَا تُنفِقُواْ مِنۡ خَيۡرࣲ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ27300aاخره : وَٱللَّهُ يُؤَيِّدُ بِنَصۡرِهِۦ مَن يَشَآءُۚ إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّأُوْلِي ٱلۡأَبۡصَٰرِ13
زُيِّنَ لِلنَّاسِ حُبُّ ٱلشَّهَوَٰتِ مِنَ ٱلنِّسَآءِ وَٱلۡبَنِينَ وَٱلۡقَنَٰطِيرِ ٱلۡمُقَنطَرَةِ مِنَ ٱلذَّهَبِ وَٱلۡفِضَّةِ وَٱلۡخَيۡلِ ٱلۡمُسَوَّمَةِ وَٱلۡأَنۡعَٰمِ وَٱلۡحَرۡثِۗ ذَٰلِكَ مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَٱللَّهُ عِندَهُۥ حُسۡنُ ٱلۡمَـَٔابِ1400aحزب 10، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 62،cايرانgir00aاللغة : عربي.00aحزب 10، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=2b0ae88900aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04648ctm a2200337 i b254244261016s1956    xx            000 0 ara d00a(DROMH) dromh-254244-65e6e3b300aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 195600c(300aMS611 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1376هـ = [1956]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : يَٰنِسَآءَ ٱلنَّبِيِّ لَسۡتُنَّ كَأَحَدࣲ مِّنَ ٱلنِّسَآءِ إِنِ ٱتَّقَيۡتُنَّۚ فَلَا تَخۡضَعۡنَ بِٱلۡقَوۡلِ فَيَطۡمَعَ ٱلَّذِي فِي قَلۡبِهِۦ مَرَضࣱ وَقُلۡنَ قَوۡلࣰا مَّعۡرُوفࣰا32
وَقَرۡنَ فِي بُيُوتِكُنَّ وَلَا تَبَرَّجۡنَ تَبَرُّجَ ٱلۡجَٰهِلِيَّةِ ٱلۡأُولَىٰۖ وَأَقِمۡنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعۡنَ ٱللَّهَ وَرَسُولَهُۥٓۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذۡهِبَ عَنكُمُ ٱلرِّجۡسَ أَهۡلَ ٱلۡبَيۡتِ وَيُطَهِّرَكُمۡ تَطۡهِيرࣰا33
وَٱذۡكُرۡنَ مَا يُتۡلَىٰ فِي بُيُوتِكُنَّ مِنۡ ءَايَٰتِ ٱللَّهِ وَٱلۡحِكۡمَةِۚ إِنَّ ٱللَّهَ كَانَ لَطِيفًا خَبِيرًا3400aاخره : لَّا جُنَاحَ عَلَيۡهِنَّ فِيٓ ءَابَآئِهِنَّ وَلَآ أَبۡنَآئِهِنَّ وَلَآ إِخۡوَٰنِهِنَّ وَلَآ أَبۡنَآءِ إِخۡوَٰنِهِنَّ وَلَآ أَبۡنَآءِ أَخَوَٰتِهِنَّ وَلَا نِسَآئِهِنَّ وَلَا مَا مَلَكَتۡ أَيۡمَٰنُهُنَّۗ وَٱتَّقِينَ ٱللَّهَۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَيۡءࣲ شَهِيدًا55
إِنَّ ٱللَّهَ وَمَلَـٰٓئِكَتَهُۥ يُصَلُّونَ عَلَى ٱلنَّبِيِّۚ يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ صَلُّواْ عَلَيۡهِ وَسَلِّمُواْ تَسۡلِيمًا56
إِنَّ ٱلَّذِينَ يُؤۡذُونَ ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ ٱللَّهُ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِ وَأَعَدَّ لَهُمۡ عَذَابࣰا مُّهِينࣰا5700aحزب 85، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 61،cايرانgir00aاللغة : عربي.00aحزب 85، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aحسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=65e6e3b300aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04460ctm a2200337 i b254243261016s1956    xx            000 0 ara d00a(DROMH) dromh-254243-c5587a3d00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 195600c(300aMS601 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1376هـ = [1956]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَٱلَّذِينَ يُمَسِّكُونَ بِٱلۡكِتَٰبِ وَأَقَامُواْ ٱلصَّلَوٰةَ إِنَّا لَا نُضِيعُ أَجۡرَ ٱلۡمُصۡلِحِينَ170
وَإِذۡ نَتَقۡنَا ٱلۡجَبَلَ فَوۡقَهُمۡ كَأَنَّهُۥ ظُلَّةࣱ وَظَنُّوٓاْ أَنَّهُۥ وَاقِعُۢ بِهِمۡ خُذُواْ مَآ ءَاتَيۡنَٰكُم بِقُوَّةࣲ وَٱذۡكُرُواْ مَا فِيهِ لَعَلَّكُمۡ تَتَّقُونَ171
وَإِذۡ أَخَذَ رَبُّكَ مِنۢ بَنِيٓ ءَادَمَ مِن ظُهُورِهِمۡ ذُرِّيَّتَهُمۡ وَأَشۡهَدَهُمۡ عَلَىٰٓ أَنفُسِهِمۡ أَلَسۡتُ بِرَبِّكُمۡۖ قَالُواْ بَلَىٰ شَهِدۡنَآۚ أَن تَقُولُواْ يَوۡمَ ٱلۡقِيَٰمَةِ إِنَّا كُنَّا عَنۡ هَٰذَا غَٰفِلِينَ172
أَوۡ تَقُولُوٓاْ إِنَّمَآ أَشۡرَكَ ءَابَآؤُنَا مِن قَبۡلُ وَكُنَّا ذُرِّيَّةࣰ مِّنۢ بَعۡدِهِمۡۖ أَفَتُهۡلِكُنَا بِمَا فَعَلَ ٱلۡمُبۡطِلُونَ17300aاخره : يَسۡـَٔلُونَكَ عَنِ ٱلۡأَنفَالِۖ قُلِ ٱلۡأَنفَالُ لِلَّهِ وَٱلرَّسُولِۖ فَٱتَّقُواْ ٱللَّهَ وَأَصۡلِحُواْ ذَاتَ بَيۡنِكُمۡۖ وَأَطِيعُواْ ٱللَّهَ وَرَسُولَهُۥٓ إِن كُنتُم مُّؤۡمِنِينَ1
إِنَّمَا ٱلۡمُؤۡمِنُونَ ٱلَّذِينَ إِذَا ذُكِرَ ٱللَّهُ وَجِلَتۡ قُلُوبُهُمۡ وَإِذَا تُلِيَتۡ عَلَيۡهِمۡ ءَايَٰتُهُۥ زَادَتۡهُمۡ إِيمَٰنࣰا وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ200aحزب 35، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 60،cايرانgir00aاللغة : عربي.00aحزب 35، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aحسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=c5587a3d00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04392ctm a2200337 i b254242261016s1956    xx            000 0 ara d00a(DROMH) dromh-254242-f22a642d00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 195600c(300aMS591 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1376هـ = [1956]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : قُلۡ أَؤُنَبِّئُكُم بِخَيۡرࣲ مِّن ذَٰلِكُمۡۖ لِلَّذِينَ ٱتَّقَوۡاْ عِندَ رَبِّهِمۡ جَنَّـٰتࣱ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا وَأَزۡوَٰجࣱ مُّطَهَّرَةࣱ وَرِضۡوَٰنࣱ مِّنَ ٱللَّهِۗ وَٱللَّهُ بَصِيرُۢ بِٱلۡعِبَادِ15
ٱلَّذِينَ يَقُولُونَ رَبَّنَآ إِنَّنَآ ءَامَنَّا فَٱغۡفِرۡ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ ٱلنَّارِ16
ٱلصَّـٰبِرِينَ وَٱلصَّـٰدِقِينَ وَٱلۡقَٰنِتِينَ وَٱلۡمُنفِقِينَ وَٱلۡمُسۡتَغۡفِرِينَ بِٱلۡأَسۡحَارِ1700aاخره : ٱلطَّيۡرِ فَأَنفُخُ فِيهِ فَيَكُونُ طَيۡرَۢا بِإِذۡنِ ٱللَّهِۖ وَأُبۡرِئُ ٱلۡأَكۡمَهَ وَٱلۡأَبۡرَصَ وَأُحۡيِ ٱلۡمَوۡتَىٰ بِإِذۡنِ ٱللَّهِۖ وَأُنَبِّئُكُم بِمَا تَأۡكُلُونَ وَمَا تَدَّخِرُونَ فِي بُيُوتِكُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَ49
وَمُصَدِّقࣰا لِّمَا بَيۡنَ يَدَيَّ مِنَ ٱلتَّوۡرَىٰةِ وَلِأُحِلَّ لَكُم بَعۡضَ ٱلَّذِي حُرِّمَ عَلَيۡكُمۡۚ وَجِئۡتُكُم بِـَٔايَةࣲ مِّن رَّبِّكُمۡ فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ50
إِنَّ ٱللَّهَ رَبِّي وَرَبُّكُمۡ فَٱعۡبُدُوهُۚ هَٰذَا صِرَٰطࣱ مُّسۡتَقِيمࣱ5100aحزب 11، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 59،cايرانgir00aاللغة : عربي.00aحزب 11، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aالكاتب والواقف حسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=f22a642d00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران05191ctm a2200325 i b254241261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254241-96d8943c00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS581 aكلام الله (عز وجل)،eمؤلف.10aنصف جزء من القرآن الكريم10aنصف جزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a10 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : فَلَمَّا عَتَوۡاْ عَن مَّا نُهُواْ عَنۡهُ قُلۡنَا لَهُمۡ كُونُواْ قِرَدَةً خَٰسِـِٔينَ166
وَإِذۡ تَأَذَّنَ رَبُّكَ لَيَبۡعَثَنَّ عَلَيۡهِمۡ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ مَن يَسُومُهُمۡ سُوٓءَ ٱلۡعَذَابِۗ إِنَّ رَبَّكَ لَسَرِيعُ ٱلۡعِقَابِ وَإِنَّهُۥ لَغَفُورࣱ رَّحِيمࣱ167
وَقَطَّعۡنَٰهُمۡ فِي ٱلۡأَرۡضِ أُمَمࣰاۖ مِّنۡهُمُ ٱلصَّـٰلِحُونَ وَمِنۡهُمۡ دُونَ ذَٰلِكَۖ وَبَلَوۡنَٰهُم بِٱلۡحَسَنَٰتِ وَٱلسَّيِّـَٔاتِ لَعَلَّهُمۡ يَرۡجِعُونَ16800aاخره : قُل لِّلَّذِينَ كَفَرُوٓاْ إِن يَنتَهُواْ يُغۡفَرۡ لَهُم مَّا قَدۡ سَلَفَ وَإِن يَعُودُواْ فَقَدۡ مَضَتۡ سُنَّتُ ٱلۡأَوَّلِينَ38
وَقَٰتِلُوهُمۡ حَتَّىٰ لَا تَكُونَ فِتۡنَةࣱ وَيَكُونَ ٱلدِّينُ كُلُّهُۥ لِلَّهِۚ فَإِنِ ٱنتَهَوۡاْ فَإِنَّ ٱللَّهَ بِمَا يَعۡمَلُونَ بَصِيرࣱ39
وَإِن تَوَلَّوۡاْ فَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَوۡلَىٰكُمۡۚ نِعۡمَ ٱلۡمَوۡلَىٰ وَنِعۡمَ ٱلنَّصِيرُ40
وَٱعۡلَمُوٓاْ أَنَّمَا غَنِمۡتُم مِّن شَيۡءࣲ فَأَنَّ لِلَّهِ خُمُسَهُۥ وَلِلرَّسُولِ وَلِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِ إِن كُنتُمۡ ءَامَنتُم بِٱللَّهِ وَمَآ أَنزَلۡنَا عَلَىٰ عَبۡدِنَا يَوۡمَ ٱلۡفُرۡقَانِ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءࣲ قَدِيرٌ4100aنصف جزء، وقفية غلام رضا خان لهذا النصف من جزء القرآن الكريم البالغ مجموعه 59 نصف جزء  على كافة المؤمنين والمسلمين لتلاوته عند الضرورة واللزوم واهداء ثواب القراءة لوالديّ الواقف والتولية هي على الواقف وما بعده على أولاده  الذكور واولاد أولاده فيما بعد وفي حال الانقراض تنتقل التولية الى اولاد الاناث وفيما بعد الانقراض تنتقل التولية الى المجتهد الجامع للشرائط في زمانه  وكانت الوقفية بتاريخ شهر محرم الحرام 1295هـ  (الجزء الاعلى من الوقفية ورقته مقصوصه من المنتصف بشكل مربع ما أدى الى اخفاء ثلاثة أسطر الاولى من الوقفية)10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 58،cايرانgir00aاللغة : عربي.00aنصف جزء، وقفية غلام رضا خان لهذا النصف من جزء القرآن الكريم البالغ مجموعه 59 نصف جزء  على كافة المؤمنين والمسلمين لتلاوته عند الضرورة واللزوم واهداء ثواب القراءة لوالديّ الواقف والتولية هي على الواقف وما بعده على أولاده  الذكور واولاد أولاده فيما بعد وفي حال الانقراض تنتقل التولية الى اولاد الاناث وفيما بعد الانقراض تنتقل التولية الى المجتهد الجامع للشرائط في زمانه  وكانت الوقفية بتاريخ شهر محرم الحرام 1295هـ  (الجزء الاعلى من الوقفية ورقته مقصوصه من المنتصف بشكل مربع ما أدى الى اخفاء ثلاثة أسطر الاولى من الوقفية) 4aقرانvمخطوطات.40uhttps://dromh.org/?view=96d8943c00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04493ctm a2200337 i b254240261016s1956    xx            000 0 ara d00a(DROMH) dromh-254240-c4be6e1800aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 195600c(300aMS571 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1376هـ = [1956]00a4 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَإِيَّـٰيَ فَٱرۡهَبُونِ40
وَءَامِنُواْ بِمَآ أَنزَلۡتُ مُصَدِّقࣰا لِّمَا مَعَكُمۡ وَلَا تَكُونُوٓاْ أَوَّلَ كَافِرِۭ بِهِۦۖ وَلَا تَشۡتَرُواْ بِـَٔايَٰتِي ثَمَنࣰا قَلِيلࣰا وَإِيَّـٰيَ فَٱتَّقُونِ41
وَلَا تَلۡبِسُواْ ٱلۡحَقَّ بِٱلۡبَٰطِلِ وَتَكۡتُمُواْ ٱلۡحَقَّ وَأَنتُمۡ تَعۡلَمُونَ42
وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ وَٱرۡكَعُواْ مَعَ ٱلرَّـٰكِعِينَ43
أَتَأۡمُرُونَ ٱلنَّاسَ بِٱلۡبِرِّ وَتَنسَوۡنَ أَنفُسَكُمۡ وَأَنتُمۡ تَتۡلُونَ ٱلۡكِتَٰبَۚ أَفَلَا تَعۡقِلُونَ44
وَٱسۡتَعِينُواْ بِٱلصَّبۡرِ وَٱلصَّلَوٰةِۚ وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى ٱلۡخَٰشِعِينَ4500aاخره : مَّا كُنتُمۡ تَكۡتُمُونَ72
فَقُلۡنَا ٱضۡرِبُوهُ بِبَعۡضِهَاۚ كَذَٰلِكَ يُحۡيِ ٱللَّهُ ٱلۡمَوۡتَىٰ وَيُرِيكُمۡ ءَايَٰتِهِۦ لَعَلَّكُمۡ تَعۡقِلُونَ73
ثُمَّ قَسَتۡ قُلُوبُكُم مِّنۢ بَعۡدِ ذَٰلِكَ فَهِيَ كَٱلۡحِجَارَةِ أَوۡ أَشَدُّ قَسۡوَةࣰۚ وَإِنَّ مِنَ ٱلۡحِجَارَةِ لَمَا يَتَفَجَّرُ مِنۡهُ ٱلۡأَنۡهَٰرُۚ وَإِنَّ مِنۡهَا لَمَا يَشَّقَّقُ فَيَخۡرُجُ مِنۡهُ ٱلۡمَآءُۚ وَإِنَّ مِنۡهَا لَمَا يَهۡبِطُ مِنۡ خَشۡيَةِ ٱللَّهِۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ7400aحزب 2، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 57،cايرانgir00aاللغة : عربي.00aحزب 2، وردت وقفية للكاتب والواقف حسين قرآنيان في نهاية الحزب القرآني نصها: أن هذا الحزب هو حزب من مجموع 119 حزب قرآني آخر وهي موقوفة وقفاً شرعياً على مجالس الترحيم لقراءتها في تلك المجالس وأن لا تبقى في تلك المجالس أكثر من ثلاثة أيام وتكون التولية على يد الواقف الاقل حسين قرآنيان وبعده تنتقل التولية الى أكثر أولاده التزاماً بالدين أو من يتم اختياره وتعيينه بذلك 4aقرانvمخطوطات.10aحسين قرآنيان،eناسخ.40uhttps://dromh.org/?view=c4be6e1800aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران01997ctm a2200325 i b254239261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254239-ecdb327900aIQ-KaCCSbaracIQ-KaCCSerda04aBP183.3b.M3600c(300aMS561 aعضدالدين الايجي، عبدالرحمن بن احمد،dتوفي 756 هجري،eمؤلف.10aشرح مختصر الاصول10aشرح مختصر الاصول = شرح مختصر المنتهي /cعضدالدين الايجي، عبدالرحمن بن احمد (ت756هـ).33aشرح مختصر المنتهي00c[تاريخ الانتاج غير محدد]00a57 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : (ناقص) معه اتفاق قال و الجواب أقول لما فرغ من بحث النقض  بجزاية بين وجه الجواب و هو بيداء المانع اعني بيان وجود معارض.00aاخره : (ناقص) وإباحة النكاح بغير ولي ولا شهود ولا مهر وغيرها  قلنا  كالمريض و