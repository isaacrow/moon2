إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ4
فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ5
خُلِقَ مِن مَّآءࣲ دَافِقࣲ600aوقفية محمد صادق بن اقا محمد علي الاصفهاني لهذا المصحف الشريف على كافة المؤمنين من الشيعة الاثني عشرية والتولية مع الواقف بتاريخ شهر رمضان 1259هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 181،cايرانgir00aاللغة : عربي.00aوقفية محمد صادق بن اقا محمد علي الاصفهاني لهذا المصحف الشريف على كافة المؤمنين من الشيعة الاثني عشرية والتولية مع الواقف بتاريخ شهر رمضان 1259هـ 4aقرانvمخطوطات.40uhttps://dromh.org/?view=a5a1b9f700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03544ctm a2200325 i b254364261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254364-bb5edd3b00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1801 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a13 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : بَقِيَّتُ ٱللَّهِ خَيۡرࣱ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَۚ وَمَآ أَنَا۠ عَلَيۡكُم بِحَفِيظࣲ86
قَالُواْ يَٰشُعَيۡبُ أَصَلَوٰتُكَ تَأۡمُرُكَ أَن نَّتۡرُكَ مَا يَعۡبُدُ ءَابَآؤُنَآ أَوۡ أَن نَّفۡعَلَ فِيٓ أَمۡوَٰلِنَا مَا نَشَـٰٓؤُاْۖ إِنَّكَ لَأَنتَ ٱلۡحَلِيمُ ٱلرَّشِيدُ87
قَالَ يَٰقَوۡمِ أَرَءَيۡتُمۡ إِن كُنتُ عَلَىٰ بَيِّنَةࣲ مِّن رَّبِّي وَرَزَقَنِي مِنۡهُ رِزۡقًا حَسَنࣰاۚ وَمَآ أُرِيدُ أَنۡ أُخَالِفَكُمۡ إِلَىٰ مَآ أَنۡهَىٰكُمۡ عَنۡهُۚ إِنۡ أُرِيدُ إِلَّا ٱلۡإِصۡلَٰحَ مَا ٱسۡتَطَعۡتُۚ وَمَا تَوۡفِيقِيٓ00aاخره : فِي سُنۢبُلِهِۦٓ إِلَّا قَلِيلࣰا مِّمَّا تَأۡكُلُونَ47
ثُمَّ يَأۡتِي مِنۢ بَعۡدِ ذَٰلِكَ سَبۡعࣱ شِدَادࣱ يَأۡكُلۡنَ مَا قَدَّمۡتُمۡ لَهُنَّ إِلَّا قَلِيلࣰا مِّمَّا تُحۡصِنُونَ48
ثُمَّ يَأۡتِي مِنۢ بَعۡدِ ذَٰلِكَ عَامࣱ فِيهِ يُغَاثُ ٱلنَّاسُ وَفِيهِ يَعۡصِرُونَ49
وَقَالَ ٱلۡمَلِكُ ٱئۡتُونِي بِهِۦۖ فَلَمَّا جَآءَهُ ٱلرَّسُولُ قَالَ ٱرۡجِعۡ إِلَىٰ رَبِّكَ فَسۡـَٔلۡهُ مَا بَالُ ٱلنِّسۡوَةِ ٱلَّـٰتِي قَطَّعۡنَ أَيۡدِيَهُنَّۚ إِنَّ رَبِّي بِكَيۡدِهِنَّ عَلِيمࣱ5000aوقفية محمد صادق بن اقا محمد علي الاصفهاني لهذا المصحف الشريف على كافة المؤمنين من الشيعة الاثني عشرية والتولية مع الواقف بتاريخ شهر رمضان 1259هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 180،cايرانgir00aاللغة : عربي.00aوقفية محمد صادق بن اقا محمد علي الاصفهاني لهذا المصحف الشريف على كافة المؤمنين من الشيعة الاثني عشرية والتولية مع الواقف بتاريخ شهر رمضان 1259هـ 4aقرانvمخطوطات.40uhttps://dromh.org/?view=bb5edd3b00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02466ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500098600525500035501511535011401866546002701980650003002007856003702037949009002074b254363261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254363-9455d8e600aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1791 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : عَبۡدَهُۥۖ وَيُخَوِّفُونَكَ بِٱلَّذِينَ مِن دُونِهِۦۚ وَمَن يُضۡلِلِ ٱللَّهُ فَمَا لَهُۥ مِنۡ هَادࣲ36
وَمَن يَهۡدِ ٱللَّهُ فَمَا لَهُۥ مِن مُّضِلٍّۗ أَلَيۡسَ ٱللَّهُ بِعَزِيزࣲ ذِي ٱنتِقَامࣲ37
وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ ٱللَّهُۚ قُلۡ أَفَرَءَيۡتُم مَّا تَدۡعُونَ مِن دُونِ ٱللَّهِ إِنۡ أَرَادَنِيَ ٱللَّهُ بِضُرٍّ هَلۡ هُنَّ كَٰشِفَٰتُ ضُرِّهِۦٓ أَوۡ أَرَادَنِي بِرَحۡمَةٍ هَلۡ هُنَّ مُمۡسِكَٰتُ رَحۡمَتِهِۦۚ قُلۡ حَسۡبِيَ ٱللَّهُۖ عَلَيۡهِ يَتَوَكَّلُ ٱلۡمُتَوَكِّلُونَ3800aاخره : ي ٱلۡبِلَٰدِ4
كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحࣲ وَٱلۡأَحۡزَابُ مِنۢ بَعۡدِهِمۡۖ وَهَمَّتۡ كُلُّ أُمَّةِۭ بِرَسُولِهِمۡ لِيَأۡخُذُوهُۖ وَجَٰدَلُواْ بِٱلۡبَٰطِلِ لِيُدۡحِضُواْ بِهِ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 179،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=9455d8e600aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03126ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500103300525500096801558535011402526546002702640650003002667856003702697949009002734b254362261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254362-c78224ce00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1781 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a5 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : مَا كَانَ لِلنَّبِيِّ وَٱلَّذِينَ ءَامَنُوٓاْ أَن يَسۡتَغۡفِرُواْ لِلۡمُشۡرِكِينَ وَلَوۡ كَانُوٓاْ أُوْلِي قُرۡبَىٰ مِنۢ بَعۡدِ مَا تَبَيَّنَ لَهُمۡ أَنَّهُمۡ أَصۡحَٰبُ ٱلۡجَحِيمِ113
وَمَا كَانَ ٱسۡتِغۡفَارُ إِبۡرَٰهِيمَ لِأَبِيهِ إِلَّا عَن مَّوۡعِدَةࣲ وَعَدَهَآ إِيَّاهُ فَلَمَّا تَبَيَّنَ لَهُۥٓ أَنَّهُۥ عَدُوࣱّ لِّلَّهِ تَبَرَّأَ مِنۡهُۚ إِنَّ إِبۡرَٰهِيمَ لَأَوَّـٰهٌ حَلِيمࣱ114
وَمَا كَانَ ٱللَّهُ لِيُضِلَّ قَوۡمَۢا بَعۡدَ إِذۡ هَدَىٰهُمۡ حَتَّىٰ يُبَيِّنَ لَهُم مَّا يَتَّقُونَۚ إِنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمٌ115
إِنَّ ٱللَّهَ00aاخره : إِذۡنِهِۦۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمۡ فَٱعۡبُدُوهُۚ أَفَلَا تَذَكَّرُونَ3
إِلَيۡهِ مَرۡجِعُكُمۡ جَمِيعࣰاۖ وَعۡدَ ٱللَّهِ حَقًّاۚ إِنَّهُۥ يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ لِيَجۡزِيَ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ بِٱلۡقِسۡطِۚ وَٱلَّذِينَ كَفَرُواْ لَهُمۡ شَرَابࣱ مِّنۡ حَمِيمࣲ وَعَذَابٌ أَلِيمُۢ بِمَا كَانُواْ يَكۡفُرُونَ4
هُوَ ٱلَّذِي جَعَلَ ٱلشَّمۡسَ ضِيَآءࣰ وَٱلۡقَمَرَ نُورࣰا وَقَدَّرَهُۥ مَنَازِلَ لِتَعۡلَمُواْ عَدَدَ ٱلسِّنِينَ وَٱلۡحِسَابَۚ مَا خَلَقَ ٱللَّهُ ذَٰلِكَ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 178،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=c78224ce00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02771ctm a2200301 i 4500001000800000008004100008035003400049040003300083050002000116066000700136098001000143100004900153240004200202245007800244264002200322300001600344336003800360337003500398338002900433340004300462500114300505500052301648535011402171546002702285650003002312856003702342949009002379b254361261016s1855    xx            000 0 ara d00a(DROMH) dromh-254361-dc5bc69200aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 185500c(300aMS1771 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1272هـ = [1855]00a11 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : فَسَتَذۡكُرُونَ مَآ أَقُولُ لَكُمۡۚ وَأُفَوِّضُ أَمۡرِيٓ إِلَى ٱللَّهِۚ إِنَّ ٱللَّهَ بَصِيرُۢ بِٱلۡعِبَادِ44
فَوَقَىٰهُ ٱللَّهُ سَيِّـَٔاتِ مَا مَكَرُواْۖ وَحَاقَ بِـَٔالِ فِرۡعَوۡنَ سُوٓءُ ٱلۡعَذَابِ45
ٱلنَّارُ يُعۡرَضُونَ عَلَيۡهَا غُدُوࣰّا وَعَشِيࣰّاۚ وَيَوۡمَ تَقُومُ ٱلسَّاعَةُ أَدۡخِلُوٓاْ ءَالَ فِرۡعَوۡنَ أَشَدَّ ٱلۡعَذَابِ46
وَإِذۡ يَتَحَآجُّونَ فِي ٱلنَّارِ فَيَقُولُ ٱلضُّعَفَـٰٓؤُاْ لِلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا كُنَّا لَكُمۡ تَبَعࣰا فَهَلۡ أَنتُم مُّغۡنُونَ عَنَّا نَصِيبࣰا مِّنَ ٱلنَّارِ47
قَالَ ٱلَّذِينَ ٱسۡتَكۡبَرُوٓاْ إِنَّا كُلࣱّ فِيهَآ إِنَّ ٱللَّهَ قَدۡ حَكَمَ بَيۡنَ00aاخره : وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ فَٱخۡتُلِفَ فِيهِۚ وَلَوۡلَا كَلِمَةࣱ سَبَقَتۡ مِن رَّبِّكَ لَقُضِيَ بَيۡنَهُمۡۚ وَإِنَّهُمۡ لَفِي شَكࣲّ مِّنۡهُ مُرِيبࣲ45
مَّنۡ عَمِلَ صَٰلِحࣰا فَلِنَفۡسِهِۦۖ وَمَنۡ أَسَآءَ فَعَلَيۡهَاۗ وَمَا رَبُّكَ بِظَلَّـٰمࣲ لِّلۡعَبِيدِ4610aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 177،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=dc5bc69200aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03248ctm a2200301 i 4500001000800000008004100008035003400049040003300083050002000116066000700136098001000143100004900153240004200202245007800244264002200322300001600344336003800360337003500398338002900433340004300462500073700505500140601242535011402648546002702762650003002789856003702819949009002856b254360261016s1855    xx            000 0 ara d00a(DROMH) dromh-254360-4a8381f800aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M36 185500c(300aMS1761 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c1272هـ = [1855]00a11 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَٱعۡلَمُوٓاْ أَنَّمَا غَنِمۡتُم مِّن شَيۡءࣲ فَأَنَّ لِلَّهِ خُمُسَهُۥ وَلِلرَّسُولِ وَلِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِ إِن كُنتُمۡ ءَامَنتُم بِٱللَّهِ وَمَآ أَنزَلۡنَا عَلَىٰ عَبۡدِنَا يَوۡمَ ٱلۡفُرۡقَانِ يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءࣲ قَدِيرٌ41
إِذۡ أَنتُم بِٱلۡعُدۡوَةِ ٱلدُّنۡيَا وَهُم بِٱلۡعُدۡوَةِ ٱلۡقُصۡوَىٰ00aاخره : شَآءَۚ إِنَّ ٱللَّهَ عَلِيمٌ حَكِيمࣱ28
قَٰتِلُواْ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱللَّهِ وَلَا بِٱلۡيَوۡمِ ٱلۡأٓخِرِ وَلَا يُحَرِّمُونَ مَا حَرَّمَ ٱللَّهُ وَرَسُولُهُۥ وَلَا يَدِينُونَ دِينَ ٱلۡحَقِّ مِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ حَتَّىٰ يُعۡطُواْ ٱلۡجِزۡيَةَ عَن يَدࣲ وَهُمۡ صَٰغِرُونَ29
وَقَالَتِ ٱلۡيَهُودُ عُزَيۡرٌ ٱبۡنُ ٱللَّهِ وَقَالَتِ ٱلنَّصَٰرَى ٱلۡمَسِيحُ ٱبۡنُ ٱللَّهِۖ ذَٰلِكَ قَوۡلُهُم بِأَفۡوَٰهِهِمۡۖ يُضَٰهِـُٔونَ قَوۡلَ ٱلَّذِينَ كَفَرُواْ مِن قَبۡلُۚ قَٰتَلَهُمُ ٱللَّهُۖ أَنَّىٰ يُؤۡفَكُونَ30
ٱتَّخَذُوٓاْ أَحۡبَارَهُمۡ وَرُهۡبَٰنَهُمۡ أَرۡبَابࣰا مِّن دُونِ ٱللَّهِ وَٱلۡمَسِيحَ ٱبۡنَ مَرۡيَمَ وَمَآ أُمِرُوٓاْ إِلَّا لِيَعۡبُدُوٓاْ إِلَٰهࣰا وَٰحِدࣰاۖ لَّآ إِلَٰهَ إِلَّا هُوَۚ سُبۡحَٰنَهُۥ عَمَّا يُشۡرِكُونَ3110aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 176،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=4a8381f800aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران04375ctm a2200325 i b254359261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254359-8c4bc3c600aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1751 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a7 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ
يُسَبِّحُ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ ٱلۡمَلِكِ ٱلۡقُدُّوسِ ٱلۡعَزِيزِ ٱلۡحَكِيمِ1
هُوَ ٱلَّذِي بَعَثَ فِي ٱلۡأُمِّيِّـۧنَ رَسُولࣰا مِّنۡهُمۡ يَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِهِۦ وَيُزَكِّيهِمۡ وَيُعَلِّمُهُمُ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَإِن كَانُواْ مِن قَبۡلُ لَفِي ضَلَٰلࣲ مُّبِينࣲ2
وَءَاخَرِينَ مِنۡهُمۡ لَمَّا يَلۡحَقُواْ بِهِمۡۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ3
ذَٰلِكَ فَضۡلُ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ400aاخره : إِنَّكَ عَلَىٰ كُلِّ شَيۡءࣲ قَدِيرࣱ8
يَـٰٓأَيُّهَا ٱلنَّبِيُّ جَٰهِدِ ٱلۡكُفَّارَ وَٱلۡمُنَٰفِقِينَ وَٱغۡلُظۡ عَلَيۡهِمۡۚ وَمَأۡوَىٰهُمۡ جَهَنَّمُۖ وَبِئۡسَ ٱلۡمَصِيرُ9
ضَرَبَ ٱللَّهُ مَثَلࣰا لِّلَّذِينَ كَفَرُواْ ٱمۡرَأَتَ نُوحࣲ وَٱمۡرَأَتَ لُوطࣲۖ كَانَتَا تَحۡتَ عَبۡدَيۡنِ مِنۡ عِبَادِنَا صَٰلِحَيۡنِ فَخَانَتَاهُمَا فَلَمۡ يُغۡنِيَا عَنۡهُمَا مِنَ ٱللَّهِ شَيۡـࣰٔا وَقِيلَ ٱدۡخُلَا ٱلنَّارَ مَعَ ٱلدَّـٰخِلِينَ10
وَضَرَبَ ٱللَّهُ مَثَلࣰا لِّلَّذِينَ ءَامَنُواْ ٱمۡرَأَتَ فِرۡعَوۡنَ إِذۡ قَالَتۡ رَبِّ ٱبۡنِ لِي عِندَكَ بَيۡتࣰا فِي ٱلۡجَنَّةِ وَنَجِّنِي مِن فِرۡعَوۡنَ وَعَمَلِهِۦ وَنَجِّنِي مِنَ ٱلۡقَوۡمِ ٱلظَّـٰلِمِينَ11
وَمَرۡيَمَ ٱبۡنَتَ عِمۡرَٰنَ ٱلَّتِيٓ أَحۡصَنَتۡ فَرۡجَهَا فَنَفَخۡنَا فِيهِ مِن رُّوحِنَا وَصَدَّقَتۡ بِكَلِمَٰتِ رَبِّهَا وَكُتُبِهِۦ وَكَانَتۡ مِنَ ٱلۡقَٰنِتِينَ1200aوقفية الحاجة ملا خورشيد روضه خون صبية المرحوم ملا دوست محمد روشن آبادي لهذا المصحف الشريف على كافة المؤمنين الاثني عشرية والتولية مع الواقفة ومن بعدها الى الملا إبراهيم روضه خوان بتاريخ 25 شهر رجب 1292هـ10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 175،cايرانgir00aاللغة : عربي.00aوقفية الحاجة ملا خورشيد روضه خون صبية المرحوم ملا دوست محمد روشن آبادي لهذا المصحف الشريف على كافة المؤمنين الاثني عشرية والتولية مع الواقفة ومن بعدها الى الملا إبراهيم روضه خوان بتاريخ 25 شهر رجب 1292هـ 4aقرانvمخطوطات.40uhttps://dromh.org/?view=8c4bc3c600aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03506ctm a2200325 i b254358261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254358-8f6d519c00aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1741 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a8 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَهُوَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ فِي سِتَّةِ أَيَّامࣲ وَكَانَ عَرۡشُهُۥ عَلَى ٱلۡمَآءِ لِيَبۡلُوَكُمۡ أَيُّكُمۡ أَحۡسَنُ عَمَلࣰاۗ وَلَئِن قُلۡتَ إِنَّكُم مَّبۡعُوثُونَ مِنۢ بَعۡدِ ٱلۡمَوۡتِ لَيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ مُّبِينࣱ7
وَلَئِنۡ أَخَّرۡنَا عَنۡهُمُ ٱلۡعَذَابَ إِلَىٰٓ أُمَّةࣲ مَّعۡدُودَةࣲ لَّيَقُولُنَّ مَا يَحۡبِسُهُۥٓۗ أَلَا يَوۡمَ يَأۡتِيهِمۡ لَيۡسَ مَصۡرُوفًا عَنۡهُمۡ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ8
وَلَئِنۡ أَذَقۡنَا ٱلۡإِنسَٰنَ مِنَّا رَحۡمَةࣰ ثُمَّ نَزَعۡنَٰهَا مِنۡهُ إِنَّهُۥ لَيَـُٔوسࣱ كَفُورࣱ900aاخره : قَالُواْ يَٰلُوطُ إِنَّا رُسُلُ رَبِّكَ لَن يَصِلُوٓاْ إِلَيۡكَۖ فَأَسۡرِ بِأَهۡلِكَ بِقِطۡعࣲ مِّنَ ٱلَّيۡلِ وَلَا يَلۡتَفِتۡ مِنكُمۡ أَحَدٌ إِلَّا ٱمۡرَأَتَكَۖ إِنَّهُۥ مُصِيبُهَا مَآ أَصَابَهُمۡۚ إِنَّ مَوۡعِدَهُمُ ٱلصُّبۡحُۚ أَلَيۡسَ ٱلصُّبۡحُ بِقَرِيبࣲ81
فَلَمَّا جَآءَ أَمۡرُنَا جَعَلۡنَا عَٰلِيَهَا سَافِلَهَا وَأَمۡطَرۡنَا عَلَيۡهَا حِجَارَةࣰ مِّن سِجِّيلࣲ مَّنضُودࣲ82
مُّسَوَّمَةً عِندَ رَبِّكَۖ وَمَا هِيَ مِنَ ٱلظَّـٰلِمِينَ بِبَعِيدࣲ8300aوقفية امير تيمور بن نواب ملك آرا على عوام الاثني عشرية، الختم البيضوي: (المتوكل على الله عبده تيمور)10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 174،cايرانgir00aاللغة : عربي.00aوقفية امير تيمور بن نواب ملك آرا على عوام الاثني عشرية، الختم البيضوي: (المتوكل على الله عبده تيمور) 4aقرانvمخطوطات.40uhttps://dromh.org/?view=8f6d519c00aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران02999ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001600365336003800381337003500419338002900454340004300483500106900526500080401595535011402399546002702513650003002540856003702570949009002607b254357261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254357-ca9cc42700aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1731 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a19 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : لِقَوۡمِكَۖ وَسَوۡفَ تُسۡـَٔلُونَ44
وَسۡـَٔلۡ مَنۡ أَرۡسَلۡنَا مِن قَبۡلِكَ مِن رُّسُلِنَآ أَجَعَلۡنَا مِن دُونِ ٱلرَّحۡمَٰنِ ءَالِهَةࣰ يُعۡبَدُونَ45
وَلَقَدۡ أَرۡسَلۡنَا مُوسَىٰ بِـَٔايَٰتِنَآ إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦ فَقَالَ إِنِّي رَسُولُ رَبِّ ٱلۡعَٰلَمِينَ46
فَلَمَّا جَآءَهُم بِـَٔايَٰتِنَآ إِذَا هُم مِّنۡهَا يَضۡحَكُونَ47
وَمَا نُرِيهِم مِّنۡ ءَايَةٍ إِلَّا هِيَ أَكۡبَرُ مِنۡ أُخۡتِهَاۖ وَأَخَذۡنَٰهُم بِٱلۡعَذَابِ لَعَلَّهُمۡ يَرۡجِعُونَ48
وَقَالُواْ يَـٰٓأَيُّهَ ٱلسَّاحِرُ ٱدۡعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَ إِنَّنَا لَمُهۡتَدُونَ4900aاخره : يُمِيتُنِي ثُمَّ يُحۡيِينِ81
وَٱلَّذِيٓ أَطۡمَعُ أَن يَغۡفِرَ لِي خَطِيٓـَٔتِي يَوۡمَ ٱلدِّينِ82
رَبِّ هَبۡ لِي حُكۡمࣰا وَأَلۡحِقۡنِي بِٱلصَّـٰلِحِينَ83
وَٱجۡعَل لِّي لِسَانَ صِدۡقࣲ فِي ٱلۡأٓخِرِينَ84
وَٱجۡعَلۡنِي مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ85
وَٱغۡفِرۡ لِأَبِيٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ86
وَلَا تُخۡزِنِي يَوۡمَ يُبۡعَثُونَ87
يَوۡمَ لَا يَنفَعُ مَالࣱ وَلَا بَنُونَ88
إِلَّا مَنۡ أَتَى ٱللَّهَ بِقَلۡبࣲ سَلِيمࣲ8910aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 173،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=ca9cc42700aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03472ctm a2200313 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001500365336003800380337003500418338002900453340004300482500133600525500095401861500004502815535011402860546002702974650003003001856003703031949009003068b254356261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254356-e96c41c500aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1721 aكلام الله (عز وجل)،eمؤلف.10aجزء من القرآن الكريم10aجزء من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a8 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : إِذۡ أَنتُم بِٱلۡعُدۡوَةِ ٱلدُّنۡيَا وَهُم بِٱلۡعُدۡوَةِ ٱلۡقُصۡوَىٰ وَٱلرَّكۡبُ أَسۡفَلَ مِنكُمۡۚ وَلَوۡ تَوَاعَدتُّمۡ لَٱخۡتَلَفۡتُمۡ فِي ٱلۡمِيعَٰدِۙ وَلَٰكِن لِّيَقۡضِيَ ٱللَّهُ أَمۡرࣰا كَانَ مَفۡعُولࣰا لِّيَهۡلِكَ مَنۡ هَلَكَ عَنۢ بَيِّنَةࣲ وَيَحۡيَىٰ مَنۡ حَيَّ عَنۢ بَيِّنَةࣲۗ وَإِنَّ ٱللَّهَ لَسَمِيعٌ عَلِيمٌ42
إِذۡ يُرِيكَهُمُ ٱللَّهُ فِي مَنَامِكَ قَلِيلࣰاۖ وَلَوۡ أَرَىٰكَهُمۡ كَثِيرࣰا لَّفَشِلۡتُمۡ وَلَتَنَٰزَعۡتُمۡ فِي ٱلۡأَمۡرِ وَلَٰكِنَّ ٱللَّهَ سَلَّمَۚ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ43
وَإِذۡ يُرِيكُمُوهُمۡ إِذِ ٱلۡتَقَيۡتُمۡ فِيٓ أَعۡيُنِكُمۡ قَلِيلࣰا وَيُقَلِّلُكُمۡ فِيٓ أَعۡيُنِهِمۡ لِيَقۡضِيَ ٱللَّهُ أَمۡرࣰا كَانَ مَفۡعُولࣰاۗ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ4400aاخره : زُيِّنَ لِلنَّاسِ حُبُّ ٱلشَّهَوَٰتِ مِنَ ٱلنِّسَآءِ وَٱلۡبَنِينَ وَٱلۡقَنَٰطِيرِ ٱلۡمُقَنطَرَةِ مِنَ ٱلذَّهَبِ وَٱلۡفِضَّةِ وَٱلۡخَيۡلِ ٱلۡمُسَوَّمَةِ وَٱلۡأَنۡعَٰمِ وَٱلۡحَرۡثِۗ ذَٰلِكَ مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ وَٱللَّهُ عِندَهُۥ حُسۡنُ ٱلۡمَـَٔابِ14
قُلۡ أَؤُنَبِّئُكُم بِخَيۡرࣲ مِّن ذَٰلِكُمۡۖ لِلَّذِينَ ٱتَّقَوۡاْ عِندَ رَبِّهِمۡ جَنَّـٰتࣱ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَا وَأَزۡوَٰجࣱ مُّطَهَّرَةࣱ وَرِضۡوَٰنࣱ مِّنَ ٱللَّهِۗ وَٱللَّهُ بَصِيرُۢ بِٱلۡعِبَادِ1500aجزء 20 من القرآن الكريم10aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران : 172،cايرانgir00aاللغة : عربي. 4aقرانvمخطوطات.40uhttps://dromh.org/?view=e96c41c500aمكتبة مؤسسة بساتين للتراث الاسلامي في قم-ايران03501ctm a2200301 i 4500001000800000008004100008035003400049040003300083050001500116066000700131098001000138100004900148240004200197245007800239264004800317300001600365336003800381337003500419338002900454340004300483500131400526500106101840535011402901546002703015650003003042856003703072949009003109b254355261016nuuuu    xx            000 0 ara d00a(DROMH) dromh-254355-0ccfa11600aIQ-KaCCSbaracIQ-KaCCSerda04aBP20b.M3600c(300aMS1711 aكلام الله (عز وجل)،eمؤلف.10aحزب من القرآن الكريم10aحزب من القرآن الكريم /cكلام الله (عز وجل).00c[تاريخ الانتاج غير محدد]00a13 ورقة00aنصbtxt2rdacontent3مخطوط00aبدون وسيطbn2rdamedia00aمجلدbnc2rdacarrier00aورقcحبرgاسودdخط نسخ.00aاوله : وَرَبُّكَ ٱلۡغَفُورُ ذُو ٱلرَّحۡمَةِۖ لَوۡ يُؤَاخِذُهُم بِمَا كَسَبُواْ لَعَجَّلَ لَهُمُ ٱلۡعَذَابَۚ بَل لَّهُم مَّوۡعِدࣱ لَّن يَجِدُواْ مِن دُونِهِۦ مَوۡئِلࣰا58
